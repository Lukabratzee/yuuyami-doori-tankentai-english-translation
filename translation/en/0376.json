"lines": [
{
"n": 0,
"h": "e4d3100b",
"en_raw": "Hey, Sango"
},
{
"n": 1,
"h": "05d9371a",
"en_raw": "You come from the north side"
},
{
"n": 2,
"h": "e1d7f818",
"en_raw": "Isn't this the opposite entrance?"
},
{
"n": 3,
"h": "b16b5d41",
"en_raw": "It's also true that"
},
{
"n": 4,
"h": "bd85ba16",
"en_raw": "this place doesn't"
},
{
"n": 5,
"h": "ad35105c",
"en_raw": "have a good atmosphere"
},
{
"n": 6,
"h": "81cefe8d",
"en_raw": "Anyway, I've"
},
{
"n": 7,
"h": "cea7fcf2",
"en_raw": "had enough of this place..."
},
{
"n": 8,
"h": "81cefe8d",
"en_raw": "Anyway, I've"
},
{
"n": 9,
"h": "cea7fcf2",
"en_raw": "had enough of this place..."
},
{
"n": 10,
"h": "b16b5d41",
"en_raw": "It's also true that"
},
{
"n": 11,
"h": "bd85ba16",
"en_raw": "this place doesn't"
},
{
"n": 12,
"h": "ad35105c",
"en_raw": "have a good atmosphere"
},
{
"n": 13,
"h": "e52f91fa",
"en_raw": "Someone first said it as a joke"
},
{
"n": 14,
"h": "2bc5919b",
"en_raw": "'Something's here'"
},
{
"n": 15,
"h": "ce75318a",
"en_raw": "Well, the time has finally come"
},
{
"n": 16,
"h": "f0c8d008",
"en_raw": "to uncover the secret of this underpass"
},
{
"n": 17,
"h": "9898529b",
"en_raw": "Really, Sango"
},
{
"n": 18,
"h": "3f64a1c2",
"en_raw": "are you going alone?"
},
{
"n": 19,
"h": "305d2516",
"en_raw": "Of course / Hmm...  Who said that?"
},
{
"n": 20,
"h": "b18c1b4b",
"en_raw": "It'll touch"
},
{
"n": 21,
"h": "0f7edeca",
"en_raw": "What Sango wants to say"
},
{
"n": 22,
"h": "eeca0993",
"en_raw": "at least..."
},
{
"n": 23,
"h": "ea901379",
"en_raw": "Go / Don't  Well, I don't actually believe it"
},
{
"n": 24,
"h": "2be19073",
"en_raw": "but it's best not"
},
{
"n": 25,
"h": "43ecd362",
"en_raw": "to touch it... I guess"
},
{
"n": 26,
"h": "6793c235",
"en_raw": "Yeah, that's better"
},
{
"n": 27,
"h": "d65633eb",
"en_raw": "When Nao says it"
},
{
"n": 28,
"h": "6f6cea82",
"en_raw": "I want to try it even more"
},
{
"n": 29,
"h": "3764dd8c",
"en_raw": "......"
},
{
"n": 30,
"h": "7f956e5b",
"en_raw": "What"
},
{
"n": 31,
"h": "6a8d0e2c",
"en_raw": "What's with that pitiful look?"
},
{
"n": 32,
"h": "9e947a12",
"en_raw": "...Then we'll go around"
},
{
"n": 33,
"h": "b509dadf",
"en_raw": "to the other side of the tunnel"
},
{
"n": 34,
"h": "c4f90207",
"en_raw": "If you hear a scream inside"
},
{
"n": 35,
"h": "4972191b",
"en_raw": "come help, okay?"
},
{
"n": 36,
"h": "53fc7bfb",
"en_raw": "I, who brought it up"
},
{
"n": 37,
"h": "ac47a4cc",
"en_raw": "can't just go home"
},
{
"n": 38,
"h": "1eaa3e46",
"en_raw": "Eleven spirits, my foot"
},
{
"n": 39,
"h": "01db2eca",
"en_raw": "I'm not insensitive either"
},
{
"n": 40,
"h": "e3d38891",
"en_raw": "If you say it's a bad feeling"
},
{
"n": 41,
"h": "5fb07dad",
"en_raw": "I can't say I don't feel it"
},
{
"n": 42,
"h": "5eac37b9",
"en_raw": "What makes me angry is making a stupid fuss"
},
{
"n": 43,
"h": "29aa7871",
"en_raw": "about nothing at all"
},
{
"n": 44,
"h": "5f3dc840",
"en_raw": "and pushing needless preconceptions"
},
{
"n": 45,
"h": "22f1c224",
"en_raw": "onto unrelated others"
},
{
"n": 46,
"h": "7398ebe6",
"en_raw": "That's no different from badmouthing"
},
{
"n": 47,
"h": "4ab38cda",
"en_raw": "or some weird religion"
},
{
"n": 48,
"h": "81fb9c4a",
"en_raw": "Toilet Gang aside"
},
{
"n": 49,
"h": "1f10db33",
"en_raw": "why do the others too..."
},
{
"n": 50,
"h": "e2dafddd",
"en_raw": "Everyone is overusing"
},
{
"n": 51,
"h": "2bff881e",
"en_raw": "their pointless imagination"
},
{
"n": 52,
"h": "aa5c156e",
"en_raw": "...?"
},
{
"n": 53,
"h": "61c9f5fb",
"en_raw": "Vulgarity, filth..."
},
{
"n": 54,
"h": "5c45b032",
"en_raw": "The stink, the worst..."
},
{
"n": 55,
"h": "81c15fee",
"en_raw": "Adults say kids mustn't see"
},
{
"n": 56,
"h": "916d6a93",
"en_raw": "such things, yet"
},
{
"n": 57,
"h": "47c68b4b",
"en_raw": "those very things"
},
{
"n": 58,
"h": "456b3ec5",
"en_raw": "in front of us"
},
{
"n": 59,
"h": "106cef53",
"en_raw": "they make no effort"
},
{
"n": 60,
"h": "7d120168",
"en_raw": "to hide at all..."
},
{
"n": 61,
"h": "67b3184b",
"en_raw": "Tch, a brat acting high and mighty..."
},
{
"n": 62,
"h": "b53c3217",
"en_raw": "Are you talking to me!"
},
{
"n": 63,
"h": "4c9523e4",
"en_raw": "...Did you hear that, just now?"
},
{
"n": 64,
"h": "070327b1",
"en_raw": "A grown-up like that"
},
{
"n": 65,
"h": "780b11f1",
"en_raw": "has no value being alive, right?"
},
{
"n": 66,
"h": "bb44bd7f",
"en_raw": "He couldn't complain"
},
{
"n": 67,
"h": "1b789fa6",
"en_raw": "if he got killed"
},
{
"n": 68,
"h": "3764dd8c",
"en_raw": "......"
},
{
"n": 69,
"h": "a3447f3d",
"en_raw": "Nao and them are slow"
},
{
"n": 70,
"h": "276c18b7",
"en_raw": "Well, since we're here, maybe"
},
{
"n": 71,
"h": "264b8a5e",
"en_raw": "a deeper investigation"
},
{
"n": 72,
"h": "26938b22",
"en_raw": "Are you okay?"
},
{
"n": 73,
"h": "563caedf",
"en_raw": "It may be the worst place, indeed"
},
{
"n": 74,
"h": "1aa99990",
"en_raw": "In a different sense..."
}
]
}