{
"n": 0,
"h": "d70d9362",
"en_raw": "Where is this...?"
},
{
"n": 1,
"h": "e97ea35c",
"en_raw": "Um, excuse me..."
},
{
"n": 2,
"h": "37c25ab3",
"en_raw": "...Human wishes make me"
},
{
"n": 3,
"h": "5d7add5a",
"en_raw": "If humans forget, I perish"
},
{
"n": 4,
"h": "015d6945",
"en_raw": "Um...?"
},
{
"n": 5,
"h": "9d8e18bc",
"en_raw": "...If wishes are thoughts"
},
{
"n": 6,
"h": "83f93418",
"en_raw": "resentments are thoughts too"
},
{
"n": 7,
"h": "629e34fa",
"en_raw": "........."
},
{
"n": 8,
"h": "e7e82c0a",
"en_raw": "...Muddy thoughts form sediment"
},
{
"n": 9,
"h": "de3813e7",
"en_raw": "and make evil"
},
{
"n": 10,
"h": "a3787bbc",
"en_raw": "Yet all is the work of man"
},
{
"n": 11,
"h": "de2463ff",
"en_raw": "Um, that's the human face glass..."
},
{
"n": 12,
"h": "23acf426",
"en_raw": "...I've gotten sleepy"
},
{
"n": 13,
"h": "0e320b25",
"en_raw": "Leave it at that"
},
{
"n": 14,
"h": "0a3575d8",
"en_raw": "(Sleeping  Let it rest)"
},
{
"n": 15,
"h": "36ec2771",
"en_raw": "Surely there's"
},
