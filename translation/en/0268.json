{
"n": 0,
"h": "6a74084d",
"en_raw": "Next is Mr. Kamei's class"
},
{
"n": 1,
"h": "41a1686c",
"en_raw": "That teacher, in this day and age"
},
{
"n": 2,
"h": "ffa40617",
"en_raw": "forces rote memorization"
},
{
"n": 3,
"h": "b732b0ca",
"en_raw": "quizzes in hiragana"
},
{
"n": 4,
"h": "23085cdb",
"en_raw": "gets you an X"
},
{
"n": 5,
"h": "11d60dc9",
"en_raw": "It's weird to begin with"
},
{
"n": 6,
"h": "ebee1c5e",
"en_raw": "Why does a civics teacher"
},
{
"n": 9,
"h": "2f042209",
"en_raw": "teach history?"
},
{
"n": 10,
"h": "c1ecef1e",
"en_raw": "Human"
},
{
"n": 12,
"h": "df7daba3",
"en_raw": "is"
},
{
"n": 13,
"h": "c50b7d79",
"en_raw": "such a trivial thing?"
},
{
"n": 14,
"h": "94dfa927",
"en_raw": "Kurumi gets her head"
},
{
"n": 15,
"h": "5c336435",
"en_raw": "smacked"
},
{
"n": 16,
"h": "49541ab0",
"en_raw": "at all"
},
{
"n": 18,
"h": "fd9e5622",
"en_raw": "that thing called"
},
{
"n": 19,
"h": "f57a0771",
"en_raw": "of what history even is"
},
{
"n": 20,
"h": "dcc3bff2",
"en_raw": "But when it comes to food"
},
{
"n": 21,
"h": "72d3d1f6",
"en_raw": "he's interesting, can't stop"
},
{
"n": 22,
"h": "06fd8145",
"en_raw": "Right"
},
{
"n": 23,
"h": "fcbd3c22",
"en_raw": "Home ec would've been better"
},
{
"n": 24,
"h": "cc3c764b",
"en_raw": "Kurumi is getting hungry"
},
{
"n": 25,
"h": "8f4e1ed9",
"en_raw": "If we go to the staff room"
},
{
"n": 26,
"h": "10a1348f",
"en_raw": "I'm sure"
},
{
"n": 27,
"h": "a03746b2",
"en_raw": "they'll give us kakipi"
},
{
"n": 28,
"h": "773c783b",
"en_raw": "saying 'grow big'"
},
{
"n": 29,
"h": "d6deb78c",
"en_raw": "Hey, Shiina"
},
{
"n": 30,
"h": "59f2f8ba",
"en_raw": "what do you think about math?"
},
{
"n": 31,
"h": "96e15f00",
"en_raw": "It's hard"
},
{
"n": 32,
"h": "c74e8a23",
"en_raw": "Mr. Kanbara is a bit scary"
},
{
"n": 33,
"h": "03955b1e",
"en_raw": "I'm bad at it too"
},
{
"n": 34,
"h": "6dcf691f",
"en_raw": "He's definitely a number"
},
{
"n": 35,
"h": "83fab717",
"en_raw": "worshipper type"
},
{
"n": 36,
"h": "606cdc40",
"en_raw": "And so"
},
{
"n": 37,
"h": "66be5a74",
"en_raw": "Kurumi hasn't done it,"
},
{
"n": 38,
"h": "38a62538",
"en_raw": "homework"
},
{
"n": 39,
"h": "35f40e11",
"en_raw": "..."
},
{
"n": 40,
"h": "e6df16d0",
"en_raw": "Homework!"
},
{
"n": 41,
"h": "c5698c89",
"en_raw": "I totally forgot"
},
{
"n": 42,
"h": "887285f7",
"en_raw": "or rather was trying to forget..."
},
{
"n": 43,
"h": "8c545f60",
"en_raw": "Kurumi somehow"
},
{
"n": 44,
"h": "d2d8dd4b",
"en_raw": "My stomach's starting to hurt~"
},
{
"n": 45,
"h": "d941711e",
"en_raw": "Oh, really, me too..."
},
{
"n": 46,
"h": "2d423acc",
"en_raw": "Kurumi has a tummy ache"
},
{
"n": 47,
"h": "3a9ae7a1",
"en_raw": "Oh, I"
},
{
"n": 48,
"h": "a340293c",
"en_raw": "just had a great idea"
},
{
"n": 49,
"h": "145e4366",
"en_raw": "It's fine, Shiina"
},
{
"n": 51,
"h": "7da5b2bb",
"en_raw": "If it's the homework notebook"
},
{
"n": 52,
"h": "1049ab81",
"en_raw": "from Nao"
},
{
"n": 53,
"h": "f8ee3a03",
"en_raw": "I'll borrow it"
},
{
"n": 54,
"h": "b727fc9e",
"en_raw": "Then I'll go for a bit"
},
{
"n": 55,
"h": "ab757784",
"en_raw": "Even if I'm called on today"
},
{
"n": 56,
"h": "3a0de779",
"en_raw": "I'll be fine"
},
{
"n": 57,
"h": "1a9c4888",
"en_raw": "The only time he's useful"
},
{
"n": 58,
"h": "49029692",
"en_raw": "is times like this, though"
},
{
"n": 59,
"h": "d6deb78c",
"en_raw": "Hey, Shiina"
},
{
"n": 60,
"h": "59f2f8ba",
"en_raw": "what do you think about math?"
},
{
"n": 61,
"h": "b1e00c59",
"en_raw": "It's hard..."
},
{
"n": 62,
"h": "c74e8a23",
"en_raw": "Mr. Kanbara is a bit scary"
},
{
"n": 63,
"h": "d0d2293d",
"en_raw": "You told me that before"
},
{
"n": 64,
"h": "31a5677c",
"en_raw": "Then... um~"
},
{
"n": 65,
"h": "d41e87aa",
"en_raw": "Dunno"
},
{
"n": 66,
"h": "6dbe1f93",
"en_raw": "It feels like math has some major lie"
},
{
"n": 67,
"h": "468d6773",
"en_raw": "in it"
},
{
"n": 68,
"h": "42416a55",
"en_raw": "Why, you ask?"
},
{
"n": 69,
"h": "1c2cbe1f",
"en_raw": "The other day I"
},
{
"n": 70,
"h": "82342794",
"en_raw": "tried something, you know?"
},
{
"n": 71,
"h": "dd8ee086",
"en_raw": "What kind?"
},
{
"n": 72,
"h": "7ae8a3b8",
"en_raw": "Shiina, 10"
},
{
"n": 73,
"h": "256cbdce",
"en_raw": "divided by 3?"
},
{
"n": 74,
"h": "8d9e630e",
"en_raw": "It leaves one left over"
},
{
"n": 75,
"h": "39d9f349",
"en_raw": "So it doesn't divide, bingo!"
},
{
"n": 76,
"h": "948b318c",
"en_raw": "But a 10 cm origami paper"
},
{
"n": 77,
"h": "eee1f27e",
"en_raw": "can be cut into three equal parts"
},
{
"n": 78,
"h": "eaf22fef",
"en_raw": "and without a remainder"
},
{
"n": 79,
"h": "cb7fc118",
"en_raw": "exactly"
},
{
"n": 80,
"h": "f553b6fb",
"en_raw": "Really?!"
},
{
"n": 81,
"h": "cbd03b9a",
"en_raw": "What's the point of lying?"
},
{
"n": 82,
"h": "f3b57e5c",
"en_raw": "Sango, amazing"
},
{
"n": 83,
"h": "52bc60ca",
"en_raw": "Mr. Kanbara will be surprised"
},
{
"n": 84,
"h": "624f3e65",
"en_raw": "Sango"
},
{
"n": 85,
"h": "dd9631ab",
"en_raw": "Let's tell Mr. Kanbara!"
}
]
