],
"lines": [
{
"n": 0,
"h": "9e61ea58",
"en_raw": "I feel like"
},
{
"n": 1,
"h": "9070e0a2",
"en_raw": "someone's watching..."
},
{
"n": 2,
"h": "62abac02",
"en_raw": "Investigate / Ignore  I-it's my imagination"
},
{
"n": 3,
"h": "216d3f97",
"en_raw": "I'm a scaredy-cat..."
},
{
"n": 4,
"h": "c50bdc65",
"en_raw": "W-what was that..."
},
{
"n": 5,
"h": "af57dc43",
"en_raw": "Your housemates"
},
{
"n": 6,
"h": "d190c91f",
"en_raw": "They're dying to know"
},
{
"n": 7,
"h": "3f837531",
"en_raw": "what kind of new tenant you are"
},
{
"n": 8,
"h": "8aba82a4",
"en_raw": "How well-fleshed you are"
},
{
"n": 9,
"h": "37eb6467",
"en_raw": "whether you need cooking"
},
{
"n": 10,
"h": "f03037fa",
"en_raw": "or can be eaten raw"
},
{
"n": 11,
"h": "5ef54bb0",
"en_raw": "S-surely not..."
},
{
"n": 12,
"h": "5b91cfe8",
"en_raw": "Heh heh, just kidding"
},
{
"n": 13,
"h": "4b426675",
"en_raw": "Um..."
},
{
"n": 14,
"h": "05dcc528",
"en_raw": "Heh heh, that's your room"
},
{
"n": 15,
"h": "bb791b51",
"en_raw": "The faint light is on"
},
{
"n": 16,
"h": "f7485211",
"en_raw": "so you can tell"
},
{
"n": 17,
"h": "cf2aefa6",
"en_raw": "But, there's someone still"
},
{
"n": 18,
"h": "a7ea4bbd",
"en_raw": "living there"
},
{
"n": 19,
"h": "5b89730f",
"en_raw": "No one is!"
},
{
"n": 20,
"h": "6c633613",
"en_raw": "A family committed suicide yesterday"
},
{
"n": 21,
"h": "fad6a977",
"en_raw": "so it's vacant today"
},
{
"n": 22,
"h": "3b6187d7",
"en_raw": "Because..."
},
{
"n": 23,
"h": "e3b45d0b",
"en_raw": "They hanged themselves"
},
{
"n": 24,
"h": "cb80f502",
"en_raw": "A good way to die, no bother to others"
},
{
"n": 25,
"h": "8ec17994",
"en_raw": "The bodies were fresh"
},
{
"n": 26,
"h": "b4612a89",
"en_raw": "too, being newly dead"
},
{
"n": 27,
"h": "8da202fd",
"en_raw": "This morning we lit a bonfire"
},
{
"n": 28,
"h": "cb25da78",
"en_raw": "and everyone ate them"
},
{
"n": 29,
"h": "d58354a1",
"en_raw": "T-that's a bad joke..."
},
{
"n": 30,
"h": "5b89730f",
"en_raw": "No one is!"
},
{
"n": 31,
"h": "57ea9923",
"en_raw": "No one's in that room"
},
{
"n": 32,
"h": "f5d9af2d",
"en_raw": "If anyone, well, you..."
},
{
"n": 33,
"h": "ec4d3c94",
"en_raw": "A ghost, you see, a ghost!"
},
{
"n": 34,
"h": "00e55502",
"en_raw": "Next I'll show you the garden..."
},
{
"n": 35,
"h": "ddbd80a2",
"en_raw": "I... um..."
},
{
"n": 36,
"h": "3a841e1d",
"en_raw": "Excuse me"
},
{
"n": 37,
"h": "b3c368ed",
"en_raw": "You're so impatient"
},
{
"n": 38,
"h": "a562da3a",
"en_raw": "Very well, I'll show you the garden..."
},
{
"n": 39,
"h": "4eb7f4aa",
"en_raw": "Heh heh,"
},
{
"n": 40,
"h": "17414a47",
"en_raw": "where do you think you're going?"
}
]
}