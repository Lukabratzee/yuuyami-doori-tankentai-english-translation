{
"file": 282,
"paths": [
"d007/d012/f215"
],
"lines": [
{
"n": 0,
"h": "edaa3c2f",
"en_raw": "Hey, Murase, that thing..."
},
{
"n": 1,
"h": "2e651afb",
"en_raw": "It's the Oahu curse, they say"
},
{
"n": 2,
"h": "0a2c3d41",
"en_raw": "It really works apparently"
},
{
"n": 3,
"h": "1f7c9099",
"en_raw": "What are you saying, Segawa?"
},
{
"n": 4,
"h": "50a47750",
"en_raw": "...Murase"
},
{
"n": 5,
"h": "be16b2f0",
"en_raw": "doesn't know about it, of course"
},
{
"n": 6,
"h": "3d0442de",
"en_raw": "Hey, Segawa"
},
{
"n": 7,
"h": "48f5d063",
"en_raw": "About what you said earlier..."
},
{
"n": 8,
"h": "f1239e6c",
"en_raw": "It's nothing"
},
{
"n": 9,
"h": "c502409f",
"en_raw": "Forget it..."
},
{
"n": 10,
"h": "b466d097",
"en_raw": "Could it be the Lizard Hand?"
},
{
"n": 11,
"h": "807f348e",
"en_raw": "Hey, Segawa..."
},
{
"n": 12,
"h": "b5596c9d",
"en_raw": "Murase"
},
{
"n": 13,
"h": "306a8770",
"en_raw": "You wouldn't put it in my desk"
},
{
"n": 14,
"h": "7011ef08",
"en_raw": "Murase, never..."
},
{
"n": 15,
"h": "34cf0292",
"en_raw": "........"
},
{
"n": 16,
"h": "2be3e6ab",
"en_raw": "If you have it"
},
{
"n": 17,
"h": "9b13130d",
"en_raw": "a red mosquito comes while you sleep"
},
{
"n": 18,
"h": "dfd53716",
"en_raw": "enters through your ear to your brain and you die"
},
{
"n": 19,
"h": "345a2a5d",
"en_raw": "So..."
},
{
"n": 20,
"h": "bbfa04e4",
"en_raw": "So you have to"
},
{
"n": 21,
"h": "a9f67d9f",
"en_raw": "hand it to someone else..."
},
{
"n": 22,
"h": "c33b7861",
"en_raw": "And without anyone seeing"
},
{
"n": 23,
"h": "f1a4b823",
"en_raw": "If seen, it's over"
},
{
"n": 24,
"h": "2fffe3ce",
"en_raw": "You don't have it, do you, Segawa?"
},
{
"n": 25,
"h": "7ac71491",
"en_raw": "No, but..."
},
{
"n": 26,
"h": "4e58cddc",
"en_raw": "Before class starts"
},
{
"n": 27,
"h": "d2c8fd7c",
"en_raw": "you put your hand in your desk"
},
{
"n": 28,
"h": "33021264",
"en_raw": "and if it's in there..."
},
{
"n": 29,
"h": "4e4a4d3f",
"en_raw": "That... would be scary"
},
{
"n": 30,
"h": "36068282",
"en_raw": "If you flinch even a little"
},
{
"n": 31,
"h": "f3a849e0",
"en_raw": "you get found out..."
},
{
"n": 32,
"h": "bb78991a",
"en_raw": "You have to pull it out with a straight face"
},
{
"n": 33,
"h": "3dafaa63",
"en_raw": "and then go give it to someone..."
},
{
"n": 34,
"h": "91562e7a",
"en_raw": "Let's stop"
},
{
"n": 35,
"h": "7bc1a750",
"en_raw": "Hey, Murase"
},
{
"n": 36,
"h": "01bf464e",
"en_raw": "even if it's in your desk"
},
{
"n": 37,
"h": "ebef630b",
"en_raw": "never put it in mine"
},
{
"n": 38,
"h": "ba5d2c58",
"en_raw": "Okay, I promise"
},
{
"n": 39,
"h": "163ff96d",
"en_raw": "Obtained the rumor of the Lizard Hand"
},
{
"n": 40,
"h": "e07ed8c4",
"en_raw": "I keep watching"
},
{
"n": 41,
"h": "866cd0d6",
"en_raw": "so nobody puts it in my desk"
},
{
"n": 42,
"h": "e8578843",
"en_raw": "Segawa"
},
{
"n": 43,
"h": "b190ec04",
"en_raw": "You're lucky, Murase"
},
{
"n": 44,
"h": "906056df",
"en_raw": "Nobody hates you..."
},
{
"n": 45,
"h": "63433a5a",
"en_raw": "I..."
},
{
"n": 46,
"h": "e1ea508c",
"en_raw": "Sorry, I have something to do..."
},
{
"n": 47,
"h": "1df58ad3",
"en_raw": "See you."
}
]
}