{
"n": 0,
"h": "a7b8ff32",
"en_raw": "There are no kids playing"
},
{
"n": 1,
"h": "ec3bb3e2",
"en_raw": "at the nursery school anymore..."
},
{
"n": 2,
"h": "26414e06",
"en_raw": "You're waiting for your mom, right?"
},
{
"n": 3,
"h": "ca08b14c",
"en_raw": "Are you Acchan?"
},
{
"n": 4,
"h": "3764dd8c",
"en_raw": "......"
},
{
"n": 5,
"h": "cab00297",
"en_raw": "Do you always wait here?"
},
{
"n": 6,
"h": "0e852233",
