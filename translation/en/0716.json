},
{
"n": 15,
"h": "d4576dc9",
"en_raw": "Why do kids around here"
},
{
"n": 16,
"h": "fa7e5013",
"en_raw": "not play in that park"
},
{
"n": 17,
"h": "ea9546fb",
"en_raw": "under the overpass on the slope?"
},
{
"n": 18,
"h": "5dc8ee4f",
"en_raw": "The place with the sandbox...?"
},
{
"n": 19,
"h": "9b9e2ff9",
"en_raw": "Yeah, that one"
},
{
"n": 20,
"h": "27603cfd",
