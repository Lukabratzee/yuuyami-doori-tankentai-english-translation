},
{
"n": 11,
"h": "23f93fe4",
"en_raw": "Oh, you spoke for the first time"
},
{
"n": 12,
"h": "7ee8eb11",
"en_raw": "Hey, Acchan"
},
{
"n": 13,
"h": "6dcc39f6",
