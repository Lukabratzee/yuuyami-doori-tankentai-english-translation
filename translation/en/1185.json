"file": 1185,
"paths": [
"d010/d001/f046"
],
"lines": [
{
"n": 0,
"h": "6a26297f",
"en_raw": "Hat sister"
},
{
"n": 1,
"h": "a19a5a8c",
"en_raw": "Today's about your friends, right?"
},
{
"n": 2,
"h": "e2cf76d3",
"en_raw": "Okay, I'll tell you"
},
{
"n": 3,
"h": "a7f9f520",
"en_raw": "A little"
},
{
"n": 4,
"h": "e9efb490",
"en_raw": "You see, Kasuka"
},
{
"n": 5,
"h": "0f8602c1",
"en_raw": "Sango and Nao are..."
},
{
"n": 6,
"h": "dcbc67d6",
"en_raw": "...People come by train"
},
{
"n": 7,
"h": "adaed4e6",
"en_raw": "lots and lots of people come"
},
{
"n": 8,
"h": "22156391",
"en_raw": "Strangers more than people you know"
},
{
"n": 9,
"h": "76814f8c",
"en_raw": "nasty things more than fun things"
},
{
"n": 10,
"h": "821fbc89",
"en_raw": "They come together, gradually gather"
},
{
"n": 11,
"h": "0a6f34a5",
"en_raw": "gather and gather, turn black"
},
{
"n": 12,
"h": "36e25d21",
"en_raw": "That's what the black ones are?"
},
{
"n": 13,
"h": "686fca03",
"en_raw": "Kasuka watched"
},
{
"n": 14,
"h": "04878819",
"en_raw": "That guy did it"
},
{
"n": 15,
"h": "35674a24",
"en_raw": "He did it to your friends"
},
{
"n": 16,
"h": "0a8eba09",
"en_raw": "Try looking for it, sis"
},
{
"n": 17,
"h": "acb6aa9a",
"en_raw": "An empty, huge face"
},
{
"n": 18,
"h": "49c0fda2",
"en_raw": "if you look up, it's surely there"
},
{
"n": 19,
"h": "c8c1196a",
"en_raw": "That's the one who took it"
},
{
"n": 20,
"h": "6ac362e7",
"en_raw": "right down"
},
{
"n": 21,
"h": "40647fba",
"en_raw": "you can't tell..."
},
{
"n": 22,
"h": "5e60bc97",
"en_raw": "Kurumi is tired"
},
{
"n": 23,
"h": "4125d820",
"en_raw": "of being with"
},
{
"n": 24,
"h": "c831a869",
"en_raw": "the black ones"
},
{
"n": 25,
"h": "366954a9",
"en_raw": "I'll get it back"
},
{
"n": 26,
"h": "b8a3a11f",
"en_raw": "and say bye-bye"
},
{
"n": 27,
"h": "210419f5",
"en_raw": "Right, but"
},
{
"n": 28,
"h": "29af119e",
"en_raw": "if you're not careful..."
},
{
"n": 29,
"h": "6ac362e7",
"en_raw": "right down"
},
{
"n": 30,
"h": "b22d0674",
"en_raw": "you can't tell..."
},
{
"n": 31,
"h": "68244007",
"en_raw": "Come back, sis"
},
{
"n": 32,
"h": "eae9e6b5",
"en_raw": "Kasuka will wait forever"
},
{
"n": 33,
"h": "35ed7791",
"en_raw": "Forever..."
}
]
}