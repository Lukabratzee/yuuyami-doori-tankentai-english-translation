"lines": [
{
"n": 0,
"h": "7a30d963",
"en_raw": "Oh, you're still here"
},
{
"n": 1,
"h": "3764dd8c",
"en_raw": "......"
},
{
"n": 2,
"h": "f2ac0786",
"en_raw": "What's with that blatant"
},
{
"n": 3,
"h": "c4dc5035",
"en_raw": "look of suspicion?"
},
{
"n": 4,
"h": "a627791a",
"en_raw": "Not really..."
},
{
"n": 5,
"h": "f3df5fba",
"en_raw": "Can I say just one thing?"
},
{
"n": 6,
"h": "2306c5a5",
"en_raw": "You shouldn't be swayed"
},
{
"n": 7,
"h": "dafbb764",
"en_raw": "by such petty rumors"
},
{
"n": 8,
"h": "0c1531c9",
"en_raw": "You look stupid"
},
{
"n": 9,
"h": "877dbc14",
"en_raw": "Still here?"
},
{
"n": 10,
"h": "ee1cbefd",
"en_raw": "Leave me alone"
},
{
"n": 11,
"h": "3693d425",
"en_raw": "Since you're stupid anyway"
},
{
"n": 12,
"h": "e5ec4092",
"en_raw": "Sorry, maybe next time"
},
{
"n": 13,
"h": "7a588f32",
"en_raw": "Hirauchi"
},
{
"n": 14,
"h": "a1b909fb",
"en_raw": "What, stuck after school?"
},
{
"n": 15,
"h": "bfcf7a6c",
"en_raw": "What, still here?"
},
{
"n": 16,
"h": "dd7cde50",
"en_raw": "You have it, don't you?"
},
{
"n": 17,
"h": "45779e88",
"en_raw": "...Hey, Hirauchi"
},
{
"n": 18,
"h": "d7987a9b",
"en_raw": "you have it, right?"
},
{
"n": 19,
"h": "efce5e9e",
"en_raw": "Have what?"
},
{
"n": 20,
"h": "4e3a9ed9",
"en_raw": "That is, um, that thing..."
},
{
"n": 21,
"h": "6700c804",
"en_raw": "Say it clearly"
},
{
"n": 22,
"h": "3764dd8c",
"en_raw": "......"
},
{
"n": 23,
"h": "d092fbd6",
"en_raw": "...I have it"
},
{
"n": 24,
"h": "1a9f05ed",
"en_raw": "But I won't put it"
},
{
"n": 25,
"h": "6a778d85",
"en_raw": "in anyone's desk, so relax"
},
{
"n": 26,
"h": "9b0d5c3c",
"en_raw": "I'm not weak"
},
{
"n": 27,
"h": "9d479f3c",
"en_raw": "like you guys"
},
{
"n": 28,
"h": "877dbc14",
"en_raw": "Still here?"
},
{
"n": 29,
"h": "5782833d",
"en_raw": "Hirauchi, sorry..."
},
{
"n": 30,
"h": "d8c85bd8",
"en_raw": "...What?"
},
{
"n": 31,
"h": "72f1bcb7",
"en_raw": "Weren't you the toilet squad?"
},
{
"n": 32,
"h": "f88f85ac",
"en_raw": "But, but"
},
{
"n": 33,
"h": "38bbda21",
"en_raw": "what was your idea"
},
{
"n": 34,
"h": "985c59d0",
"en_raw": "in putting it in my place?"
},
{
"n": 35,
"h": "bb9becdc",
"en_raw": "If I put it in Sakai's"
},
{
"n": 36,
"h": "b642040c",
"en_raw": "I don't know what she'd do"
},
{
"n": 37,
"h": "fcd9552d",
"en_raw": "afterward, so..."
},
{
"n": 38,
"h": "056890ae",
"en_raw": "Sorry, sorry..."
},
{
"n": 39,
"h": "af0f6862",
"en_raw": "If you're going to apologize"
},
{
"n": 40,
"h": "e8aa108a",
"en_raw": "don't play such games"
},
{
"n": 41,
"h": "e2c9aa40",
"en_raw": "from the start!"
},
{
"n": 42,
"h": "1c437a42",
"en_raw": "Hirauchi, sorry..."
},
{
"n": 43,
"h": "bedd6ba5",
"en_raw": "...Sorry"
},
{
"n": 44,
