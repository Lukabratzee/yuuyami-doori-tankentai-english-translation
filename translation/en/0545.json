{
"file": 545,
"paths": [
"d008/d031/f026"
],
"lines": [
{
"n": 0,
"h": "cb664006",
"en_raw": "...Huh?"
},
{
"n": 1,
"h": "5b7d0224",
"en_raw": "There's hardly anyone around"
},
{
"n": 2,
"h": "45d93a56",
"en_raw": "Is it because of the stray dog rumor?"
},
{
"n": 3,
"h": "3a3cc39a",
"en_raw": "Um, excuse me"
},
{
"n": 4,
"h": "4e90f39d",
"en_raw": "How unusual"
},
{
"n": 5,
"h": "c86b19d0",
"en_raw": "Walking a dog at a time like this?"
},
{
"n": 6,
"h": "7c8e3187",
"en_raw": "Is this area under curfew?"
},
{
"n": 7,
"h": "9779cd3d",
"en_raw": "I really wish they'd do something"
},
{
"n": 8,
"h": "17edb63e",
"en_raw": "Elementary school doing group trips home"
},
{
"n": 9,
"h": "2ba32452",
"en_raw": "is what blows the story up"
},
{
"n": 10,
"h": "8a45cdbe",
"en_raw": "To begin with, nobody has"
},
{
"n": 11,
"h": "da94a75c",
"en_raw": "actually seen a black dog"
},
{
"n": 12,
"h": "3f602a4f",
"en_raw": "...except elementary schoolers"
},
{
"n": 13,
"h": "ae189838",
"en_raw": "He doesn't seem to believe it at all"
},
{
"n": 14,
"h": "13e46ae8",
"en_raw": "No, whatever shows up"
},
{
"n": 15,
"h": "2cfafc55",
"en_raw": "I don't care"
},
{
"n": 16,
"h": "1c083f8f",
"en_raw": "If it attacks me"
},
{
"n": 17,
"h": "87d86bf2",
"en_raw": "I'll just smack it"
},
{
"n": 18,
"h": "3fb4be28",
"en_raw": "with a stick, right?"
},
{
"n": 19,
"h": "21f31632",
"en_raw": "If I were scared of dogs"
},
{
"n": 20,
"h": "5e367d06",
"en_raw": "I couldn't go buy cigarettes"
},
{
"n": 21,
"h": "fa14a944",
"en_raw": "More reckless"
},
{
"n": 22,
"h": "e0bbc299",
"en_raw": "than brave..."
},
{
"n": 23,
"h": "db2ae5a1",
"en_raw": "Maybe going home early is less regrettable"
},
{
"n": 24,
"h": "da098191",
"en_raw": "Well, you and I are"
},
{
"n": 25,
"h": "2c52dde5",
"en_raw": "people who don't get"
},
{
"n": 26,
"h": "98110294",
"en_raw": "swept up in rumors"
},
{
"n": 27,
"h": "9b1eb8d6",
"en_raw": "That said, be a little careful"
},
{
"n": 28,
"h": "81758960",
"en_raw": "Hmm, I'll go home early after all"
},
{
"n": 29,
"h": "ffa272a8",
"en_raw": "Well then"
},
{
"n": 30,
"h": "a0dd27e5",
"en_raw": "Hey Sango,"
},
{
"n": 31,
"h": "d4b49563",
"en_raw": "as you can see, nobody's here..."
},
{
"n": 32,
"h": "1dbc4287",
"en_raw": "Let's bring Melos after all"
},
{
"n": 33,
"h": "2d4592e7",
"en_raw": "Right..."
},
{
"n": 34,
"h": "a243ff0c",
"en_raw": "Even a wimp like that"
},
{
"n": 35,
"h": "05afe4cf",
"en_raw": "is better than nothing, I guess..."
},
{
"n": 36,
"h": "f8e28b73",
"en_raw": "(After all...)"
},
{
"n": 37,
"h": "32e511fe",
"en_raw": "(Even a useless dog like that"
},
{
"n": 38,
"h": "86036149",
"en_raw": "might be better to have...)"
}
]
}