"lines": [
{
"n": 0,
"h": "3ec66992",
"en_raw": "Huh... Yamazaki?"
},
{
"n": 1,
"h": "794b1fc9",
"en_raw": "...What is it"
},
{
"n": 2,
"h": "ca5b9875",
"en_raw": "It's Murase and the others"
},
{
"n": 3,
"h": "1e590329",
"en_raw": "I can't afford to be lost"
},
{
"n": 4,
"h": "9e16b68c",
"en_raw": "Running into you, Yamazaki"
},
{
"n": 5,
"h": "9d049880",
"en_raw": "...feels kind of strange"
},
{
"n": 6,
"h": "d4d78fc3",
"en_raw": "Strange? Now I'm curious"
},
{
"n": 7,
"h": "ce9a12d8",
"en_raw": "No, nothing"
},
{
"n": 8,
"h": "b7e91fb2",
"en_raw": "Not in a bad way"
},
{
"n": 9,
"h": "e7a57f9c",
"en_raw": "it's just that talking with Yamazaki"
},
{
"n": 10,
"h": "46f00bb7",
"en_raw": "outside school"
},
{
"n": 11,
"h": "6abc8355",
"en_raw": "is a first"
},
{
"n": 12,
"h": "1a53a3e2",
"en_raw": "Today's just a breather"
},
{
"n": 13,
"h": "d355be50",
"en_raw": "I used to come here a lot"
},
{
"n": 14,
"h": "40970b96",
"en_raw": "to fish"
},
{
"n": 15,
"h": "418e54e0",
"en_raw": "Come to think of it, that's amazing"
},
{
"n": 16,
"h": "6beb8c78",
"en_raw": "Yamazaki"
},
{
"n": 17,
"h": "51709fae",
"en_raw": "Nishi's your rival, I hear?"
},
{
"n": 18,
"h": "f604c7d3",
"en_raw": "What do you mean?"
},
{
"n": 19,
"h": "c441b510",
"en_raw": "Being Nishi's rival is amazing?"
},
{
"n": 20,
"h": "181838ab",
"en_raw": "Is he really"
},
{
"n": 21,
"h": "5fd017c7",
"en_raw": "in a different dimension from us?"
},
{
"n": 22,
"h": "62179f24",
"en_raw": "Murase, you"
},
{
"n": 23,
"h": "f3d23852",
"en_raw": "admit that so easily?"
},
{
"n": 24,
"h": "7303486f",
"en_raw": "No, I didn't mean it like that..."
},
{
"n": 25,
"h": "1264b866",
"en_raw": "Nishi's our age too"
},
{
"n": 26,
"h": "8d77b170",
"en_raw": "no different from us at all"
},
{
"n": 27,
"h": "771f9015",
"en_raw": "...Listen"
},
{
"n": 28,
"h": "b9d0b1b4",
"en_raw": "...Well, I"
},
{
"n": 29,
"h": "fd387449",
"en_raw": "have things to do now"
},
{
"n": 30,
"h": "0f92a940",
"en_raw": "It's really in there..."
},
{
"n": 31,
"h": "376bb33d",
"en_raw": "Kind of unpleasant"
},
{
"n": 32,
"h": "d34c7e2a",
"en_raw": "this sort of thing..."
}
]
