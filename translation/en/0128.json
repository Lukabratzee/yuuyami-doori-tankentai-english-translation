{
"file": 128,
"paths": [
"d007/d004/f253"
],
"lines": [
{
"n": 0,
"h": "4eef7af2",
"en_raw": "...Murasaki Kagami?"
},
{
"n": 1,
"h": "627f485c",
"en_raw": "Hey, Yuri, what's Purple Mirror?"
},
{
"n": 2,
"h": "6b29ac5f",
"en_raw": "It's a terrifying word"
},
{
"n": 3,
"h": "89bf734a",
"en_raw": "A cursed word that brings death"
},
{
"n": 4,
"h": "19776a6d",
"en_raw": "Eek, is that true?"
},
{
"n": 5,
"h": "70f157a1",
"en_raw": "It's true"
},
{
"n": 6,
"h": "317f9144",
"en_raw": "If you remember that word until"
},
{
"n": 7,
"h": "3c0b4deb",
"en_raw": "your twentieth birthday"
},
{
"n": 8,
"h": "1abfde4e",
"en_raw": "a man in a white coat with a syringe"
},
{
"n": 9,
"h": "1e5834ff",
"en_raw": "comes from somewhere"
},
{
"n": 10,
"h": "9a6e6f19",
"en_raw": "and injects green liquid"
},
{
"n": 11,
"h": "79b0e97e",
"en_raw": "into your body"
},
{
"n": 12,
"h": "701527ba",
"en_raw": "And then..."
},
{
"n": 13,
"h": "6859253a",
"en_raw": "your hair gradually falls out"
},
{
"n": 14,
"h": "a9c679de",
"en_raw": "your nails peel off, your eyes shrivel"
},
{
"n": 15,
"h": "bcbc0d3e",
"en_raw": "and by the time you notice"
},
{
"n": 16,
"h": "857c8a3f",
"en_raw": "even a doctor can't save you"
},
{
"n": 17,
"h": "8f1f72bf",
"en_raw": "So you must never"
},
{
"n": 18,
"h": "bf1aab8f",
"en_raw": "remember this word..."
},
{
"n": 19,
"h": "41ff7385",
"en_raw": "Oh no, I can't get it out of my head"
},
{
"n": 20,
"h": "9140fe3f",
"en_raw": "I can't forget it~"
},
{
"n": 21,
"h": "cfdaa233",
"en_raw": "But don't worry"
},
{
"n": 22,
"h": "2136cd57",
"en_raw": "Every cursed word"
},
{
"n": 23,
"h": "2c290013",
"en_raw": "has a key that breaks it"
},
{
"n": 24,
"h": "b515a646",
"en_raw": "I'll tell only those of you here"
},
{
"n": 25,
"h": "cc0c0cd3",
"en_raw": "now..."
},
{
"n": 26,
"h": "cd9ca0d7",
"en_raw": "Hey, Yuri, that girl..."
},
{
"n": 27,
"h": "01734695",
"en_raw": "Hey, Iwase"
},
{
"n": 28,
"h": "31091f63",
"en_raw": "tell me the rest of that story"
},
{
"n": 29,
"h": "2758bcd9",
"en_raw": "I don't know what it's about"
},
{
"n": 30,
"h": "a136da20",
"en_raw": "but it sounds fun"
},
{
"n": 31,
"h": "455b02d3",
"en_raw": "Hirauchi, do you know Purple Mirror?"
},
{
"n": 32,
"h": "7c0d9aa2",
"en_raw": "What's that?"
},
{
"n": 33,
"h": "ab00e96d",
"en_raw": "If you don't, I'll tell you"
},
{
"n": 34,
"h": "98bb69cb",
"en_raw": "If you remember this word until"
},
{
"n": 35,
"h": "3dc0d0f7",
"en_raw": "you're twenty, you die"
},
{
"n": 36,
"h": "f9f89953",
"en_raw": "Oh, yeah, I forgot it already"
},
{
"n": 37,
"h": "2aea56be",
"en_raw": "Putting on a brave face..."
},
{
"n": 38,
"h": "697039ce",
"en_raw": "As if you could forget"
},
{
"n": 39,
"h": "589e42f8",
"en_raw": "it that easily"
},
{
"n": 40,
"h": "454aeb9e",
"en_raw": "Sorry, I have a bad memory"
},
{
"n": 41,
"h": "30095038",
"en_raw": "Then what about this word?"
},
{
"n": 42,
"h": "229ea000",
"en_raw": "What, there's more?"
},
{
"n": 43,
"h": "51d48d58",
"en_raw": "Silly spell"
},
{
"n": 44,
"h": "3764dd8c",
"en_raw": "......"
},
{
"n": 45,
"h": "650a9ce5",
"en_raw": "Dancing baby..."
},
{
"n": 46,
"h": "7c0d9aa2",
"en_raw": "What's that?"
},
{
"n": 47,
"h": "8fb360e3",
"en_raw": "If you don't know why"
},
{
"n": 48,
"h": "ab542b9e",
"en_raw": "babies in the womb dance"
},
{
"n": 49,
"h": "68a025b2",
"en_raw": "you'll give birth to"
},
{
"n": 50,
"h": "904b8253",
"en_raw": "a baby with no face"
},
{
"n": 51,
"h": "1be6e58a",
"en_raw": "Hmm, how silly"
},
{
"n": 52,
"h": "dbaf3d56",
"en_raw": "Forget it if you like"
},
{
"n": 53,
"h": "07cd8bb6",
"en_raw": "but don't regret it later..."
},
{
"n": 54,
"h": "44e5ec69",
"en_raw": "Obtained the rumor of the Words of Death"
},
{
"n": 55,
"h": "4c4e00ec",
"en_raw": "...Hey, Yuri"
},
{
"n": 56,
"h": "09eef220",
"en_raw": "what's a dancing baby?"
},
{
"n": 57,
"h": "3a177c99",
"en_raw": "We don't know either~"
},
{
"n": 58,
"h": "4b9bb7cd",
"en_raw": "It's fine, I'll tell"
},
{
"n": 59,
"h": "a2dad07f",
"en_raw": "you guys"
},
{
"n": 60,
"h": "059ac046",
"en_raw": "after the otaku girl is gone"
},
{
"n": 61,
"h": "2aa18f4e",
"en_raw": "Hey"
},
{
"n": 62,
"h": "34cf0292",
"en_raw": "........"
},
{
"n": 63,
"h": "ab840566",
"en_raw": "Sorry, I might catch"
},
{
"n": 64,
"h": "52dd16a5",
"en_raw": "stupidity, excuse me"
}
]
}