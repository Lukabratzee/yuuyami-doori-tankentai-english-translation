"lines": [
{
"n": 0,
"h": "199be14e",
"en_raw": "She still hasn't regained consciousness"
},
{
"n": 1,
"h": "162ff250",
"en_raw": "Even though you came all this way"
},
{
"n": 2,
"h": "1efb3f74",
"en_raw": "I'm sorry"
},
{
"n": 3,
"h": "cb269914",
"en_raw": "Um, this is the summer vacation handout"
},
{
"n": 4,
"h": "ed0c6e6c",
"en_raw": "Oh, you went out of your way"
},
{
"n": 5,
"h": "a74407b1",
"en_raw": "Thank you so much, truly"
},
{
"n": 6,
"h": "8f0b193f",
"en_raw": "Oh right, I'll go buy some drinks"
},
{
"n": 7,
"h": "8fa5d66a",
"en_raw": "Hey, Nao"
},
{
"n": 8,
"h": "fd2bfbca",
"en_raw": "Hm?"
},
{
"n": 9,
"h": "5e77e236",
"en_raw": "What are you going to do?"
},
{
"n": 10,
"h": "d81352a8",
"en_raw": "What am I going to do..."
},
{
"n": 11,
"h": "41b03373",
"en_raw": "...I'll wait"
},
{
"n": 12,
"h": "1ee3eaa9",
"en_raw": "Suit yourself"
},
{
"n": 13,
"h": "23fd4274",
"en_raw": "Then I'm going home first"
},
{
"n": 14,
"h": "d4a10741",
"en_raw": "Ah, I'm hungry~"
},
{
"n": 15,
"h": "34cf0292",
"en_raw": "........"
},
{
"n": 16,
"h": "e4ac8066",
"en_raw": "Hey, still planning to stay?"
},
{
"n": 17,
"h": "2d5265b3",
"en_raw": "You're a bit persistent"
},
{
"n": 18,
"h": "e0d07dd3",
"en_raw": "That's why I said Sango can go home"
},
{
"n": 19,
"h": "947e13b3",
"en_raw": "Is that how you put it?"
},
{
"n": 20,
"h": "929781fd",
"en_raw": "I'm being kind"
},
{
"n": 21,
"h": "ee086b66",
"en_raw": "and keeping you company..."
},
{
"n": 22,
"h": "bcd1d686",
"en_raw": "Sorry."
},
{
"n": 23,
"h": "e1c1fe1e",
"en_raw": "It's fine, I'm free anyway..."
},
{
"n": 24,
"h": "79feba02",
"en_raw": "...Where are you going?"
},
{
"n": 25,
"h": "080ad433",
"en_raw": "Just the toilet"
},
{
"n": 26,
"h": "71ee72c9",
"en_raw": "I'm sure even I"
},
{
"n": 27,
"h": "93393b28",
"en_raw": "know this illness"
},
{
"n": 28,
"h": "d1cc0894",
"en_raw": "Something like"
},
{
"n": 29,
"h": "94153990",
"en_raw": "appendicitis..."
},
{
"n": 30,
"h": "7a58232b",
"en_raw": "When she wakes up, Shiina"
},
{
"n": 31,
"h": "2a6186b6",
"en_raw": "will surely laugh at us"
},
{
"n": 32,
"h": "b227e739",
"en_raw": "And then I'll tell her"
},
{
"n": 33,
"h": "c1ebe720",
"en_raw": "about summer vacation"
},
{
"n": 34,
"h": "283e0a55",
"en_raw": "about the festival"
},
{
"n": 35,
"h": "975afdcb",
"en_raw": "and what I couldn't say"
},
{
"n": 36,
"h": "fa070cd8",
"en_raw": "at the start of the term..."
},
{
"n": 37,
"h": "356b4d6c",
"en_raw": "Ugh, what time is it now?"
},
{
"n": 38,
"h": "34cf0292",
"en_raw": "........"
},
{
"n": 39,
"h": "eecc5755",
"en_raw": "Nao, didn't you say"
},
{
"n": 40,
"h": "b1388823",
"en_raw": "you had plans today?"
},
{
"n": 41,
"h": "34cf0292",
"en_raw": "........"
},
{
"n": 42,
"h": "840c01f1",
"en_raw": "It's okay now, Nao"
},
{
"n": 43,
"h": "558429a7",
"en_raw": "You're cool enough"
},
{
"n": 44,
"h": "8c973453",
"en_raw": "Shiina!"
},
{
"n": 45,
"h": "f012871d",
"en_raw": "Sango, Nao..."
},
{
"n": 46,
"h": "8aeb8373",
"en_raw": "What's wrong, Shiina?"
},
{
"n": 47,
"h": "c4df8268",
"en_raw": "Why?"
},
{
"n": 48,
"h": "8948698b",
"en_raw": "Don't cry, Shiina"
},
{
"n": 49,
"h": "07cebe58",
"en_raw": "...Kurumi isn't scared of anything"
},
{
"n": 50,
"h": "24fd8d33",
"en_raw": "But you know, I hate it"
},
{
"n": 51,
"h": "e3113784",
"en_raw": "Because of Kurumi"
},
{
"n": 52,
"h": "d5e9ce76",
"en_raw": "everyone makes sad faces"
},
{
"n": 53,
"h": "e3113784",
"en_raw": "Because of Kurumi"
},
{
"n": 54,
"h": "8210660e",
"en_raw": "Everyone stops smiling"
},
{
"n": 55,
"h": "34cf0292",
"en_raw": "........"
},
{
"n": 56,
"h": "4aa92a7f",
"en_raw": "...Thank you for coming"
},
{
"n": 57,
"h": "3cd1b61b",
"en_raw": "How is Shiina?"
},
{
"n": 58,
"h": "629e34fa",
"en_raw": "........."
},
{
"n": 59,
"h": "f63a3d15",
"en_raw": "Um, can I talk with Shiina..."
},
{
"n": 60,
"h": "4816fab3",
"en_raw": "...Then, um"
},
{
"n": 61,
"h": "984ca167",
"en_raw": "when will she wake up?"
},
{
"n": 62,
"h": "548d44d9",
"en_raw": "That child"
},
{
"n": 63,
"h": "0e2a34a2",
