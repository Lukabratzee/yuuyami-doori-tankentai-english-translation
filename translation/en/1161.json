},
{
"n": 65,
"h": "34cf0292",
"en_raw": "........"
},
{
"n": 66,
"h": "548d6ccf",
"en_raw": "Right, surely"
},
{
"n": 67,
"h": "ae6196ee",
"en_raw": "I... got the wrong room..."
},
{
"n": 68,
"h": "0c248681",
"en_raw": "It's not a mistake..."
},
{
"n": 69,
"h": "ab26c189",
