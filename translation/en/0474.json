"lines": [
{
"n": 0,
"h": "3a3cc39a",
"en_raw": "Um, excuse me"
},
{
"n": 1,
"h": "49013f98",
"en_raw": "You're a middle schooler... 500 yen"
},
{
"n": 2,
"h": "a672469f",
"en_raw": "Oh, um, no thanks..."
},
{
"n": 3,
"h": "c03a63da",
"en_raw": "Um..."
},
{
"n": 4,
"h": "b2610665",
"en_raw": "what is it?"
},
{
"n": 5,
"h": "2b8f92ad",
"en_raw": "The things you're selling"
},
{
"n": 6,
"h": "1fea14a5",
"en_raw": "may I look?"
},
{
"n": 7,
"h": "19b5cff2",
"en_raw": "Go ahead~"
},
{
"n": 8,
"h": "0f616db0",
"en_raw": "Did you see anything you want?"
},
{
"n": 9,
"h": "f7d87f3c",
"en_raw": "Oh, no"
},
{
"n": 10,
"h": "41355c8c",
"en_raw": "A little more..."
},
{
"n": 11,
"h": "33a24ae2",
"en_raw": "...Hm, well, fine"
},
{
"n": 12,
"h": "a0b2456c",
"en_raw": "A Lizard Hand..."
},
{
"n": 13,
"h": "d71ba55f",
"en_raw": "As expected of a customer with good taste"
},
{
"n": 14,
"h": "5bf0ea4f",
"en_raw": "That's a good one"
},
{
"n": 15,
"h": "d3867bd1",
"en_raw": "Um... this..."
},
{
"n": 16,
"h": "87f854d8",
"en_raw": "It's a charm"
},
{
"n": 17,
"h": "d7615a17",
"en_raw": "...Lately this is a popular item"
},
{
"n": 18,
"h": "ff67a739",
"en_raw": "because someone keeps buying"
},
{
"n": 19,
"h": "6da90976",
"en_raw": "now's the time"
},
{
"n": 20,
"h": "9183c415",
"en_raw": "them all up"
},
{
"n": 21,
"h": "4b426675",
"en_raw": "Um..."
},
{
"n": 22,
"h": "6a69a63e",
"en_raw": "Buying them all up...?"
},
{
"n": 23,
"h": "ef5c1d34",
"en_raw": "Hmm..."
},
{
"n": 24,
"h": "30b25be8",
"en_raw": "What kind of person buys them..."
},
{
"n": 25,
"h": "5345dbb7",
"en_raw": "I don't really get boys"
},
{
"n": 26,
"h": "eb715420",
"en_raw": "but the severity of that distortion"
},
{
"n": 27,
"h": "750bc48d",
"en_raw": "will be corrected eventually"
},
{
"n": 28,
"h": "a840125a",
"en_raw": "Distorted?"
},
{
"n": 29,
"h": "ee7fb9f9",
"en_raw": "What do you mean?"
},
{
"n": 30,
"h": "b23a04bb",
"en_raw": "His face too, but in his case"
},
{
"n": 31,
"h": "bcdf6b3b",
"en_raw": "it's his character"
},
{
"n": 32,
"h": "724af22e",
"en_raw": "The moment he saw this item"
},
{
"n": 33,
"h": "baea24f0",
"en_raw": "he asked how effective it is"
},
{
"n": 34,
"h": "2e58a8f9",
"en_raw": "so as a joke I told him"
},
{
"n": 35,
"h": "214f1b0a",
"en_raw": "it lowers your Armor Class by 1"
},
{
"n": 36,
"h": "6f3997a4",
"en_raw": "...Guess what he said?"
},
{
"n": 37,
"h": "966da26d",
"en_raw": "He muttered, 'ignorant fool'!"
},
{
"n": 38,
"h": "e42a98da",
"en_raw": "That really ticked me off"
},
{
"n": 39,
"h": "34cf0292",
"en_raw": "........"
},
{
"n": 40,
"h": "3f22e2c0",
"en_raw": "(Could it be Kume?)"
},
{
"n": 41,
"h": "db827262",
"en_raw": "Well..."
},
{
"n": 42,
"h": "e333a75e",
"en_raw": "Thank you very much"
},
{
"n": 43,
"h": "f8ba4b89",
"en_raw": "Want to buy something as thanks?"
},
{
"n": 44,
"h": "2d5b8623",
"en_raw": "Oh... um..."
},
{
"n": 45,
"h": "fc549861",
"en_raw": "It's no use pushing a kid"
},
{
"n": 46,
"h": "66a2cad3",
"en_raw": "Can't be helped"
},
{
"n": 47,
"h": "2811ac35",
"en_raw": "Come back as a customer next time~"
},
{
"n": 48,
"h": "db827262",
"en_raw": "Well..."
},
{
"n": 49,
"h": "e333a75e",
"en_raw": "Thank you very much"
},
{
"n": 50,
"h": "db827262",
"en_raw": "Well..."
},
{
"n": 51,
"h": "e333a75e",
"en_raw": "Thank you very much"
}
