"lines": [
{
"n": 0,
"h": "d8e0c258",
"en_raw": "Oh, class rep"
},
{
"n": 1,
"h": "041a926f",
"en_raw": "What are you doing in front of the bathroom?"
},
{
"n": 2,
"h": "f8ceb795",
"en_raw": "...Hey, Hirauchi"
},
{
"n": 3,
"h": "6c2254b6",
"en_raw": "Sakai and her friends are"
},
{
"n": 4,
"h": "9066f0cb",
"en_raw": "in the bathroom, but..."
},
{
"n": 5,
"h": "5a07962f",
"en_raw": "Could you go listen to"
},
{
"n": 6,
"h": "ec597d63",
"en_raw": "what they're talking about?"
},
{
"n": 7,
"h": "5ed9b386",
"en_raw": "...What is that?"
},
{
"n": 8,
"h": "b180f823",
"en_raw": "The Toilet Gang's talk is"
},
{
"n": 9,
"h": "0a5a5419",
"en_raw": "just badmouthing people"
},
{
"n": 10,
"h": "0d084f6c",
"en_raw": "or silly rumors, right?"
},
{
"n": 11,
"h": "48b5c56e",
"en_raw": "But there are lots of people"
},
{
"n": 12,
"h": "e1e5fd39",
"en_raw": "hurt by"
},
{
"n": 13,
"h": "167a3c1d",
"en_raw": "what they said"
},
{
"n": 14,
"h": "e74ee4eb",
"en_raw": "At this rate the class"
},
{
"n": 15,
"h": "b26b6884",
"en_raw": "will fall apart"
},
{
"n": 16,
"h": "c020f24c",
"en_raw": "Even so, why me?"
},
{
"n": 17,
"h": "c1325111",
"en_raw": "Because if I go"
},
{
"n": 18,
"h": "fceef228",
"en_raw": "they leave the bathroom"
},
{
"n": 19,
"h": "06755f5c",
"en_raw": "right away"
},
{
"n": 20,
"h": "12f18b57",
"en_raw": "...Please"
},
{
"n": 21,
"h": "92190274",
"en_raw": "If you stand at the bathroom entrance"
},
{
"n": 22,
"h": "815bfbf7",
"en_raw": "you should be able to hear"
},
{
"n": 23,
"h": "f8ef622b",
"en_raw": "what they're saying"
},
{
"n": 24,
"h": "5b316323",
"en_raw": "You've got to be kidding me..."
},
{
"n": 25,
"h": "12f18b57",
"en_raw": "...Please"
},
{
"n": 26,
"h": "92190274",
"en_raw": "If you stand at the bathroom entrance"
},
{
"n": 27,
"h": "815bfbf7",
"en_raw": "you should be able to hear"
},
{
"n": 28,
"h": "f8ef622b",
"en_raw": "what they're saying"
},
{
"n": 29,
"h": "a8cb99ab",
"en_raw": "Well, I'm an adult"
},
{
"n": 30,
"h": "639f58cf",
"en_raw": "so I won't pick fights"
},
{
"n": 31,
"h": "fbeb066f",
"en_raw": "with people like that"
},
{
"n": 32,
"h": "91d8e8c9",
"en_raw": "How was it, Hirauchi?"
},
{
"n": 33,
"h": "6942b4a8",
"en_raw": "Honestly, the Toilet Gang"
},
{
"n": 34,
"h": "ec372fad",
"en_raw": "are infuriating"
},
{
"n": 35,
"h": "ff905187",
"en_raw": "But they didn't badmouth"
},
{
"n": 36,
"h": "7612b745",
"en_raw": "the class rep, so"
},
{
"n": 37,
"h": "4e7c6704",
"en_raw": "you can relax, can't you?"
},
{
"n": 38,
"h": "460ca057",
"en_raw": "Th-that's good..."
},
{
"n": 39,
"h": "7d59778c",
"en_raw": "Um... sorry"
},
{
"n": 40,
"h": "ce0c629d",
"en_raw": "Hirauchi..."
}
]
}