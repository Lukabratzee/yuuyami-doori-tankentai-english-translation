"lines": [
{
"n": 0,
"h": "04aac64a",
"en_raw": "Hey, Sakai"
},
{
"n": 1,
"h": "0e4b7aa9",
"en_raw": "What did they tell you in the staff room?"
},
{
"n": 2,
"h": "d7e66dbc",
"en_raw": "...Nothing"
},
{
"n": 3,
"h": "d1af3f05",
"en_raw": "She just sat there"
},
{
"n": 4,
"h": "d0b53af9",
"en_raw": "without even meeting anyone's eyes"
},
{
"n": 5,
"h": "2055df87",
"en_raw": "Hey, isn't that"
},
{
"n": 6,
"h": "fb7c9827",
"en_raw": "our fault after all..."
},
{
"n": 7,
"h": "b65b59d4",
"en_raw": "Why would it be our fault?"
},
{
"n": 8,
"h": "070b05c2",
"en_raw": "Badmouthing her wasn't"
},
{
"n": 9,
"h": "bd60f255",
"en_raw": "just us, was it?"
},
{
"n": 10,
"h": "524fc0f0",
"en_raw": "Yes"
},
{
"n": 11,
"h": "de796812",
"en_raw": "If she did things to be"
},
{
"n": 12,
"h": "7ba346b0",
"en_raw": "hated that much, it's only natural"
},
{
"n": 13,
"h": "bf576874",
"en_raw": "Blaming someone else"
},
{
"n": 14,
"h": "7e8ef5a6",
"en_raw": "is the wrong way to think"
},
{
"n": 15,
"h": "c9c96901",
"en_raw": "Wrapping a bandage around her wrist"
},
{
"n": 16,
"h": "914a68ef",
"en_raw": "is so obviously for show"
},
{
"n": 17,
"h": "55e12497",
"en_raw": "......."
},
{
"n": 18,
"h": "7b2fc22b",
"en_raw": "So that's the conclusion you reached"
},
{
"n": 19,
"h": "7b176d7c",
"en_raw": "How convenient"
},
{
"n": 20,
"h": "2fa55063",
"en_raw": "What, otaku girl?"
},
{
"n": 21,
"h": "d1fab956",
"en_raw": "I won't fight you, even"
},
{
"n": 22,
"h": "71e5850e",
"en_raw": "when coming to pool remedial"
},
{
"n": 23,
"h": "b9d3eb27",
"en_raw": "I'll be out soon, leave me alone"
},
{
"n": 24,
"h": "78ef80a1",
"en_raw": "Same old badmouthing"
},
{
"n": 25,
"h": "b2d3e6f6",
"en_raw": "Even after switching to the bathroom"
},
{
"n": 26,
"h": "cc1ce253",
"en_raw": "or changing room, you do the same thing"
}
]
}