"lines": [
{
"n": 0,
"h": "86d759bd",
"en_raw": "This is Shiina's desk..."
},
{
"n": 1,
"h": "3afa6f61",
"en_raw": "...I wish they'd stop"
},
{
"n": 2,
"h": "b21c3576",
"en_raw": "this childish stuff..."
},
{
"n": 3,
"h": "93892035",
"en_raw": "...She deserved to die"
},
{
"n": 4,
"h": "57e273fa",
"en_raw": "Everyone hated her"
},
{
"n": 5,
"h": "29fb0e23",
"en_raw": "and first of all"
},
{
"n": 6,
"h": "a94d033f",
"en_raw": "most bothered by her"
},
{
"n": 7,
"h": "54616cb0",
"en_raw": "It's none other than"
},
{
"n": 8,
"h": "624cb364",
"en_raw": "was me!"
},
{
"n": 9,
"h": "51ed8141",
"en_raw": "...Nao will be angry"
},
{
"n": 10,
"h": "7b40708e",
"en_raw": "he won't forgive me"
},
{
"n": 11,
"h": "5ba82abd",
"en_raw": "But I'll tell him for sure"
},
{
"n": 12,
"h": "8bd820bf",
"en_raw": "It's none of your business,"
},
{
"n": 13,
"h": "02e076a9",
"en_raw": "I'll say..."
},
{
"n": 14,
"h": "fdfd082c",
"en_raw": "Will I get arrested?"
},
{
"n": 15,
"h": "6a159fac",
"en_raw": "Haha, what a boring life..."
},
{
"n": 16,
"h": "a52fb8cc",
