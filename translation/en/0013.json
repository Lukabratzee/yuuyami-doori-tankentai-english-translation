{
"n": 257,
"h": "43f0e9e0",
"en_raw": "If that settled it"
},
{
"n": 258,
"h": "0fd99d89",
"en_raw": "...It doesn't?"
},
{
"n": 259,
"h": "57dc9f38",
"en_raw": "Think about it"
},
{
"n": 260,
"h": "c38211e3",
"en_raw": "making the whole town"
},
{
"n": 261,
"h": "e564afb7",
"en_raw": "spotlessly clean"
},
{
"n": 262,
"h": "fdeeedda",
"en_raw": "Do you think that's possible?"
},
{
"n": 263,
"h": "9a19037a",
"en_raw": "Even just my room"
},
{
"n": 264,
"h": "ec49106c",
"en_raw": "is impossible"
},
{
"n": 265,
"h": "8d469ad0",
"en_raw": "Thinking that way"
},
{
"n": 266,
"h": "4a57662b",
"en_raw": "with this many people living here"
},
{
"n": 267,
"h": "96b49f03",
"en_raw": "if the big strain"
