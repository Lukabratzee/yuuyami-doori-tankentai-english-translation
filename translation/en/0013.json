},
{
"n": 229,
"h": "a30163da",
"en_raw": "Yeah"
},
{
"n": 230,
"h": "6a31e954",
"en_raw": "Which means there really is something?"
},
{
"n": 231,
"h": "98dec4ba",
"en_raw": "Something humans can't understand..."
},
{
"n": 232,
"h": "2e0b8b51",
"en_raw": "That's not like you, Sango"
},
{
"n": 233,
"h": "400c05ce",
"en_raw": "I mean, not ghosts or anything"
},
{
"n": 234,
"h": "46e7ef1d",
"en_raw": "electromagnetic waves, smog"
},
{
"n": 235,
"h": "d6906174",
"en_raw": "Because we can't understand it"
},
{
"n": 236,
"h": "a2c305bc",
"en_raw": "everyone's uneasy, I bet"
},
{
"n": 237,
"h": "8560fb4c",
"en_raw": "...Think of it this way"
},
{
"n": 238,
"h": "f5b8263a",
