"lines": [
{
"n": 0,
"h": "58ac12f3",
"en_raw": "Even though it's a park, why is it"
},
{
"n": 1,
"h": "7f1931c3",
"en_raw": "so deserted"
},
{
"n": 2,
"h": "ddf9a7da",
"en_raw": "Go home soon / A bit more  Nothing special"
},
{
"n": 3,
"h": "d4d37d06",
"en_raw": "about it, a sandbox, but..."
},
{
"n": 4,
"h": "d8cb6df0",
"en_raw": "They said they played"
},
{
"n": 5,
"h": "91ed010f",
"en_raw": "a funeral game..."
},
{
"n": 6,
"h": "5d364e17",
"en_raw": "Then what's buried..."
},
{
"n": 7,
"h": "d86fc2e6",
"en_raw": "Dig the sandbox / Don't  I can't do it..."
},
{
"n": 8,
"h": "077a323f",
"en_raw": "But... if I just go home"
},
{
"n": 9,
"h": "cbb40582",
"en_raw": "Sango would say something again"
},
{
"n": 10,
"h": "2b0505a7",
"en_raw": "Nothing out of the ordinary so far"
},
{
"n": 11,
"h": "5d64f798",
"en_raw": "special..."
},
{
"n": 12,
"h": "b3154982",
"en_raw": "Dig more / Put it back  I did check anyway..."
},
{
"n": 13,
"h": "cf00c9c6",
"en_raw": "Surely nothing is buried"
},
{
"n": 14,
"h": "a3d78b2c",
"en_raw": "But..."
},
{
"n": 15,
"h": "40e27cb2",
"en_raw": "What... is this...?"
},
{
"n": 16,
"h": "759792c2",
"en_raw": "Check / Put it back  Sorry"
},
{
"n": 17,
"h": "0cd124dc",
"en_raw": "Sorry..."
},
{
"n": 18,
"h": "320c3827",
"en_raw": "This... a doll?"
},
{
"n": 19,
"h": "bd137f9d",
"en_raw": "Dig out / Rebury  So the funeral game"
},
{
"n": 20,
"h": "652a3625",
"en_raw": "meant this..."
},
{
"n": 21,
"h": "703b8ae0",
"en_raw": "Take it / Leave it  Taking it"
},
{
"n": 22,
"h": "c2e52c1c",
"en_raw": "won't change anything..."
},
{
"n": 23,
"h": "3764dd8c",
"en_raw": "......"
},
{
"n": 24,
"h": "2876ff0c",
"en_raw": "But... what should I do..."
},
{
"n": 25,
"h": "420c7f25",
"en_raw": "Take it / Leave it  If A-chan notices"
},
{
"n": 26,
"h": "b7342c46",
"en_raw": "she'd surely hate it"
},
{
"n": 27,
"h": "2371d78c",
"en_raw": "I don't feel good about this"
},
{
"n": 28,
"h": "192c4b71",
"en_raw": "I feel I shouldn't leave it"
}
]
