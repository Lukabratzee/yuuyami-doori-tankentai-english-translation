"lines": [
{
"n": 0,
"h": "758c219e",
"en_raw": "Okay, I'll explain once more"
},
{
"n": 1,
"h": "3a30259e",
"en_raw": "When I give the signal"
},
{
"n": 2,
"h": "7e855264",
"en_raw": "you climb the fence"
},
{
"n": 3,
"h": "03591de7",
"en_raw": "That's fine for Yuasa, but"
},
{
"n": 4,
"h": "bdc084f9",
"en_raw": "it's pretty conspicuous"
},
{
"n": 5,
"h": "d3ea452f",
"en_raw": "Are you saying"
},
{
"n": 6,
"h": "b7b31857",
"en_raw": "I'm short?"
},
{
"n": 7,
"h": "11a9e1de",
"en_raw": "I'm not saying that"
},
{
"n": 8,
"h": "6468a423",
"en_raw": "It's just that there's a bad"
},
{
"n": 9,
"h": "e3601337",
"en_raw": "rumor about that place"
},
{
"n": 10,
"h": "90563f3f",
"en_raw": "evil spirits and all..."
},
{
"n": 11,
"h": "d492c81a",
"en_raw": "...Shige, do you"
},
{
"n": 12,
"h": "27f67f00",
"en_raw": "really have any hair down there?"
},
{
"n": 13,
"h": "45f2232e",
"en_raw": "What did you say, shrimp?"
},
{
"n": 14,
"h": "ab0c416a",
"en_raw": "Come behind the school building now"
},
{
"n": 15,
"h": "7edf22ad",
"en_raw": "You want a fight?"
},
{
"n": 16,
"h": "06f3952b",
"en_raw": "Yeah, I'll show you mine"
},
{
"n": 17,
"h": "aa01c1cc",
"en_raw": "Fine, Shige"
},
{
"n": 18,
"h": "f2e1ddef",
"en_raw": "we're both men, you and I"
},
{
"n": 19,
"h": "807e4b09",
"en_raw": "Then it's settled"
},
{
"n": 20,
"h": "8a9aa1a9",
"en_raw": "The redevelopment site tonight"
},
{
"n": 21,
"h": "96c932e3",
"en_raw": "Hey, Murase"
},
{
"n": 22,
"h": "2f65bfe7",
"en_raw": "Guys with no hair"
},
{
"n": 23,
"h": "327a52c4",
"en_raw": "should go walk dogs with the girls"
},
{
"n": 24,
"h": "84eda2c6",
"en_raw": "Go on"
},
{
"n": 25,
"h": "2d2843ac",
"en_raw": "Murase, aren't you interested"
},
{
"n": 26,
"h": "0021928e",
"en_raw": "in the redevelopment site?"
},
{
"n": 27,
"h": "d35f0cb1",
"en_raw": "What are you talking about?"
},
{
"n": 28,
"h": "88237791",
"en_raw": "It doesn't concern you"
},
{
"n": 29,
"h": "1ea24e78",
"en_raw": "Hey, Nishi..."
},
{
"n": 30,
"h": "5d140226",
"en_raw": "That place..."
},
{
"n": 31,
"h": "b2610665",
"en_raw": "what is it?"
},
{
"n": 32,
"h": "b49b276d",
"en_raw": "No, it's nothing..."
},
{
"n": 33,
"h": "633380a7",
"en_raw": "Are you going too, Nishi?"
},
{
"n": 34,
"h": "7f4a4688",
"en_raw": "Me? Actually, I'm torn"
},
{
"n": 35,
"h": "18d85084",
"en_raw": "Sorry to Yuasa, but"
},
{
"n": 36,
"h": "16706398",
"en_raw": "I have a feeling it'd get found out"
},
{
"n": 37,
"h": "9281f240",
"en_raw": "if I go with those guys"
},
{
"n": 38,
"h": "5f4018de",
"en_raw": "Hmm"
},
{
"n": 39,
"h": "6ed46aa0",
"en_raw": "Besides, really"
},
{
"n": 40,
"h": "c863436e",
"en_raw": "there's a better entrance than"
},
{
"n": 41,
"h": "ff91021d",
"en_raw": "climbing the fence"
},
{
"n": 42,
"h": "ac32d5f3",
"en_raw": "A tear in the fence behind"
},
{
"n": 43,
"h": "bc75c2e7",
"en_raw": "the new parking lot"
},
{
"n": 44,
"h": "83a5ed91",
"en_raw": "If you go that way, no one"
},
{
"n": 45,
"h": "e8681c6c",
"en_raw": "will see you"
},
{
"n": 46,
"h": "c52d0845",
"en_raw": "I see"
},
{
"n": 47,
"h": "22ab8404",
"en_raw": "Murase, let's go check it out"
},
{
"n": 48,
"h": "d784f399",
"en_raw": "together sometime"
},
{
"n": 49,
"h": "16268503",
"en_raw": "Obtained the rumor of the Redevelopment Site"
},
{
"n": 50,
"h": "d0bc0698",
"en_raw": "It's odd for me to say, but"
},
{
"n": 51,
"h": "4ba09a0b",
"en_raw": "you should play around more"
},
{
"n": 52,
"h": "2509d88f",
"en_raw": "Sorry, I just"
},
{
"n": 53,
"h": "2899cbf5",
"en_raw": "remembered I have something to do"
}
]
