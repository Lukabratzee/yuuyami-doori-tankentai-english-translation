"lines": [
{
"n": 0,
"h": "eeea2d35",
"en_raw": "Ah!"
},
{
"n": 1,
"h": "904a4d3b",
"en_raw": "We're in trouble if we're found"
},
{
"n": 2,
"h": "eeea2d35",
"en_raw": "Ah!"
},
{
"n": 3,
"h": "340c5931",
"en_raw": "You're still here..."
},
{
"n": 4,
"h": "8445d2ca",
"en_raw": "Hey, what are you"
},
{
"n": 5,
"h": "4f44218b",
"en_raw": "doing in a place like this"
},
{
"n": 6,
"h": "317fd9df",
"en_raw": "I told you"
},
{
"n": 7,
"h": "682ec30d",
"en_raw": "to go home quickly"
},
{
"n": 8,
"h": "a19189e7",
"en_raw": "Sorry"
},
{
"n": 9,
"h": "129672ba",
"en_raw": "didn't I?"
},
{
"n": 10,
"h": "cb86c070",
"en_raw": "Um, there's a situation..."
},
{
"n": 11,
"h": "eca733c3",
"en_raw": "I won't listen to that"
},
{
"n": 12,
"h": "5205c339",
"en_raw": "Anyway, this place"
},
{
"n": 13,
"h": "957b7f58",
"en_raw": "is dangerous in many ways"
},
{
"n": 14,
"h": "05bdecb4",
"en_raw": "For kids your age"
},
{
"n": 15,
"h": "b305a711",
"en_raw": "a warning might be enough"
},
{
"n": 16,
"h": "36d18f74",
"en_raw": "but if smaller kids"
},
{
"n": 17,
"h": "8c04029d",
"en_raw": "copy you and come in..."
},
{
"n": 18,
"h": "da14ebb8",
"en_raw": "But, um, a child"
},
{
"n": 19,
"h": "a9e3004f",
"en_raw": "seems to have gone in!"
},
{
"n": 20,
"h": "e30f7fef",
"en_raw": "What?"
},
{
"n": 21,
"h": "fcf77cc0",
"en_raw": "...When?"
},
{
"n": 22,
"h": "13b6a112",
"en_raw": "I think it was... before yesterday"
},
{
"n": 23,
"h": "67237b10",
"en_raw": "Ah, those middle school boys?"
},
{
"n": 24,
"h": "f992cf46",
"en_raw": "No, probably"
},
{
"n": 25,
"h": "06a6cfce",
"en_raw": "a much younger child..."
},
{
"n": 26,
"h": "1f279b10",
"en_raw": "...Probably?"
},
{
"n": 27,
"h": "d849517c",
"en_raw": "No, um..."
},
{
"n": 28,
"h": "8969660c",
"en_raw": "Didn't you see it?"
},
{
"n": 29,
"h": "5f5a3586",
"en_raw": "Listen..."
},
{
"n": 30,
"h": "4268e699",
"en_raw": "if you're going to lie"
},
{
"n": 31,
"h": "a3272818",
"en_raw": "make it a better one"
},
{
"n": 32,
"h": "eef17378",
"en_raw": "Why do you think I'm"
},
{
"n": 33,
"h": "9e566ce6",
"en_raw": "here in uniform?"
},
{
"n": 34,
"h": "3ae04993",
"en_raw": "Reports like that definitely"
},
{
"n": 35,
"h": "852f0d2d",
"en_raw": "Phew..."
},
{
"n": 36,
"h": "64d0eef8",
"en_raw": "come to us first"
},
{
"n": 37,
"h": "fe937a03",
"en_raw": "But today I need a report"
},
{
"n": 38,
"h": "4f90e499",
"en_raw": "Three middle schoolers with a dog and..."
},
{
"n": 39,
"h": "41c74759",
"en_raw": "Um... I'm sorry"
},
{
"n": 40,
"h": "9bf65580",
"en_raw": "Well, I only heard this"
},
{
"n": 41,
"h": "6ff13bb6",
"en_raw": "Five years ago, a kid"
},
{
"n": 42,
"h": "f8078147",
"en_raw": "got into this ruin's boiler"
},
{
"n": 43,
"h": "ff333aec",
"en_raw": "and died of exhaustion"
},
{
"n": 44,
"h": "804dc5e5",
"en_raw": "If you leave places like this"
},
{
"n": 45,
"h": "4d04f92f",
"en_raw": "kids always want to play"
},
{
"n": 46,
"h": "72a2a686",
"en_raw": "So if you really see one"
},
{
"n": 47,
"h": "c4836ea5",
"en_raw": "be sure to report it"
},
{
"n": 48,
"h": "5c634c71",
"en_raw": "Yes"
},
{
"n": 49,
"h": "7d761b2c",
"en_raw": "You really startled me..."
},
{
"n": 50,
"h": "e9834630",
"en_raw": "Sorry, I'll go home right away..."
},
{
"n": 51,
"h": "d001a7fc",
"en_raw": "Since you've been caught"
},
{
"n": 52,
"h": "33c5454d",
"en_raw": "I can't just send you home"
},
{
"n": 53,
"h": "742dcc0e",
"en_raw": "You'll hear the"
},
{
"n": 54,
"h": "8445d2ca",
"en_raw": "Hey, what are you"
},
{
"n": 55,
"h": "4f44218b",
"en_raw": "doing in a place like this"
},
{
"n": 56,
"h": "09cf5736",
"en_raw": "warning to the end"
},
{
"n": 57,
"h": "5f8f361c",
"en_raw": "Excuse me..."
},
{
"n": 58,
"h": "7158a92b",
"en_raw": "...That's the situation"
},
{
"n": 59,
"h": "9703a530",
"en_raw": "I should be thanking you"
},
{
"n": 60,
"h": "c5d76fcd",
"en_raw": "but, how to put it... well"
},
{
"n": 61,
"h": "2cae455a",
"en_raw": "I'll say it again, it's dangerous"
},
{
"n": 62,
"h": "2d8d8e76",
"en_raw": "so don't go in again"
},
{
"n": 63,
"h": "2447d2ed",
"en_raw": "Still,"
},
{
"n": 64,
"h": "6dac419d",
"en_raw": "What a strange day..."
},
{
"n": 65,
"h": "3a841e1d",
"en_raw": "Excuse me"
}
]
