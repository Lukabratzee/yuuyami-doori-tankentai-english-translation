"lines": [
{
"n": 0,
"h": "680ac39d",
"en_raw": "Excuse me, um..."
},
{
"n": 1,
"h": "dd35bb3e",
"en_raw": "the old woman who lived"
},
{
"n": 2,
"h": "f3c5252f",
"en_raw": "under the overpass..."
},
{
"n": 3,
"h": "510bb236",
"en_raw": "The one who settled under the overpass"
},
{
"n": 4,
"h": "535743cb",
"en_raw": "on the station's west side?"
},
{
"n": 5,
"h": "5535978e",
"en_raw": "...Ah"
},
{
"n": 6,
"h": "fc92c04e",
"en_raw": "you mean the old woman who always sits there"
},
{
"n": 7,
"h": "f47d0316",
"en_raw": "Today..."
},
{
"n": 8,
"h": "cba41de2",
"en_raw": "she wasn't there, it seems"
},
{
"n": 9,
"h": "3b8f6044",
"en_raw": "but..."
},
{
"n": 10,
"h": "093637ab",
"en_raw": "A passing office worker"
},
{
"n": 11,
"h": "bd48bc09",
"en_raw": "found her collapsed"
},
{
"n": 12,
"h": "3e69d7fe",
"en_raw": "and she was taken by ambulance"
},
{
"n": 13,
"h": "4459e67f",
"en_raw": "But last night the hospital"
},
{
"n": 14,
"h": "252ea001",
"en_raw": "contacted us here"
},
{
"n": 15,
"h": "430cb4b7",
"en_raw": "and apparently she"
},
{
"n": 16,
"h": "5b78754b",
"en_raw": "ran away"
},
{
"n": 17,
"h": "b7f9f02e",
"en_raw": ".........."
},
{
"n": 18,
"h": "2fe51b7d",
"en_raw": "So, that's the situation"
},
{
"n": 19,
"h": "1a52d89c",
"en_raw": "she might come around here again"
},
{
"n": 20,
"h": "d82e211e",
"en_raw": "so"
},
{
"n": 21,
"h": "1325fa57",
"en_raw": "if you see her"
},
{
"n": 22,
"h": "57ff5297",
"en_raw": "could you let us know?"
},
{
"n": 23,
"h": "f573891a",
"en_raw": "Yes, understood..."
},
{
"n": 24,
"h": "a3b7eee8",
"en_raw": "Excuse me, um..."
},
{
"n": 25,
"h": "fe632fce",
"en_raw": "Did the old woman collapse"
},
{
"n": 26,
"h": "2e3107b4",
"en_raw": "because of a dog bite wound?"
},
{
"n": 27,
"h": "e0b42f48",
"en_raw": "...Nao!"
},
{
"n": 28,
"h": "6859e81f",
"en_raw": "...A bite wound?"
},
{
"n": 29,
"h": "0ecc65aa",
"en_raw": "I don't think there was any injury"
},
{
"n": 30,
"h": "c76b666b",
"en_raw": "I imagined a so-called violent"
},
{
"n": 31,
"h": "9681dd3f",
"en_raw": "incident myself, but"
},
{
"n": 32,
"h": "9d671429",
"en_raw": "it seems she just lost consciousness"
},
{
"n": 33,
"h": "32f70e78",
"en_raw": "She's elderly, after all"
},
{
"n": 34,
"h": "d83b189c",
"en_raw": "I see..."
},
{
"n": 35,
"h": "ebd2ccab",
"en_raw": "Thank you very much"
},
{
"n": 36,
"h": "4b426675",
"en_raw": "Um..."
},
{
"n": 37,
"h": "3f0c25ac",
"en_raw": "if you see her, could you let us know?"
},
{
"n": 38,
"h": "8a078452",
"en_raw": "Um... excuse me"
},
{
"n": 39,
"h": "1a60046d",
"en_raw": "It's nothing"
},
{
"n": 40,
"h": "fd23ff82",
"en_raw": "Is it okay to just..."
},
{
"n": 41,
"h": "04029c30",
"en_raw": "go home like this...?"
}
]
}