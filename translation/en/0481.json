],
"lines": [
{
"n": 0,
"h": "e4d3100b",
"en_raw": "Hey, Sango"
},
{
"n": 1,
"h": "affba3f9",
"en_raw": "Will-o'-wisps don't come out"
},
{
"n": 2,
"h": "5896f56b",
"en_raw": "when it's bright, right?"
},
{
"n": 3,
"h": "7811011d",
"en_raw": "Shouldn't we wait?"
},
{
"n": 4,
"h": "e2e26b56",
"en_raw": "Wait / No  It's about time, isn't it?"
},
{
"n": 5,
"h": "08f52820",
"en_raw": "...Wait, you say, but"
},
{
"n": 6,
"h": "6864d0f7",
"en_raw": "we don't know"
},
{
"n": 7,
"h": "25a78d80",
"en_raw": "if they really appear"
},
{
"n": 8,
"h": "14ad2e51",
"en_raw": "Hey, sorry to bother you"
},
{
"n": 9,
"h": "ea2541ac",
"en_raw": "Excuse me, but..."
},
{
"n": 10,
"h": "4dbabd31",
"en_raw": "Haven't you heard a rumor"
},
{
"n": 11,
"h": "3367e759",
"en_raw": "of will-o'-wisps around here?"
},
{
"n": 12,
"h": "0a029a11",
"en_raw": "...Will-o'-wisps?"
},
{
"n": 13,
"h": "6320e6aa",
"en_raw": "Yeah, you see them a lot lately"
},
{
"n": 14,
"h": "4084e397",
"en_raw": "Liar!"
},
{
"n": 15,
"h": "ff02215f",
"en_raw": "Well, who knows"
},
{
"n": 16,
"h": "69fc0fdc",
"en_raw": "Hey, did you really see them?"
},
{
"n": 17,
"h": "ff02215f",
"en_raw": "Well, who knows"
},
{
"n": 18,
"h": "982d21b7",
"en_raw": "Hey, mister"
},
{
"n": 19,
"h": "4dbabd31",
"en_raw": "Haven't you heard a rumor"
},
{
"n": 20,
"h": "3367e759",
"en_raw": "of will-o'-wisps around here?"
},
{
"n": 21,
"h": "0a029a11",
"en_raw": "...Will-o'-wisps?"
},
{
"n": 22,
"h": "f55968ef",
"en_raw": "Oh..."
},
{
"n": 23,
"h": "390f226a",
"en_raw": "They're my friends..."
},
{
"n": 24,
"h": "e5a1702f",
"en_raw": "Hey, really"
},
{
"n": 25,
"h": "13547939",
"en_raw": "Mister's friends?"
},
{
"n": 26,
"h": "0e578728",
"en_raw": "Come again at night"
},
{
"n": 27,
"h": "09b0abb4",
"en_raw": "Hey, haven't you heard a story"
},
{
"n": 28,
"h": "fc897a72",
"en_raw": "of will-o'-wisps seen around here?"
},
{
"n": 29,
"h": "0a029a11",
"en_raw": "...Will-o'-wisps?"
},
{
"n": 30,
"h": "a634af8f",
"en_raw": "Speaking of will-o'-wisps,"
},
{
"n": 31,
"h": "b1409149",
"en_raw": "one night on a mountain path"
},
{
"n": 32,
"h": "db21d905",
"en_raw": "I got lost"
},
{
"n": 33,
"h": "9eec6057",
"en_raw": "Then, far off,"
},
{
"n": 34,
"h": "5219a98e",
"en_raw": "lots of lights were glowing"
},
{
"n": 35,
"h": "e7cb0c16",
"en_raw": "I thought, great, I'm saved"
},
{
"n": 36,
"h": "74e95af5",
"en_raw": "and went over"
},
{
"n": 37,
"h": "44270688",
"en_raw": "But when I got there,"
},
{
"n": 38,
"h": "a1a21fe2",
"en_raw": "there wasn't a house in sight"
},
{
"n": 39,
"h": "e339fd3b",
"en_raw": "Looking around carefully..."
},
{
"n": 40,
"h": "b36b7524",
"en_raw": "an old temple"
},
{
"n": 41,
"h": "397c858a",
"en_raw": "and untended graves"
},
{
"n": 42,
"h": "73c23fe0",
"en_raw": "covering the whole dark mountainside..."
},
{
"n": 43,
"h": "aa7b641c",
"en_raw": "A well-made tall tale"
},
{
"n": 44,
"h": "87ce2cda",
"en_raw": "But these days, no such place"
},
{
"n": 45,
"h": "a5911785",
"en_raw": "exists anywhere"
},
{
"n": 46,
"h": "c5d6ee98",
"en_raw": "Hey, mister...?"
},
{
"n": 47,
"h": "b7d6cf5d",
"en_raw": "In the old days people would"
},
{
"n": 48,
"h": "ddf0673e",
"en_raw": "obediently be scared"
},
{
"n": 49,
"h": "516753b6",
"en_raw": "It's become an age where"
},
{
"n": 50,
"h": "6b9e3e02",
"en_raw": "will-o'-wisps have trouble appearing"
},
{
"n": 51,
"h": "e094ec47",
"en_raw": "Yahoo, girl"
},
{
"n": 52,
"h": "f3a94c11",
"en_raw": "Earning experience points?"
},
{
"n": 53,
"h": "68075181",
"en_raw": "Today I came to hear"
},
{
"n": 54,
"h": "19c0ac10",
"en_raw": "will-o'-wisp sighting stories"
},
{
"n": 55,
"h": "0a029a11",
"en_raw": "...Will-o'-wisps?"
},
{
"n": 56,
"h": "c8fa1893",
"en_raw": "Oh, that thing"
},
{
"n": 57,
"h": "e89d1968",
"en_raw": "Isn't it a bit early?"
},
{
"n": 58,
"h": "b4a1f04b",
"en_raw": "Huh, they really appear?"
},
{
"n": 59,
"h": "161d685e",
"en_raw": "I'm bad with that kind of thing,"
},
{
"n": 60,
"h": "6950c743",
"en_raw": "so I'll be heading home"
},
{
"n": 61,
"h": "24411933",
"en_raw": "Hey, really, really"
},
{
"n": 62,
"h": "559c1ec6",
"en_raw": "...do they appear?"
},
{
"n": 63,
"h": "6f6e79fc",
"en_raw": "Go and see"
},
{
"n": 64,
"h": "9a4fbc9c",
"en_raw": "At night... around seven, maybe"
},
{
"n": 65,
"h": "0af3330c",
"en_raw": "A will-o'-wisp...!?"
},
{
"n": 66,
"h": "5f0569ef",
"en_raw": "Approach / Run away  Nothing..."
},
{
"n": 67,
"h": "35c3e304",
"en_raw": "But somehow, around here,"
},
{
"n": 68,
"h": "83559055",
"en_raw": "Smells like an animal..."
},
{
"n": 69,
"h": "4ca99002",
"en_raw": "How is this guy a will-o'-wisp?"
},
{
"n": 70,
"h": "f461273d",
"en_raw": "Mister, what on earth now,"
},
{
"n": 71,
"h": "442b894b",
"en_raw": "What are you doing?"
},
{
"n": 72,
"h": "70c45ce5",
"en_raw": "Transmitting... transmitting..."
},
{
"n": 73,
"h": "8549ff9d",
"en_raw": "Terribly, terribly busy"
},
{
"n": 74,
"h": "70c45ce5",
"en_raw": "Transmitting... transmitting..."
},
{
"n": 75,
"h": "967f1a60",
"en_raw": "Crambon, crambon"
},
{
"n": 76,
"h": "982d21b7",
"en_raw": "Hey, mister"
}
]
}