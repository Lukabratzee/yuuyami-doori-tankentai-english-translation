},
{
"n": 22,
"h": "8d485006",
"en_raw": "Earlier you said something"
},
{
"n": 23,
"h": "ce0599f9",
"en_raw": "about the same thing"
},
{
"n": 24,
"h": "67808bc0",
"en_raw": "what was that?"
},
{
"n": 25,
"h": "7ffbd737",
"en_raw": "Well, I mean, this thing"
},
{
"n": 26,
"h": "87f3f3b8",
"en_raw": "is something you can"
},
{
"n": 27,
"h": "2061cf66",
"en_raw": "get that easily?"
},
{
"n": 28,
"h": "9ba9f757",
"en_raw": "...I hadn't noticed"
},
{
"n": 29,
"h": "5c3f21c0",
"en_raw": "Right, you're right"
},
{
"n": 30,
"h": "e9dfd7a9",
"en_raw": "No one at school is skilled enough"
},
{
"n": 31,
"h": "e90355a4",
"en_raw": "to make something like this"
},
{
"n": 32,
"h": "de427d64",
"en_raw": "Which means this"
},
{
"n": 33,
"h": "3da75cb0",
"en_raw": "is definitely store-bought"
},
{
"n": 34,
"h": "41e6f960",
"en_raw": "Hirauchi, I'll look"
},
{
"n": 35,
"h": "7cf4cf56",
"en_raw": "for a place that sells them too"
},
{
"n": 36,
"h": "a2cc8730",
"en_raw": "Thanks for your help"
},
{
"n": 37,
"h": "491d2d36",
"en_raw": "...Ah, right"
},
{
"n": 38,
"h": "70be8f17",
"en_raw": "You two wait here"
},
{
"n": 39,
"h": "9656a4fa",
"en_raw": "I don't really believe it"
},
{
"n": 40,
"h": "2a075f5a",
"en_raw": "but it seems a condition is"
},
{
"n": 41,
"h": "6356078c",
"en_raw": "that nobody sees you"
},
{
"n": 42,
"h": "519f4935",
