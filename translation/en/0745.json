},
{
"n": 9,
"h": "a41506b2",
"en_raw": "Nao told me"
},
{
"n": 10,
"h": "55c60a36",
"en_raw": "you're someone"
},
{
"n": 11,
"h": "536231de",
"en_raw": "who can be trusted..."
},
{
"n": 12,
"h": "4ee11060",
"en_raw": "Ha, that's embarrassing"
},
{
"n": 13,
"h": "16b83fb9",
"en_raw": "Sanjo, got a minute?"
},
{
"n": 14,
"h": "75c44c65",
"en_raw": "Anyway, I want you to look at this"
},
{
"n": 15,
"h": "116762af",
"en_raw": "What's this, a lizard hand...?"
},
{
"n": 16,
"h": "c7ef8152",
"en_raw": "I've never seen one before"
},
{
"n": 17,
"h": "b11bd95b",
"en_raw": "I imagined something more"
},
{
"n": 18,
"h": "7d968300",
"en_raw": "corpse-like, but..."
},
{
"n": 19,
"h": "280120d4",
"en_raw": "Still, there are three"
},
{
"n": 20,
"h": "350cb3e2",
"en_raw": "of the same thing"
},
{
"n": 21,
"h": "9ba6675f",
