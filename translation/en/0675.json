{
"n": 0,
"h": "6a4dd12d",
"en_raw": "...Ah"
},
{
"n": 1,
"h": "156b325b",
"en_raw": "you mean this photo"
},
{
"n": 2,
"h": "c0894bb6",
"en_raw": "Look closer / Enough  ...or rather, that's plenty"
},
{
"n": 3,
"h": "3e286a62",
"en_raw": "...What about this"
},
{
"n": 4,
"h": "fe59870d",
"en_raw": "is a spirit photo?"
},
{
"n": 5,
"h": "632a81c5",
"en_raw": "It's even lamer"
},
{
"n": 6,
"h": "f060ec02",
"en_raw": "than I expected..."
},
{
"n": 7,
"h": "4ce3e979",
"en_raw": "It's from the bathroom brigade"
},
{
"n": 8,
"h": "7239489f",
"en_raw": "so I saw the result coming"
},
{
"n": 9,
"h": "dbf47ce2",
"en_raw": "Even as a joke, I wish"
},
{
"n": 10,
"h": "c6ecd019",
"en_raw": "they'd put in a bit more effort"
},
{
"n": 11,
"h": "0e87675e",
"en_raw": "Excuse me"
},
{
"n": 12,
"h": "782e7079",
"en_raw": "I heard there used to be"
},
{
"n": 13,
"h": "46534b23",
"en_raw": "a Bird Mound around here..."
},
{
"n": 14,
"h": "af1a9873",
"en_raw": "Do you know anything about it?"
},
{
"n": 15,
"h": "472d5ddd",
"en_raw": "Bird Mound...?"
},
{
"n": 16,
"h": "0cb59051",
"en_raw": "Bird Mound..."
},
{
"n": 17,
"h": "4df8e5b0",
"en_raw": "Ah, now that you say so"
},
{
"n": 18,
"h": "305d9978",
"en_raw": "I think the notice board there"
},
{
"n": 19,
"h": "45eefe4e",
"en_raw": "said something like that..."
},
{
"n": 20,
"h": "552ff3d5",
"en_raw": "But was it really Bird Mound?"
},
{
"n": 21,
"h": "d32d7a68",
"en_raw": "Thanks, I'll take a look"
},
{
"n": 22,
"h": "9a5809db",
"en_raw": "I don't remember"
},
{
"n": 23,
"h": "865e0f18",
"en_raw": "the details well either"
},
{
"n": 24,
"h": "91e5c68c",
"en_raw": "The orange thing"
},
{
"n": 25,
"h": "b83c3307",
"en_raw": "beside the housing complex board"
},
{
"n": 26,
"h": "2c10eef6",
"en_raw": "try reading that"
},
{
"n": 27,
"h": "0dcdb061",
"en_raw": "Anything that seems related..."
},
{
"n": 28,
"h": "ea67372f",
"en_raw": "There's nothing written..."
},
{
"n": 29,
"h": "bf91ce7f",
"en_raw": "'Regional Cultural Property No. 3"
},
{
"n": 30,
"h": "e3b36346",
"en_raw": "Site of the Hirumi Bird Mound'"
},
{
"n": 31,
"h": "ca398838",
"en_raw": "'August 14, Showa 63"
},
{
"n": 32,
"h": "20353e18",
"en_raw": "Relocated to the place below'"
},
{
"n": 33,
"h": "909e98cf",
"en_raw": "I'd overlooked it until now"
},
{
"n": 34,
"h": "1c954a69",
"en_raw": "I never knew there was such a thing..."
},
{
"n": 35,
"h": "3f8dd3d2",
"en_raw": "Huh, so there really was"
},
{
"n": 36,
"h": "3d254930",
"en_raw": "a Bird Mound here..."
},
{
"n": 37,
"h": "eac9fc20",
"en_raw": "Look closer / That's enough  This much is plenty"
},
{
"n": 38,
"h": "81cee454",
"en_raw": "Hirumi Bird Mound Site..."
},
{
"n": 39,
"h": "1f1b304f",
"en_raw": "Bird..."
},
{
"n": 40,
"h": "d84e703a",
"en_raw": "Bird?"
},
{
"n": 41,
"h": "66f04992",
"en_raw": "...Huh, doesn't this character"
},
{
"n": 42,
"h": "0974de5a",
"en_raw": "look off?"
},
{
"n": 43,
"h": "b56820ee",
"en_raw": "This isn't 'bird'"
},
{
"n": 44,
"h": "d329802c",
"en_raw": "one stroke is missing"
},
{
"n": 45,
"h": "b97d7404",
"en_raw": "This character..."
},
{
"n": 46,
"h": "c3b6745b",
"en_raw": "I think it's read 'crow'"
},
{
"n": 47,
"h": "b22b5691",
"en_raw": "So it wasn't really Bird Mound"
},
{
"n": 48,
"h": "693a53db",
"en_raw": "but Crow Mound?"
},
{
"n": 49,
"h": "505b4cfc",
"en_raw": "Hmm..."
},
{
"n": 50,
"h": "dd98816d",
"en_raw": "Not that it matters, though"
}
]
