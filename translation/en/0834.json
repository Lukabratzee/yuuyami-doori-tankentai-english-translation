"lines": [
{
"n": 0,
"h": "0357ef1d",
"en_raw": "Melos!"
},
{
"n": 1,
"h": "f526052d",
"en_raw": "Oh, oh"
},
{
"n": 2,
"h": "5e5e9c68",
"en_raw": "You've made a fine decision"
},
{
"n": 3,
"h": "91b904d8",
"en_raw": "Princess Bon"
},
{
"n": 4,
"h": "ead34963",
"en_raw": "Thanks also to everyone else for seeing us off"
},
{
"n": 5,
"h": "8966fdc1",
"en_raw": "It'll be here shortly,"
},
{
"n": 6,
"h": "130d9cf5",
"en_raw": "so please wait"
},
{
"n": 7,
"h": "9fad2dff",
"en_raw": "Mister?"
},
{
"n": 8,
"h": "f55968ef",
"en_raw": "Oh..."
},
{
"n": 9,
"h": "0859b3d3",
"en_raw": "There seems to be some trouble with the orbit"
},
{
"n": 10,
"h": "e4b74f9e",
"en_raw": "Wait a little longer..."
},
{
"n": 11,
"h": "804670e3",
"en_raw": "Hey, are you even listening?"
},
{
"n": 12,
"h": "f55968ef",
"en_raw": "Oh..."
},
{
"n": 13,
"h": "9834cbd4",
"en_raw": "Trouble seems to have occurred"
},
{
"n": 14,
"h": "71a5cc9d",
"en_raw": "with the landing gear"
},
{
"n": 15,
"h": "e4b74f9e",
"en_raw": "Wait a little longer..."
},
{
"n": 16,
"h": "2c87d15a",
"en_raw": "Hey, I said!"
},
{
"n": 17,
"h": "8d7dc7e4",
"en_raw": "Ah, ah... no!"
},
{
"n": 18,
"h": "d20e1384",
"en_raw": "The US military investigation agency"
},
{
"n": 19,
"h": "142f2faf",
"en_raw": "is already at the landing point!"
},
{
"n": 20,
"h": "0b1e07fe",
"en_raw": "Change the point... roger"
},
{
"n": 21,
"h": "e4b74f9e",
"en_raw": "Wait a little longer..."
},
{
"n": 22,
"h": "0ba96cbb",
"en_raw": "We're going home now!"
},
{
"n": 23,
"h": "68607162",
"en_raw": "The atmospheric entry route"
},
{
"n": 24,
"h": "e5d44317",
"en_raw": "shifted by 0.1 due to a bug"
},
{
"n": 25,
"h": "472b6908",
"en_raw": "Arrival 2000 km past the plan"
},
{
"n": 26,
"h": "ba9e2515",
"en_raw": "...Roger"
},
{
"n": 27,
"h": "654f4daf",
"en_raw": "Wait a little longer..."
},
{
"n": 28,
"h": "76441b4f",
"en_raw": "Got it, mister"
},
{
"n": 29,
"h": "bb9fe09f",
"en_raw": "you're making fun"
},
{
"n": 30,
"h": "139ac70b",
"en_raw": "of us, aren't you?"
},
{
"n": 31,
"h": "5ad49ef0",
"en_raw": "Word from Quasar"
},
{
"n": 32,
"h": "bd1f83d3",
"en_raw": "Some problems with the Earth landing approval"
},
{
"n": 33,
"h": "dbdcacfc",
"en_raw": "Return to orbit for now...?"
},
{
"n": 34,
"h": "99e30820",
"en_raw": "That's bureaucracy for you..."
},
{
"n": 35,
"h": "e4b74f9e",
"en_raw": "Wait a little longer..."
},
{
"n": 36,
"h": "58b5f7ce",
"en_raw": "Hey!!!"
},
{
"n": 37,
"h": "b7f9f02e",
"en_raw": ".........."
},
{
"n": 38,
"h": "b3dc4c13",
"en_raw": "...Mister?"
},
{
"n": 39,
"h": "34cf0292",
"en_raw": "........"
},
{
"n": 40,
"h": "d2d694ba",
"en_raw": "It's not coming"
},
{
"n": 41,
"h": "71c8bd49",
"en_raw": "How long are you going to make us wait?"
},
{
"n": 42,
"h": "76b67ede",
"en_raw": "No way..."
},
{
"n": 43,
"h": "b957e087",
"en_raw": "That the rescue craft would abandon us"
},
{
"n": 44,
"h": "fbf95307",
"en_raw": "I mean"
},
{
"n": 45,
"h": "def0c313",
"en_raw": "Could you listen a little to..."
},
{
"n": 46,
"h": "cba47113",
"en_raw": "Ah, ah, I see, I understand"
},
{
"n": 47,
"h": "cd8629ce",
"en_raw": "Comrades of Kapras racing the galaxy"
},
{
"n": 48,
"h": "70fd6174",
"en_raw": "What is it, all of a sudden?"
},
{
"n": 49,
"h": "34cf0292",
"en_raw": "........"
},
{
"n": 50,
"h": "af02617c",
"en_raw": "Ah, ah, yes indeed"
},
{
"n": 51,
"h": "a727e440",
"en_raw": "This is a trial..."
},
{
"n": 52,
"h": "f117d368",
"en_raw": "It means I should stay"
},
{
"n": 53,
"h": "1dff1cb7",
"en_raw": "with the Princess"
},
{
"n": 54,
"h": "6b2f8544",
"en_raw": "There's still hope on this planet, it says"
},
{
"n": 55,
"h": "34cf0292",
"en_raw": "........"
},
{
"n": 56,
"h": "180e83d7",
"en_raw": "Now, Earth girl"
},
{
"n": 57,
"h": "8828ece1",
"en_raw": "W-what?"
},
{
"n": 58,
"h": "03e835d5",
"en_raw": "I've decided to stay"
},
{
"n": 59,
"h": "d18ed1c7",
"en_raw": "It isn't decided that we've lost"
},
{
"n": 60,
"h": "e691ffbb",
"en_raw": "A battle is never lost"
},
{
"n": 61,
"h": "4d1e0050",
"en_raw": "I will not lose"
},
{
"n": 62,
"h": "fce056a8",
"en_raw": "And probably"
},
{
"n": 63,
"h": "76abc377",
"en_raw": "Earthlings will notice someday"
},
{
"n": 64,
"h": "876d24e8",
"en_raw": "As long as there are people"
},
{
"n": 65,
"h": "5e3a0cd0",
"en_raw": "As long as there are smart people"
},
{
"n": 66,
"h": "1a8b034b",
"en_raw": "surely..."
},
{
"n": 67,
"h": "b7f9f02e",
"en_raw": ".........."
},
{
"n": 68,
"h": "6f4d76f8",
"en_raw": "What's wrong?"
},
{
"n": 69,
"h": "0a21f355",
"en_raw": "...My stomach growled"
},
{
"n": 70,
"h": "cfcd3cd1",
"en_raw": "Let's call it a day"
},
{
"n": 71,
"h": "07cd82df",
"en_raw": "Then I leave the Princess to you"
},
{
"n": 72,
"h": "15878f66",
"en_raw": "Earth girl"
},
{
"n": 73,
"h": "19d1998a",
"en_raw": "Until again, somewhere!"
},
{
"n": 74,
"h": "370dd88e",
"en_raw": "What's that supposed to mean!?"
},
{
"n": 75,
"h": "1f053bf2",
"en_raw": "Princess, please wait a little longer"
},
{
"n": 76,
"h": "09fd9fb3",
"en_raw": "Soon..."
},
{
"n": 77,
"h": "c9683788",
"en_raw": "The rescue craft will arrive soon!"
}
]
}