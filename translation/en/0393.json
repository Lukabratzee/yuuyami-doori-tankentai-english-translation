"lines": [
{
"n": 0,
"h": "42f743dd",
"en_raw": "Huh?"
},
{
"n": 1,
"h": "680d71c6",
"en_raw": "This is the Hime Grove"
},
{
"n": 2,
"h": "4fdf7552",
"en_raw": "Long ago there was a proper shrine"
},
{
"n": 3,
"h": "57180d91",
"en_raw": "but..."
},
{
"n": 4,
"h": "19926999",
"en_raw": "...Now it's this"
},
{
"n": 5,
"h": "37245924",
"en_raw": "Just a parking lot, isn't it"
},
{
"n": 6,
"h": "0ff24ec9",
"en_raw": "Right..."
},
{
"n": 7,
"h": "8220577e",
"en_raw": "Everyone forgets"
},
{
"n": 8,
"h": "09cad920",
"en_raw": "a tale that begins 'once upon a time'"
},
{
"n": 9,
"h": "a5e4cdb2",
"en_raw": "about the girl who protected Hirumi"
},
{
"n": 10,
"h": "1311e16a",
"en_raw": "You're not interested either, are you?"
},
{
"n": 11,
"h": "d2de83a4",
"en_raw": "No matter how good a thing is"
},
{
"n": 12,
"h": "7e9652f1",
"en_raw": "nothing stays forever"
},
{
"n": 13,
"h": "b20b2c83",
"en_raw": "nothing at all"
},
{
"n": 14,
"h": "60b6f850",
"en_raw": "Now, it's getting dark"
},
{
"n": 15,
"h": "43917053",
"en_raw": "everyone, go home"
},
{
"n": 16,
"h": "4b52e505",
"en_raw": "You see, Kasuka-chan"
},
{
"n": 17,
"h": "0db0784f",
"en_raw": "...do you know her?"
},
{
"n": 18,
"h": "1bcabd3e",
"en_raw": "Well, I don't know"
},
{
"n": 19,
"h": "490f216e",
"en_raw": "But..."
},
{
"n": 20,
"h": "f7e1c2df",
"en_raw": "You'll surely meet again"
},
{
"n": 21,
"h": "f8966341",
"en_raw": "surely, you will..."
},
{
"n": 22,
"h": "4ca10655",
"en_raw": "Granny"
},
{
"n": 23,
"h": "58078258",
"en_raw": "Kurumi is a good girl"
},
{
"n": 24,
"h": "47e53e5b",
"en_raw": "so go home for today"
}
]
}