},
{
"n": 83,
"h": "4b426675",
"en_raw": "Um..."
},
{
"n": 84,
"h": "3eafbcc8",
"en_raw": "Are there rumors of"
},
{
"n": 85,
"h": "9709ad63",
"en_raw": "ghosts seen at the complex?"
},
{
"n": 86,
"h": "57ee6939",
"en_raw": "Well... never heard any"
},
{
"n": 87,
"h": "42b3dc4a",
"en_raw": "I see..."
},
{
"n": 88,
"h": "e333a75e",
"en_raw": "Thank you very much"
},
{
"n": 89,
"h": "cbeaf30b",
"en_raw": "Hello"
},
{
"n": 90,
"h": "c6c03f90",
"en_raw": "Oh, what a cute doggy"
},
{
"n": 91,
"h": "19d00188",
"en_raw": "Oh... thank you"
},
{
"n": 92,
"h": "3c0b199e",
