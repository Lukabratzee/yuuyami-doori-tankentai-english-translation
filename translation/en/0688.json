},
{
"n": 120,
"h": "c03a63da",
"en_raw": "Um..."
},
{
"n": 121,
"h": "73652315",
"en_raw": "When did the manager..."
},
{
"n": 122,
"h": "375a7f33",
"en_raw": "Yesterday, yesterday"
},
{
"n": 123,
"h": "a339acd1",
"en_raw": "Taken to the hospital late"
},
{
"n": 124,
"h": "434506e4",
"en_raw": "and just like that..., they say"
},
{
"n": 125,
"h": "c03a63da",
"en_raw": "Um..."
},
{
"n": 126,
"h": "8a27e576",
"en_raw": "Does he have any relatives..."
},
{
"n": 127,
"h": "35aa0a11",
"en_raw": "Mr. Kono"
},
{
"n": 128,
"h": "c1d513d6",
"en_raw": "didn't he have a wife?"
},
{
"n": 129,
"h": "bf803863",
"en_raw": "I haven't heard"
},
{
"n": 130,
"h": "bf7ce929",
"en_raw": "he was alone, I think"
},
{
"n": 131,
"h": "aa0f1bc1",
"en_raw": "Oh my, then"
},
{
"n": 132,
"h": "eedfc2b2",
"en_raw": "he really was alone..."
},
{
"n": 133,
"h": "b2e48a58",
"en_raw": "Poor man"
},
{
"n": 134,
"h": "0e4a5f90",
"en_raw": "Did you"
},
{
"n": 135,
"h": "579261f6",
"en_raw": "have something left with him?"
},
{
"n": 136,
"h": "5c2eee0a",
"en_raw": "Ah, no..."
},
{
"n": 137,
"h": "e333a75e",
"en_raw": "Thank you very much"
},
{
"n": 138,
"h": "a2bcb731",
"en_raw": "You really can't tell"
},
{
"n": 139,
"h": "ed9a9e4c",
"en_raw": "He was so healthy"
},
{
"n": 140,
"h": "ec4ab5fb",
"en_raw": "up until yesterday"
},
{
"n": 141,
"h": "f1e39097",
"en_raw": "But what kind of person"
},
{
"n": 142,
"h": "dcd54e72",
"en_raw": "will the new one be?"
},
{
"n": 143,
"h": "4b4d6c97",
"en_raw": "Well..."
},
{
"n": 144,
"h": "425d9718",
"en_raw": "Thank you very much..."
},
{
"n": 145,
"h": "0e87675e",
"en_raw": "Excuse me"
},
{
"n": 146,
"h": "a91167b7",
"en_raw": "I heard there used to be"
},
{
"n": 147,
"h": "029b8fdd",
"en_raw": "a 'Bird Mound' around here..."
},
{
"n": 148,
"h": "2e11bc8b",
"en_raw": "Bird Mound... hmm..."
},
{
"n": 149,
"h": "0e9b94ed",
"en_raw": "get lost?"
},
{
"n": 150,
"h": "740cf570",
"en_raw": "I've never heard of it"
},
{
"n": 151,
"h": "d83b189c",
"en_raw": "I see..."
},
{
"n": 152,
"h": "e333a75e",
"en_raw": "Thank you very much"
},
{
"n": 153,
"h": "f753c32d",
"en_raw": "If the manager were alive"
},
{
"n": 154,
"h": "445ec476",
"en_raw": "he'd surely have known"
},
{
"n": 155,
"h": "19589fe6",
"en_raw": "It was truly sudden"
}
]
