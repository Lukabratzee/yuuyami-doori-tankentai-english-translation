"lines": [
{
"n": 0,
"h": "51effb82",
"en_raw": "Right~"
},
{
"n": 1,
"h": "9be3eb5e",
"en_raw": "Tomoki, you also"
},
{
"n": 2,
"h": "4d6d2665",
"en_raw": "think so?"
},
{
"n": 3,
"h": "0d612805",
"en_raw": "Out of my way!"
},
{
"n": 4,
"h": "3125397a",
"en_raw": "...Ah, Tomoki!"
},
{
"n": 5,
"h": "5c2f2685",
"en_raw": "...Hey, Tomoki"
},
{
"n": 6,
"h": "29219234",
"en_raw": "is Tomoki"
},
{
"n": 7,
"h": "bc717dcc",
"en_raw": "your real name?"
},
{
"n": 8,
"h": "7bd6fd1a",
"en_raw": "What's wrong, suddenly?"
},
{
"n": 9,
"h": "1a9493c0",
"en_raw": "Thinking calmly, I"
},
{
"n": 10,
"h": "595551f5",
"en_raw": "don't know anything"
},
{
"n": 11,
"h": "be733b59",
"en_raw": "about Tomoki"
},
{
"n": 12,
"h": "061290b8",
"en_raw": "I realized..."
},
{
"n": 13,
"h": "9951b09b",
"en_raw": "Right, same for both of us"
},
{
"n": 14,
"h": "4a60e4b7",
"en_raw": "But we talk this much"
},
{
"n": 15,
"h": "715842a2",
"en_raw": "and you understand me"
},
{
"n": 16,
"h": "113443bf",
"en_raw": "way better than my parents..."
},
{
"n": 17,
"h": "5f400dd0",
"en_raw": "Surely this distance"
},
{
"n": 18,
"h": "58643a00",
"en_raw": "is the best"
},
{
"n": 19,
"h": "a742b384",
"en_raw": "Relationships don't have to be"
},
{
"n": 20,
"h": "8307731e",
"en_raw": "closer to be better, right?"
},
{
"n": 21,
"h": "d08e1111",
"en_raw": "Hahaha"
},
{
"n": 22,
"h": "0cc617e0",
"en_raw": "Does Tomoki have some too?"
},
{
"n": 23,
"h": "693de0a3",
"en_raw": "I'm home"
},
{
"n": 24,
"h": "ca89602e",
"en_raw": "So, about summer's Comikomi"
},
{
"n": 25,
"h": "3b8f6044",
"en_raw": "but..."
},
{
"n": 26,
"h": "28c0077c",
"en_raw": "I'm home~"
},
{
"n": 27,
"h": "bb04f7cf",
"en_raw": "Then why is Sango"
},
{
"n": 28,
"h": "d749ee06",
"en_raw": "Sango?"
},
{
"n": 29,
"h": "f88f85ac",
"en_raw": "But, but"
},
{
"n": 30,
"h": "0671eb39",
"en_raw": "Mayu, you know, sounds pale"
},
{
"n": 31,
"h": "d2af98ac",
"en_raw": "and like it'd break"
},
{
"n": 32,
"h": "43b98560",
"en_raw": "if you touched it"
},
{
"n": 33,
"h": "fa992113",
"en_raw": "Haha, maybe"
},
{
"n": 34,
"h": "c8402ece",
"en_raw": "I'm totally different"
},
{
"n": 35,
"h": "f282f2f8",
"en_raw": "Appearance, personality"
},
{
"n": 36,
"h": "e43724c3",
"en_raw": "Stroke counts, my parents' taste"
},
{
"n": 37,
"h": "cfa454cf",
"en_raw": "swaying who \"I\" am"
},
{
"n": 38,
"h": "4812f72c",
"en_raw": "I just couldn't accept that..."
},
{
"n": 39,
"h": "5d579356",
"en_raw": "Since then, you've been Sango"
},
{
"n": 40,
"h": "a4735669",
"en_raw": "...I see, names matter"
},
{
"n": 41,
"h": "2e0d7d25",
"en_raw": "It's the soul of words~"
},
{
"n": 42,
"h": "1998a3b4",
"en_raw": "You'll surely become"
},
{
"n": 43,
"h": "7a341126",
"en_raw": "someone who writes wonderful prose"
},
{
"n": 44,
"h": "51effb82",
"en_raw": "Right~"
},
{
"n": 45,
"h": "693de0a3",
"en_raw": "I'm home"
},
{
"n": 46,
"h": "66f2a24d",
"en_raw": "Stop it already!"
},
{
"n": 47,
"h": "329d5335",
"en_raw": "It's your fault!"
},
{
"n": 48,
"h": "094a32d3",
"en_raw": "Die"
},
{
"n": 49,
"h": "91cd8d27",
"en_raw": "Sorry, Tomoki"
},
{
"n": 50,
"h": "9de454df",
"en_raw": "I probably"
},
{
"n": 51,
"h": "0cd8b72e",
"en_raw": "can't make it in time"
},
{
"n": 52,
"h": "e51cba52",
"en_raw": "...Even though I had such high hopes"
},
{
"n": 53,
"h": "4727bbf6",
"en_raw": "the ones begging for more time"
},
{
"n": 54,
"h": "748ea3fc",
"en_raw": "aren't only you, Sango"
},
{
"n": 55,
"h": "9fa1de7c",
"en_raw": "Well, it'll be fine"
},
{
"n": 56,
"h": "a24aa090",
"en_raw": "don't worry..."
}
]
