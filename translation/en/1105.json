"lines": [
{
"n": 0,
"h": "331a9f64",
"en_raw": "It's rare, though"
},
{
"n": 1,
"h": "7994e43c",
"en_raw": "for you to throw a punch"
},
{
"n": 2,
"h": "d79080ca",
"en_raw": "Though you got"
},
{
"n": 3,
"h": "3efd41ea",
"en_raw": "beaten up way worse"
},
{
"n": 4,
"h": "3f5ffea6",
"en_raw": "...Hey"
},
{
"n": 5,
"h": "f323bd42",
"en_raw": "that rumor about Shiina..."
},
{
"n": 6,
"h": "c208c490",
"en_raw": "Don't ask stupid questions"
},
{
"n": 7,
"h": "48925890",
"en_raw": "It's obviously a hoax"
},
{
"n": 8,
"h": "e3641deb",
"en_raw": "no need to even investigate"
},
{
"n": 9,
"h": "8ceba12d",
"en_raw": "The fact is just"
},
{
"n": 10,
"h": "4c81038d",
"en_raw": "that someone hated Shiina"
},
{
"n": 11,
"h": "b5e61ea8",
"en_raw": "I'm sick of it"
},
{
"n": 12,
"h": "34cf0292",
"en_raw": "........"
},
{
"n": 13,
"h": "8df7610c",
"en_raw": "Really, school is stupid"
},
{
"n": 14,
"h": "a977618d",
"en_raw": "in a narrow box"
},
{
"n": 15,
"h": "7d1ff20e",
"en_raw": "just because of the same age"
},
{
"n": 16,
"h": "06ba46f1",
"en_raw": "they toss people in at random"
},
{
"n": 17,
"h": "bd98bc22",
"en_raw": "force them to be aware of others"
},
{
"n": 18,
"h": "669a1944",
"en_raw": "and everyone gradually"
},
{
"n": 19,
"h": "2e28054c",
"en_raw": "becomes a nasty person..."
},
{
"n": 20,
"h": "18c9dc4d",
"en_raw": "In that sense, Shiina"
},
{
"n": 21,
"h": "a1f798a2",
"en_raw": "might be the most sensible"
},
{
"n": 22,
"h": "c2e69c78",
"en_raw": "somehow, unshakable"
},
{
"n": 23,
"h": "6099536c",
"en_raw": "she has her own self"
},
{
"n": 24,
"h": "d7bce20a",
"en_raw": "...Sango has one too"
},
{
"n": 25,
"h": "daa8a61c",
"en_raw": "Haha, right"
},
{
"n": 26,
"h": "42a6d96e",
"en_raw": "I don't waver"
},
{
"n": 27,
"h": "d2a88442",
"en_raw": "I mean"
},
{
"n": 28,
"h": "69d2e8cd",
"en_raw": "everyone around is too weak"
},
{
"n": 29,
"h": "34cf0292",
"en_raw": "........"
},
{
"n": 30,
"h": "581cf97f",
"en_raw": "More importantly, Nao"
},
{
"n": 31,
"h": "20ec5844",
"en_raw": "are your wounds okay?"
},
{
"n": 32,
"h": "34cf0292",
"en_raw": "........"
},
{
"n": 33,
"h": "c7011531",
"en_raw": "I don't know what they said"
},
{
"n": 34,
"h": "b3835af8",
"en_raw": "but middle school boys"
},
{
"n": 35,
"h": "a8f1027f",
"en_raw": "are all brats"
},
{
"n": 36,
"h": "7a176e6f",
"en_raw": "so better not to mind them much"
},
{
"n": 37,
"h": "34cf0292",
"en_raw": "........"
},
{
"n": 38,
"h": "6165890d",
"en_raw": "Nao, want to go home together?"
},
{
"n": 39,
"h": "34cf0292",
"en_raw": "........"
},
{
"n": 40,
"h": "ba8e1d97",
"en_raw": "Then I'll go ahead"
},
{
"n": 41,
"h": "70852cff",
"en_raw": "and wait at the school gate"
},
{
"n": 42,
"h": "8eb2e762",
"en_raw": "...I'll be waiting, okay?"
}
]
