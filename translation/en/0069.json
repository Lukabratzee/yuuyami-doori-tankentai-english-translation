"lines": [
{
"n": 0,
"h": "8e143c0a",
"en_raw": "Oh, it's Hirauchi!"
},
{
"n": 1,
"h": "2aa18f4e",
"en_raw": "Hey"
},
{
"n": 2,
"h": "8e143c0a",
"en_raw": "Oh, it's Hirauchi!"
},
{
"n": 3,
"h": "60f5ed86",
"en_raw": "...Who was it again?"
},
{
"n": 4,
"h": "58f47a59",
"en_raw": "Don't be like that"
},
{
"n": 5,
"h": "0945c472",
"en_raw": "to a fan!"
},
{
"n": 6,
"h": "3e7714bd",
"en_raw": "Inagaki, since when"
},
{
"n": 7,
"h": "8fe6ed75",
"en_raw": "are you my fan?"
},
{
"n": 8,
"h": "d7bd808f",
"en_raw": "I've heard"
},
{
"n": 9,
"h": "6b7dfb36",
"en_raw": "You make doujinshi, right!"
},
{
"n": 10,
"h": "36853b49",
"en_raw": "Hey, are you putting out something"
},
{
"n": 11,
"h": "2cbb031d",
"en_raw": "for the summer convention?"
},
{
"n": 12,
"h": "54bba92d",
"en_raw": "Who told you?"
},
{
"n": 13,
"h": "d9392fd4",
"en_raw": "I just happened to overhear"
},
{
"n": 14,
"h": "d093030f",
"en_raw": "rumors in the bathroom"
},
{
"n": 15,
"h": "49b3a94b",
"en_raw": "...They say Hirauchi"
},
{
"n": 16,
"h": "6b75359a",
"en_raw": "is a huge anime maniac"
},
{
"n": 17,
"h": "9fd85a19",
"en_raw": "...Damn it"
},
{
"n": 18,
"h": "375f4b74",
"en_raw": "They never spread anything decent"
},
{
"n": 19,
"h": "973e9f7c",
"en_raw": "Hey hey, how do you"
},
{
"n": 20,
"h": "c9bf4b9d",
"en_raw": "sell things at the convention?"
},
{
"n": 21,
"h": "01493ea0",
"en_raw": "Through a circle or something?"
},
{
"n": 22,
"h": "934f5c66",
"en_raw": "Listen, I'll have you know"
},
{
"n": 23,
"h": "aad58fff",
"en_raw": "what I like is pure literature"
},
{
"n": 24,
"h": "98b65162",
"en_raw": "I'm not a fan of"
},
{
"n": 25,
"h": "81fe6080",
"en_raw": "late-night anime like you"
},
{
"n": 26,
"h": "1b9fcb48",
"en_raw": "so don't get the wrong"
},
{
"n": 27,
"h": "b6d8e6dc",
"en_raw": "idea about that"
},
{
"n": 28,
"h": "611858d0",
"en_raw": "...What are you hovering around for?"
},
{
"n": 29,
"h": "a8a0f5c8",
"en_raw": "I'm glad I'm in the same class"
},
{
"n": 30,
"h": "dc2ac72b",
"en_raw": "as Hirauchi~"
},
{
"n": 31,
"h": "56ef5a40",
"en_raw": "Last year I was lonely"
},
{
"n": 32,
"h": "6e83ff85",
"en_raw": "with nobody who shared my hobbies~"
},
{
"n": 33,
"h": "9a25b414",
"en_raw": "She's not listening to a word"
},
{
"n": 34,
"h": "5b56901a",
"en_raw": "Geez, you're so cold"
}
]
}