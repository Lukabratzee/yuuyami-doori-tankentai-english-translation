"lines": [
{
"n": 0,
"h": "f31061c9",
"en_raw": "Not a single kid playing"
},
{
"n": 1,
"h": "0ddff470",
"en_raw": "It really has a bad atmosphere"
},
{
"n": 2,
"h": "22d97a90",
"en_raw": "Maybe..."
},
{
"n": 3,
"h": "5f1f36fc",
"en_raw": "As for playground equipment"
},
{
"n": 4,
"h": "db097b5e",
"en_raw": "just a slide and a sandbox"
},
{
"n": 5,
"h": "7e6d7298",
"en_raw": "A truly run-down park..."
},
{
"n": 6,
"h": "f6ff60c6",
"en_raw": "Still, what's with the triplet"
},
{
"n": 7,
"h": "eb94bdbf",
"en_raw": "ghosts, idiot"
},
{
"n": 8,
"h": "ef9dcb69",
"en_raw": "Bored / Stay  A funeral game..."
},
{
"n": 9,
"h": "4eaa2f8f",
"en_raw": "If it's literal"
},
{
"n": 10,
"h": "51b35294",
"en_raw": "it's definitely a corpse..."
},
{
"n": 11,
"h": "01c45f36",
"en_raw": "Dig / No way...  No need to deliberately"
},
{
"n": 12,
"h": "92b3731c",
"en_raw": "make myself feel bad"
},
{
"n": 13,
"h": "fdaffdd5",
"en_raw": "But what is this irresistible"
},
{
"n": 14,
"h": "33202c58",
"en_raw": "curiosity..."
},
{
"n": 15,
"h": "52fde59c",
"en_raw": "Any moment now a bird's foot"
},
{
"n": 16,
"h": "83dd352e",
"en_raw": "with rotten meat stuck on it"
},
{
"n": 17,
"h": "8725b47e",
"en_raw": "wouldn't be surprising..."
},
{
"n": 18,
"h": "8558cc2f",
"en_raw": "Dig more / Stop soon  What is this..."
},
{
"n": 19,
"h": "2940ce63",
"en_raw": "Dig more / Stop  Why something like this..."
},
{
"n": 20,
"h": "b8173a85",
"en_raw": "Dig out / Rebury  I saw nothing..."
},
{
"n": 21,
"h": "23e9272e",
"en_raw": "I did nothing..."
},
{
"n": 22,
"h": "9b86e795",
"en_raw": "A doll..."
},
{
"n": 23,
"h": "e781a094",
"en_raw": "so that's what it was"
},
{
"n": 24,
"h": "37667f6c",
"en_raw": "A funeral game..."
},
{
"n": 25,
"h": "8f976c16",
"en_raw": "Take it / Leave it  Yeah, someone will"
},
{
"n": 26,
"h": "b08c471d",
"en_raw": "throw it away anyway"
},
{
"n": 27,
"h": "657a3290",
"en_raw": "Still, though..."
},
{
"n": 28,
"h": "833125f5",
"en_raw": "What should I do..."
},
{
"n": 29,
"h": "de847aa5",
"en_raw": "Take it / Leave it  Whatever, I don't know"
},
{
"n": 30,
"h": "627ee40b",
"en_raw": "I'll toss some sand and leave it"
},
{
"n": 31,
"h": "00a43c98",
"en_raw": "Why bury a doll, idiots"
},
{
"n": 32,
"h": "724b5504",
"en_raw": "I don't get"
},
{
"n": 33,
"h": "3d068693",
"en_raw": "what kids do at all..."
}
]
