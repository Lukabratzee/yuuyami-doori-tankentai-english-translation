{
"n": 0,
"h": "91ff8292",
"en_raw": "The cat's voice, from here...?"
},
{
"n": 1,
"h": "91ff8292",
"en_raw": "The cat's voice, from here...?"
},
{
"n": 2,
"h": "2ac8f09e",
"en_raw": "Check / Ignore  Just my imagination... the worst"
},
{
"n": 3,
"h": "8925d00c",
"en_raw": "Sango..."
},
{
"n": 4,
"h": "9dbd0f0e",
"en_raw": "It's alive"
},
{
"n": 5,
"h": "5f1d1d60",
"en_raw": "...It's weak, but"
},
{
"n": 6,
"h": "dfa9eff7",
"en_raw": "It must be imagination"
},
{
"n": 7,
"h": "e147bcbc",
"en_raw": "Imagination..."
},
{
"n": 8,
"h": "00eae61b",
"en_raw": "...!!"
},
{
"n": 9,
"h": "f1662e38",
"en_raw": "What were you doing here just now?"
},
{
"n": 10,
"h": "34cf0292",
"en_raw": "........"
},
{
"n": 11,
"h": "078a0cdb",
"en_raw": "With that timid face"
},
{
"n": 12,
"h": "992dae2c",
"en_raw": "you seem to like"
},
{
"n": 13,
"h": "bfe3ffab",
"en_raw": "pretty cruel games"
},
{
"n": 14,
"h": "26a78020",
"en_raw": "...What are you saying?"
},
{
"n": 15,
"h": "853b962b",
"en_raw": "I-it's just fishing"
},
{
"n": 16,
"h": "018569e2",
"en_raw": "can't you tell?"
},
{
"n": 17,
"h": "1c287e3d",
"en_raw": "To me it looked like you were"
},
{
"n": 18,
"h": "335bf110",
"en_raw": "searching for something"
},
{
"n": 19,
"h": "f2b69135",
"en_raw": "Really"
},
{
"n": 20,
"h": "f222d283",
"en_raw": "I don't know, let me through"
},
{
"n": 21,
"h": "a05dca95",
"en_raw": "No!"
},
{
"n": 22,
"h": "c3659541",
"en_raw": "The culprit always returns to the scene"
},
{
"n": 23,
"h": "63b880e3",
"en_raw": "...they say"
},
{
"n": 24,
"h": "0b73bb01",
"en_raw": "Be honest"
},
{
"n": 25,
"h": "266db58a",
"en_raw": "The sacrifice game"
},
{
"n": 26,
"h": "3e0a0ae6",
"en_raw": "was your doing, wasn't it"
},
{
"n": 27,
"h": "fb9120e1",
"en_raw": "Wait a second, Sango"
},
{
"n": 28,
"h": "edda728a",
"en_raw": "It's not Segawa"
},
{
"n": 29,
"h": "6d996331",
"en_raw": "Nao, what do you mean?"
},
{
"n": 30,
"h": "965640b0",
"en_raw": "...You know something"
},
{
"n": 31,
"h": "f41b1913",
"en_raw": "after all, don't you?"
},
{
"n": 32,
"h": "5c14ca77",
"en_raw": "No way"
},
{
"n": 33,
"h": "0ba46306",
"en_raw": "I'm leaving now"
},
{
"n": 34,
"h": "eb113991",
"en_raw": "I haven't said anything"
},
{
"n": 35,
"h": "feab9a2a",
"en_raw": "And also"
},
{
"n": 36,
"h": "e0904c66",
"en_raw": "...I think you know"
},
{
"n": 37,
"h": "a194db57",
"en_raw": "you too, Murase"
},
{
"n": 38,
"h": "03a7305d",
"en_raw": "you'd better be careful"
},
{
"n": 39,
"h": "3764dd8c",
"en_raw": "......"
},
{
"n": 40,
"h": "0360a38c",
"en_raw": "So you went and did it after all"
},
{
"n": 41,
"h": "498ed240",
"en_raw": "A 2,000 yen job..."
},
{
"n": 42,
"h": "6f0ae95a",
"en_raw": "or rather..."
}
]
