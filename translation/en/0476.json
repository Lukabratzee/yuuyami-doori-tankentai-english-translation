},
{
"n": 57,
"h": "e73a59fe",
"en_raw": "Sit / No  W-what, please..."
},
{
"n": 58,
"h": "73f91062",
"en_raw": "No way, another time"
},
{
"n": 59,
"h": "ecad6dd2",
"en_raw": "I see, I'll wait, I'll wait"
},
{
"n": 60,
"h": "5dc5aa3c",
"en_raw": "until you"
},
{
"n": 61,
"h": "29c89601",
"en_raw": "feel like it"
},
{
"n": 62,
"h": "8fd2561e",
"en_raw": "Aww, how boring"
},
{
"n": 63,
"h": "4612a2de",
"en_raw": "Don't move!"
},
{
"n": 64,
"h": "05764945",
"en_raw": "Hey hey, is it done?"
},
{
"n": 65,
"h": "3f5a9e27",
"en_raw": "Hey hey, Kurumi"
},
{
"n": 66,
"h": "0507eb30",
"en_raw": "has been so patient, you know?"
},
{
"n": 67,
"h": "7537ba20",
"en_raw": "S-sorry..."
},
{
"n": 68,
"h": "dfd2edf0",
"en_raw": "Only the finishing touches remain, but..."
},
{
"n": 69,
"h": "ec0b7b9c",
"en_raw": "What!? Not yet?"
},
{
"n": 70,
"h": "cd6f97ec",
"en_raw": "B-but really, just a little more..."
},
{
"n": 71,
"h": "70849b9a",
"en_raw": "Sorry, but tomorrow"
},
{
"n": 72,
"h": "1aa1f5bb",
"en_raw": "come once more"
},
{
"n": 73,
"h": "10021ca9",
"en_raw": "Kurumi doesn't need it anymore"
},
{
"n": 74,
"h": "27db87c0",
"en_raw": "Don't say that..."
},
{
"n": 75,
"h": "55aac395",
"en_raw": "Tomorrow for sure..."
},
{
"n": 76,
"h": "00056928",
"en_raw": "When this picture is finished"
},
{
"n": 77,
"h": "cd142cfb",
"en_raw": "then..."
},
{
"n": 78,
"h": "cd142cfb",
"en_raw": "then..."
},
{
"n": 79,
"h": "db165e59",
"en_raw": "Then what happens?"
},
{
"n": 80,
"h": "96407729",
"en_raw": "I'll break my brush..."
},
{
"n": 81,
"h": "ef062570",
"en_raw": "Hmm, you do weird things"
},
{
"n": 82,
"h": "e8fa9ebe",
"en_raw": "...I was waiting"
},
{
"n": 83,
"h": "4dccd4b9",
"en_raw": "Let's begin right away"
},
{
"n": 84,
"h": "3970cec7",
"en_raw": "Kurumi is tired"
},
{
"n": 85,
"h": "25504099",
"en_raw": "of sitting over there"
},
{
"n": 86,
"h": "3764dd8c",
"en_raw": "......"
},
{
"n": 87,
"h": "3f301a24",
"en_raw": "Anyway, please sit"
},
{
"n": 88,
"h": "4e24ff6a",
"en_raw": "No / Fine  Kurumi is bored already"
},
{
"n": 89,
"h": "d506ed22",
"en_raw": "I fully understand the pain"
},
{
"n": 90,
"h": "87fcd7ba",
"en_raw": "but I can't leave"
},
{
"n": 91,
"h": "f2eab4db",
"en_raw": "the picture unfinished, can I..."
},
{
"n": 92,
"h": "da2f393c",
"en_raw": "I don't know that"
},
{
"n": 93,
"h": "fd67dc21",
"en_raw": "Please tell her too"
},
{
"n": 94,
"h": "b70a1dfc",
"en_raw": "This is art"
},
{
"n": 95,
"h": "2c608c1e",
"en_raw": "It's the most sublime mental activity"
},
{
"n": 96,
"h": "bb0c0839",
"en_raw": "I'm not asking you to understand it all"
},
{
"n": 97,
"h": "f99345f1",
"en_raw": "R-right..."
},
{
"n": 98,
"h": "d09ae423",
"en_raw": "It's impossible"
},
{
"n": 99,
"h": "4881d6d0",
"en_raw": "What lies at the end of my path"
},
{
"n": 100,
"h": "28e041fc",
"en_raw": "rejects ordinary understanding"
},
{
"n": 101,
"h": "b63b5049",
"en_raw": "and all objectivity"
},
{
"n": 102,
"h": "b3ce8c57",
"en_raw": "a place even light doesn't reach"
},
{
"n": 103,
"h": "7ce3d749",
"en_raw": "the truth of a deep inner world"
},
{
"n": 104,
"h": "bd88bf12",
"en_raw": "a fragment of that truth..."
},
{
"n": 105,
"h": "fc9757ad",
"en_raw": "Kurumi doesn't know that"
},
{
"n": 106,
"h": "1dd6f712",
"en_raw": "Please, somehow..."
},
{
"n": 107,
"h": "59068a58",
"en_raw": "No / Fine  Hmph..."
},
{
"n": 108,
"h": "1ba9ecfb",
"en_raw": "Aww, Kurumi"
},
{
"n": 109,
"h": "7ff4ffb0",
"en_raw": "It's a big failure"
},
{
"n": 110,
"h": "e58b640d",
"en_raw": "No, a great success..."
},
{
"n": 111,
"h": "568caaa9",
"en_raw": "It'll be a masterpiece..."
},
{
"n": 112,
"h": "32b3c1fd",
"en_raw": "Water flea, water flea..."
},
{
"n": 113,
"h": "4612a2de",
"en_raw": "Don't move!"
},
{
"n": 114,
"h": "51d4617c",
"en_raw": "Kurumi got tired"
},
{
"n": 115,
"h": "05764945",
"en_raw": "Hey hey, is it done?"
},
{
"n": 116,
"h": "3764dd8c",
"en_raw": "......"
},
{
"n": 117,
"h": "676932ef",
"en_raw": "Hey hey, hey hey?"
},
{
"n": 118,
"h": "5093d769",
"en_raw": "This picture..."
},
{
"n": 119,
"h": "241dbb50",
"en_raw": "Show me quick~"
},
{
"n": 120,
"h": "42d35adf",
"en_raw": "This picture goes to no one"
},
{
"n": 121,
"h": "1fb0b92d",
"en_raw": "Huh, you won't give it?"
},
{
"n": 122,
"h": "c95db8d1",
"en_raw": "Not fair, Kurumi"
},
{
"n": 123,
"h": "911b8720",
"en_raw": "paid properly"
},
{
"n": 124,
"h": "6f19a725",
"en_raw": "Then take this home"
},
{
"n": 125,
"h": "43ae5d63",
"en_raw": "...Is this Kurumi?"
},
{
"n": 126,
"h": "6d506e7a",
"en_raw": "It looks a bit like a kitty"
},
{
"n": 127,
"h": "a496022e",
"en_raw": "Thanks~"
},
{
"n": 128,
"h": "addd8296",
"en_raw": "Kurumi will treasure this"
},
{
"n": 129,
"h": "d005aa49",
"en_raw": "Now go"
}
]
