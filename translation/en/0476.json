"lines": [
{
"n": 0,
"h": "9be71e64",
"en_raw": "What's that weird picture? What picture?"
},
{
"n": 1,
"h": "629e34fa",
"en_raw": "........."
},
{
"n": 2,
"h": "87601526",
"en_raw": "Hey hey, weird picture"
},
{
"n": 3,
"h": "a6a2362d",
"en_raw": "draw one for Kurumi too"
},
{
"n": 4,
"h": "832df3a7",
