},
{
"n": 9,
"h": "87601526",
"en_raw": "Hey hey, weird picture"
},
{
"n": 10,
"h": "a6a2362d",
"en_raw": "draw one for Kurumi too"
},
{
"n": 11,
"h": "f010fc34",
"en_raw": "...Does it look strange?"
},
{
"n": 12,
"h": "ce57b8c3",
"en_raw": "It's a weird picture"
},
{
"n": 13,
"h": "b6330ccf",
"en_raw": "But it certainly"
},
{
"n": 14,
"h": "642e0bd4",
"en_raw": "might be a weird picture"
},
{
"n": 15,
"h": "66e443ec",
"en_raw": "Kurumi's is better"
},
{
"n": 16,
"h": "67f15e9d",
