},
{
"n": 19,
"h": "38766600",
"en_raw": "It's 500 yen a piece, is that okay?"
},
{
"n": 20,
"h": "23a01404",
"en_raw": "Sorry it's a weird picture..."
},
{
"n": 21,
"h": "bdf5a2d7",
"en_raw": "Pay / Never mind  Today, after all,"
},
{
"n": 22,
"h": "0ee3c233",
"en_raw": "I'll buy ice cream"
},
{
"n": 23,
"h": "65c6c971",
"en_raw": "I see, too bad..."
},
{
"n": 24,
"h": "3bdf59df",
"en_raw": "Nao, from now on, let's drill"
},
{
"n": 25,
"h": "f6f1dbdb",
"en_raw": "more manners into Shiina"
},
{
"n": 26,
"h": "80aa6206",
