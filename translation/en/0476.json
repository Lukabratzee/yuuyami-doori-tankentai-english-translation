},
{
"n": 35,
"h": "7537ba20",
"en_raw": "S-sorry..."
},
{
"n": 36,
"h": "f51ae8fa",
"en_raw": "This is a first for me..."
},
{
"n": 37,
"h": "db8b3b95",
"en_raw": "A-actually, it's going to take"
},
{
"n": 38,
"h": "f2c66d92",
