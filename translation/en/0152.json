"lines": [
{
"n": 0,
"h": "fd77e047",
"en_raw": "Burning, wobbling"
},
{
"n": 1,
"h": "3bea4376",
"en_raw": "as it moves"
},
{
"n": 2,
"h": "0a4b475a",
"en_raw": "What are you talking about?"
},
{
"n": 3,
"h": "14486a4c",
"en_raw": "Yesterday's chase special"
},
{
"n": 4,
"h": "5e1b873e",
"en_raw": "didn't you watch it?"
},
{
"n": 5,
"h": "2e4e278d",
"en_raw": "The will-o'-the-wisp one, I watched it"
},
{
"n": 6,
"h": "4835cea6",
"en_raw": "You don't know, Shige?"
},
{
"n": 7,
"h": "6a5d80a2",
"en_raw": "This town has them too"
},
{
"n": 8,
"h": "dc074124",
"en_raw": "Places where you can see wisps..."
},
{
"n": 9,
"h": "32dcb36a",
"en_raw": "You're easily influenced"
},
{
"n": 10,
"h": "31e82a46",
"en_raw": "Idiot, it's true"
},
{
"n": 11,
"h": "e988c4f4",
"en_raw": "And not graveyards"
},
{
"n": 12,
"h": "0d36b402",
"en_raw": "but surprising places"
},
{
"n": 13,
"h": "6c89ddc7",
"en_raw": "Where?"
},
{
"n": 14,
"h": "296e1094",
"en_raw": "...The Wildflower Garden, surprising, right?"
},
{
"n": 15,
"h": "be7cdfb0",
"en_raw": "But that was definitely"
},
{
"n": 16,
"h": "6a8c2c49",
"en_raw": "a wisp"
},
{
"n": 17,
"h": "ff58dbb8",
"en_raw": "More importantly, Yuasa, you"
},
{
"n": 18,
"h": "988554a3",
"en_raw": "were called by Kamei, right?"
},
{
"n": 19,
"h": "72db47c1",
"en_raw": "Did you go?"
},
{
"n": 20,
"h": "842f10ab",
"en_raw": "Hey Shige, let's go see"
},
{
"n": 21,
"h": "43cb4c79",
"en_raw": "Wisps?"
},
{
"n": 22,
"h": "a32ca9d5",
"en_raw": "No way those show up"
},
{
"n": 23,
"h": "837f754b",
"en_raw": "Hey, about what you just said..."
},
{
"n": 24,
"h": "62e08b2c",
"en_raw": "It's got nothing to do with you"
},
{
"n": 25,
"h": "837f754b",
"en_raw": "Hey, about what you just said..."
},
{
"n": 26,
"h": "fe1e0cf5",
"en_raw": "Hey, about what you said earlier..."
},
{
"n": 27,
"h": "176633e7",
