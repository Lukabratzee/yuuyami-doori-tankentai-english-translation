"lines": [
{
"n": 0,
"h": "b8316d4c",
"en_raw": "The rumor of someone dying"
},
{
"n": 1,
"h": "bf716d2a",
"en_raw": "Shiina collapsing"
},
{
"n": 2,
"h": "48bb7c02",
"en_raw": "Day 100..."
},
{
"n": 3,
"h": "a65031f6",
"en_raw": "Curse, curse"
},
{
"n": 4,
"h": "92c1f5b9",
"en_raw": "...Is it all the curse's fault?"
},
{
"n": 5,
"h": "7eb860ca",
"en_raw": "If so, what am I supposed"
},
{
"n": 6,
"h": "0da00d80",
"en_raw": "to do with such a thing?"
},
{
"n": 7,
"h": "a3b07d6b",
"en_raw": "Or is it already too late?"
},
{
"n": 8,
"h": "b8c6fae5",
"en_raw": "No!"
},
{
"n": 9,
"h": "d6cdad1b",
"en_raw": "Shiina can't disappear!"
},
{
"n": 10,
"h": "a2ab082b",
"en_raw": "...What would Sango do?"
},
{
"n": 11,
"h": "5dd87743",
"en_raw": "...What would Shiina do?"
},
{
"n": 12,
"h": "d555bbb5",
"en_raw": "That's it... Kasuka"
},
{
"n": 13,
"h": "19aa3057",
"en_raw": "...that girl"
},
{
"n": 14,
"h": "3e22078c",
"en_raw": "That girl"
},
{
"n": 15,
"h": "ce54bee1",
"en_raw": "would surely know about Shiina..."
},
{
"n": 16,
"h": "2ad8ebde",
"en_raw": "...I have to run!"
},
{
"n": 17,
"h": "cbd0850d",
"en_raw": "(That's right, a girl..."
},
{
"n": 18,
"h": "c31ab91a",
"en_raw": "Shiina called her Kasuka)"
},
{
"n": 19,
"h": "992f7de5",
"en_raw": "(If I meet her,"
},
{
"n": 20,
"h": "1ea75ea6",
"en_raw": "I might find out)"
},
{
"n": 21,
"h": "9d53b386",
"en_raw": "(Where was that again?"
},
{
"n": 22,
"h": "94a16a7b",
"en_raw": "Somewhere by the river...)"
},
{
"n": 23,
"h": "dc9d3449",
"en_raw": "(Around Old Town Street...?)"
},
{
"n": 24,
"h": "ebc8e5af",
"en_raw": "(No use thinking"
},
{
"n": 25,
"h": "eeb24a37",
"en_raw": "Let's just go)"
},
{
"n": 26,
"h": "3bfd0b59",
"en_raw": "I can't wait, I can't wait anymore"
},
{
"n": 27,
"h": "db336c70",
"en_raw": "...Huh?"
},
{
"n": 28,
"h": "f83568fc",
"en_raw": "Night is coming..."
},
{
"n": 29,
"h": "1dba3c93",
"en_raw": "The round, red moon..."
},
{
"n": 30,
"h": "3e4bf512",
"en_raw": "Wait... wait for me!"
}
]
}