"lines": [
{
"n": 0,
"h": "357e7eaa",
"en_raw": "Excuse me, um"
},
{
"n": 1,
"h": "d9441d4f",
"en_raw": "I'd like to ask"
},
{
"n": 2,
"h": "6f4d76f8",
"en_raw": "What's wrong?"
},
{
"n": 3,
"h": "ce0309ac",
"en_raw": "there's a staircase"
},
{
"n": 4,
"h": "547d3598",
"en_raw": "from the station to the hilltop, right?"
},
{
"n": 5,
"h": "7bdead26",
"en_raw": "There is"
},
{
"n": 6,
"h": "39a667c7",
"en_raw": "That was when I was in elementary school"
},
{
"n": 7,
"h": "c4e9b9d6",
"en_raw": "so three or four years ago..."
},
{
"n": 8,
"h": "d9acf91f",
"en_raw": "what happened then?"
},
{
"n": 9,
"h": "fa6dbd2d",
"en_raw": "do you know?"
},
{
"n": 10,
"h": "f115d178",
"en_raw": "What do you mean?"
},
{
"n": 11,
"h": "d0675bd3",
"en_raw": "I mean, normally speaking"
},
{
"n": 12,
"h": "3b1285d4",
"en_raw": "a murder or something"
},
{
"n": 13,
"h": "d22f2830",
"en_raw": "...If a murder were normal"
},
{
"n": 14,
"h": "7962bd46",
"en_raw": "we'd be in trouble"
},
{
"n": 15,
"h": "f30b3eb4",
"en_raw": "Anyway, never mind"
},
{
"n": 16,
"h": "efd48f03",
"en_raw": "what I want to ask is"
},
{
"n": 17,
"h": "f98620aa",
"en_raw": "Sorry, about before"
},
{
"n": 18,
"h": "a9a65274",
"en_raw": "What I want to know"
},
{
"n": 19,
"h": "6e2ee38b",
"en_raw": "why I took a detour"
},
{
"n": 20,
"h": "26b55d12",
"en_raw": "to elementary school back then"
},
{
"n": 21,
"h": "0f262cbd",
"en_raw": "Even if you ask what happened"
},
{
"n": 22,
"h": "d7686361",
"en_raw": "well..."
},
{
"n": 23,
"h": "6346c59c",
"en_raw": "You won't do"
},
{
"n": 24,
"h": "18428e52",
"en_raw": "someone more professional..."
},
{
"n": 25,
"h": "e5fd6a0e",
"en_raw": "That's it!"
},
{
"n": 26,
"h": "0a73b6f8",
"en_raw": "What about the man who always stands there?"
},
{
"n": 27,
"h": "5dc7d0de",
"en_raw": "Too bad"
},
{
"n": 28,
"h": "df476c6a",
"en_raw": "He's off today for a checkup"
},
{
"n": 29,
"h": "f5c98251",
"en_raw": "He's taking the day off"
},
{
"n": 30,
"h": "e2f8c960",
"en_raw": "He's no help anymore"
},
{
"n": 31,
"h": "5bac92d6",
"en_raw": "Sorry, but with that question"
},
{
"n": 32,
"h": "7b2a29ce",
"en_raw": "expecting us to know is unreasonable"
},
{
"n": 33,
"h": "27ef7784",
"en_raw": "Hey, did you really know nothing"
},
{
"n": 34,
"h": "824e358f",
"en_raw": "You don't know?"
},
{
"n": 35,
"h": "d0a6a69d",
"en_raw": "or just not telling?"
},
{
"n": 36,
"h": "a1c89f4f",
"en_raw": "I swear"
},
{
"n": 37,
"h": "264228db",
"en_raw": "I don't know at all"
},
{
"n": 38,
"h": "1a13b2d9",
"en_raw": "Even if I did"
},
{
"n": 39,
"h": "01d9e243",
"en_raw": "I couldn't tell you"
},
{
"n": 40,
"h": "e529474a",
"en_raw": "many details"
},
{
"n": 41,
"h": "9908c402",
"en_raw": "Forgot?"
},
{
"n": 42,
"h": "b2e3685c",
"en_raw": "Come again if you remember"
},
{
"n": 43,
"h": "3fa507ae",
"en_raw": "Never mind"
},
{
"n": 44,
"h": "6ca42df2",
"en_raw": "Thanks anyway"
},
{
"n": 45,
"h": "02fc22c3",
"en_raw": "Hey, got a minute?"
},
{
"n": 46,
"h": "89463aec",
"en_raw": "Sure, but I don't know"
},
{
"n": 47,
"h": "b720329f",
"en_raw": "But I got information"
},
{
"n": 48,
"h": "c915629c",
"en_raw": "by my own route"
},
{
"n": 49,
"h": "83533765",
"en_raw": "that there was a fall accident"
},
{
"n": 50,
"h": "5b9f9401",
"en_raw": "on that staircase"
},
{
"n": 51,
"h": "84ca459e",
"en_raw": "I could check the file"
},
{
"n": 52,
"h": "945e2b37",
"en_raw": "for an overview"
},
{
"n": 53,
"h": "e8508b96",
"en_raw": "but what do you want to know?"
},
{
"n": 54,
"h": "1a4773a0",
"en_raw": "Firsthand testimony"
},
{
"n": 55,
"h": "622f0eb6",
"en_raw": "Sorry, but I was only"
},
{
"n": 56,
"h": "a4abb1f3",
"en_raw": "assigned here last year"
},
{
"n": 57,
"h": "2dfc9981",
"en_raw": "Ah, honestly"
},
{
"n": 58,
"h": "d11a21c1",
"en_raw": "you know nothing"
},
{
"n": 59,
"h": "a56f9115",
"en_raw": "Ask the neighbors"
},
{
"n": 60,
"h": "8dc27718",
"en_raw": "for that kind of thing"
},
{
"n": 61,
"h": "b2102783",
"en_raw": "The police aren't idle, you know"
},
{
"n": 62,
"h": "02fc22c3",
"en_raw": "Hey, got a minute?"
},
{
"n": 63,
"h": "45dd24ea",
"en_raw": "Even if we look idle"
},
{
"n": 64,
"h": "a2babec8",
"en_raw": "we're not playing around"
},
{
"n": 65,
"h": "2461f719",
"en_raw": "For canvassing"
},
{
"n": 66,
"h": "c9305886",
"en_raw": "ask people near the scene"
},
{
"n": 67,
"h": "c498c94c",
"en_raw": "Don't get it?"
},
{
"n": 68,
"h": "68f4bef0",
"en_raw": "Then nothing can be done"
},
{
"n": 69,
"h": "3fa507ae",
"en_raw": "Never mind"
},
{
"n": 70,
"h": "6ca42df2",
"en_raw": "Thanks anyway"
}
]
