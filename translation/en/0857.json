{
"file": 857,
"paths": [
"d008/d081/f018"
],
"lines": [
{
"n": 0,
"h": "5f423a5e",
"en_raw": "Um, are you okay?"
},
{
"n": 1,
"h": "6ff79c7f",
"en_raw": "U-ugh..."
},
{
"n": 2,
"h": "edfe6556",
"en_raw": "The R-Reaper..."
},
{
"n": 3,
"h": "f6ad9367",
"en_raw": "I see the Reaper..."
},
{
"n": 4,
"h": "3025770b",
"en_raw": "...Reaper?"
},
{
"n": 5,
"h": "d8add6ca",
"en_raw": "One day I woke up"
},
{
"n": 6,
"h": "18e3ff07",
"en_raw": "and this thing had been made"
},
{
"n": 7,
"h": "93199a9c",
"en_raw": "Everyone living here is afflicted"
},
{
"n": 8,
"h": "f6b1e8b8",
"en_raw": "by this weapon"
},
{
"n": 9,
"h": "8b479e62",
"en_raw": "The government learned how"
},
{
"n": 10,
"h": "45d41c21",
"en_raw": "dangerous we are"
},
{
"n": 11,
"h": "e5b6617a",
"en_raw": "and struck first"
},
{
"n": 12,
"h": "6979203c",
"en_raw": "in the most inhumane way"
},
{
"n": 13,
"h": "18be80e0",
"en_raw": "...It's just a substation"
},
{
"n": 14,
"h": "28c756d7",
"en_raw": "No..."
},
{
"n": 15,
"h": "924e35e8",
"en_raw": "The super-EM waves from this weapon"
},
{
"n": 16,
"h": "4a76188d",
"en_raw": "melt the brain, rot the lungs,"
},
{
"n": 17,
"h": "ad272ed9",
"en_raw": "and lead to death in agony"
},
{
"n": 18,
"h": "e6d193cc",
"en_raw": "But we won't yield"
},
{
"n": 19,
"h": "1ff0f557",
"en_raw": "to such a thing..."
},
{
"n": 20,
"h": "f317f49e",
"en_raw": "You understand, right?"
},
{
"n": 21,
"h": "ed73985f",
"en_raw": "(Let's escape while I can)"
},
{
"n": 22,
"h": "8ceba444",
"en_raw": "Thank you"
},
{
"n": 23,
"h": "e6cb1447",
"en_raw": "You do seem to be a comrade"
},
{
"n": 24,
"h": "ca011562",
"en_raw": "...You can't escape"
},
{
"n": 25,
"h": "c30b8541",
"en_raw": "from here anymore"
},
{
"n": 26,
"h": "27cab7d9",
"en_raw": "(...Something's definitely off"
},
{
"n": 27,
"h": "eeb57cec",
"en_raw": "with this guy...)"
},
{
"n": 28,
"h": "1e8f9f98",
"en_raw": "Um, excuse me, I'm leaving!"
},
{
"n": 29,
"h": "15fcc0f3",
"en_raw": "Listen!"
},
{
"n": 30,
"h": "b5a3bda0",
"en_raw": "You have a duty!"
},
{
"n": 31,
"h": "bcf169fa",
"en_raw": "W-wait..."
}
]
}