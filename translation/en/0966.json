"lines": [
{
"n": 0,
"h": "15053f01",
"en_raw": "Ah, there he is!"
},
{
"n": 1,
"h": "67ff2304",
"en_raw": "Ah, it's you kids"
},
{
"n": 2,
"h": "e5dfc259",
"en_raw": "We meet again"
},
{
"n": 3,
"h": "2de85ebf",
"en_raw": "What do you want this time?"
},
{
"n": 4,
"h": "4efb1ad2",
"en_raw": "Huh?"
},
{
"n": 5,
"h": "273e02bc",
"en_raw": "Did you still need something?"
},
{
"n": 6,
"h": "4b426675",
"en_raw": "Um..."
},
{
"n": 7,
"h": "851bed60",
"en_raw": "You may be"
},
{
"n": 8,
"h": "6e085da1",
"en_raw": "very surprised, but..."
},
{
"n": 9,
"h": "6f4d76f8",
"en_raw": "What's wrong?"
},
{
"n": 10,
"h": "5e4a2f80",
"en_raw": "Actually..."
},
{
"n": 11,
"h": "a1407eb2",
"en_raw": "What, are you hiding something?"
},
{
"n": 12,
"h": "53beb0f4",
"en_raw": "Sorry!"
},
{
"n": 13,
"h": "e45d8af1",
"en_raw": "The person living in Room 204"
},
{
"n": 14,
"h": "39ef4fd9",
"en_raw": "is my brother..."
},
{
"n": 15,
"h": "f1dba02f",
"en_raw": "Mitsugu!"
},
{
"n": 16,
"h": "7bb7ded5",
"en_raw": "He's been missing all this time..."
},
{
"n": 17,
"h": "c03a63da",
"en_raw": "Um..."
},
{
"n": 18,
"h": "0bc50f26",
"en_raw": "Is there any way"
},
{
"n": 19,
"h": "11e88b93",
"en_raw": "I could get into the next room?"
},
{
"n": 20,
"h": "41814901",
"en_raw": "Like passing a pole"
},
{
"n": 21,
"h": "939f39a2",
"en_raw": "and crossing over the balcony..."
},
{
"n": 22,
"h": "eed8f468",
"en_raw": "It's not impossible, but..."
},
{
"n": 23,
"h": "0e746872",
"en_raw": "Please!"
},
{
"n": 24,
"h": "05042b1b",
"en_raw": "My mother"
},
{
"n": 25,
"h": "90e2bd4d",
"en_raw": "cries all day"
},
{
"n": 26,
"h": "b350fbb6",
"en_raw": "I can't bear to watch anymore..."
},
{
"n": 27,
"h": "7a53c442",
"en_raw": "Well, if there's anything"
},
{
"n": 28,
"h": "97adeaee",
"en_raw": "I can do to help..."
},
{
"n": 29,
"h": "33fceb14",
"en_raw": "Really?!"
},
{
"n": 30,
"h": "445ceef8",
"en_raw": "Thank you so much!"
},
{
"n": 31,
"h": "d93db9cf",
"en_raw": "Sorry for the trouble"
}
]
