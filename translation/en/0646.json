"lines": [
{
"n": 0,
"h": "3bd420ce",
"en_raw": "A sanatorium..."
},
{
"n": 1,
"h": "08a258a9",
"en_raw": "If I go here"
},
{
"n": 2,
"h": "0e1ad05d",
"en_raw": "they'll surely make me feel better..."
},
{
"n": 3,
"h": "644be5bf",
"en_raw": "And I'll surely"
},
{
"n": 4,
"h": "3b26dd42",
"en_raw": "never be let out of here"
},
{
"n": 5,
"h": "8ff454b1",
"en_raw": "Sorry, I apologize, I regret it,"
},
{
"n": 6,
"h": "cc8cd8b6",
"en_raw": "my bad, I'm so sorry,"
},
{
"n": 7,
"h": "0355460c",
"en_raw": "I'm very sorry..."
},
{
"n": 8,
"h": "e6bfb9b8",
"en_raw": "Shiina"
},
{
"n": 9,
"h": "34174ecc",
"en_raw": "You're telling me to apologize too!"
},
{
"n": 10,
"h": "bde0db71",
"en_raw": "...Sorry, little bug"
},
{
"n": 11,
"h": "b3e3bda3",
"en_raw": "Um, excuse me"
},
{
"n": 12,
"h": "b135a669",
"en_raw": "could you tell me the way?"
},
{
"n": 13,
"h": "32c247f0",
"en_raw": "To a temple"
},
{
"n": 14,
"h": "564dc02a",
"en_raw": "called Horokuji"
},
{
"n": 15,
"h": "55bdd8da",
"en_raw": "This area has changed"
},
{
"n": 16,
"h": "9ad96ac3",
"en_raw": "completely..."
},
{
"n": 17,
"h": "c300e3ce",
"en_raw": "Only the many slopes"
},
{
"n": 18,
"h": "95008635",
"en_raw": "haven't changed at all"
},
{
"n": 19,
"h": "03d35c89",
"en_raw": "Show the way / I'm in a hurry now  Oh, you kids..."
},
{
"n": 20,
"h": "df72d7f3",
"en_raw": "Sorry to ask"
},
{
"n": 21,
"h": "40ea1529",
"en_raw": "the temple called Horokuji"
},
{
"n": 22,
"h": "1154dff8",
"en_raw": "could you tell me?"
},
{
"n": 23,
"h": "b3ae8dc0",
"en_raw": "I couldn't find it yesterday, after all..."
},
{
"n": 24,
"h": "03d35c89",
"en_raw": "Show the way / I'm in a hurry now  Oh, you kids..."
},
{
"n": 25,
"h": "11df2372",
"en_raw": "Thank you for the other day"
},
{
"n": 26,
"h": "4ca10655",
"en_raw": "Granny"
},
{
"n": 27,
"h": "874fb994",
"en_raw": "I got lost again"
},
{
"n": 28,
"h": "13f705ac",
"en_raw": "Could you take me"
},
{
"n": 29,
"h": "9aef374e",
"en_raw": "there once more?"
},
{
"n": 30,
"h": "6eb96b7b",
"en_raw": "Show the way / I'm in a hurry now  Ah... um"
},
{
"n": 31,
"h": "9b2aaeb3",
"en_raw": "Shall we go together?"
},
{
"n": 32,
"h": "e2031ca9",
"en_raw": "Really?"
},
{
"n": 33,
"h": "403a1afb",
"en_raw": "Thank you so much..."
},
{
"n": 34,
"h": "02df979b",
"en_raw": "Sorry"
},
{
"n": 35,
"h": "b34b41d0",
"en_raw": "I'm in a hurry now, so..."
},
{
"n": 36,
"h": "858522f0",
"en_raw": "Oh, I see"
},
{
"n": 37,
"h": "1efb3f74",
"en_raw": "I'm sorry"
},
{
"n": 38,
"h": "8766f4d7",
"en_raw": "This area too"
},
{
"n": 39,
"h": "8c47c286",
"en_raw": "keeps changing"
},
{
"n": 40,
"h": "ded6e01b",
"en_raw": "Nothing remains"
},
{
"n": 41,
"h": "8c414950",
"en_raw": "of how it looked when I was young"
}
]
}