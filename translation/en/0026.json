"lines": [
{
"n": 0,
"h": "69c9424d",
"en_raw": "Minami-chan, you see, at school"
},
{
"n": 1,
"h": "3e402a45",
"en_raw": "...Oh, that's a secret"
},
{
"n": 2,
"h": "b489e8fe",
"en_raw": "Shiina, hey"
},
{
"n": 3,
"h": "5ed7a288",
"en_raw": "what's your relationship"
},
{
"n": 4,
"h": "8c921c1c",
"en_raw": "with that Minami Aiba girl?"
},
{
"n": 5,
"h": "c7de5f3e",
"en_raw": "Friends!"
},
{
"n": 6,
"h": "d5045005",
"en_raw": "But she has"
},
{
"n": 7,
"h": "7e2db227",
"en_raw": "all kinds of rumors, you know"
},
{
"n": 8,
"h": "2a5b607c",
"en_raw": "Shiina"
},
{
"n": 9,
"h": "90ec204b",
"en_raw": "is it okay to go alone?"
},
{
"n": 10,
"h": "17df1d0a",
"en_raw": "Huh, so you're curious"
},
{
"n": 11,
"h": "3b6c4ad9",
"en_raw": "about their relationship"
},
{
"n": 12,
"h": "33fbc4f7",
"en_raw": "Mr. N.M."
},
{
"n": 13,
"h": "be72af3c",
"en_raw": "It's a friend's secret, so"
},
{
"n": 14,
"h": "45de4bfb",
"en_raw": "Kurumi will go see her herself"
},
{
"n": 15,
"h": "3e2bdd34",
"en_raw": "Kurumi has to go to school"
},
{
"n": 16,
"h": "61cd2960",
"en_raw": "I promised Minami-chan"
},
{
"n": 17,
"h": "c9640bd4",
"en_raw": "...It's a secret, but"
},
{
"n": 18,
"h": "156496bd",
"en_raw": "there really was a fox spirit"
},
{
"n": 19,
"h": "1dc5c0f6",
"en_raw": "But Minami-chan said"
},
{
"n": 20,
"h": "e522c204",
"en_raw": "it was all a lie"
},
{
"n": 21,
"h": "2a5b607c",
"en_raw": "Shiina"
},
{
"n": 22,
"h": "8f0b58a2",
"en_raw": "What's a fox possession?"
},
{
"n": 23,
"h": "5388fcb1",
"en_raw": "Um, you see"
},
{
"n": 24,
"h": "4faeb03f",
"en_raw": "It's a secret, but there really was one"
},
{
"n": 25,
"h": "2d3bb104",
"en_raw": "But Minami-chan"
},
{
"n": 26,
"h": "71e6ad31",
"en_raw": "cried"
},
{
"n": 27,
"h": "11b0e892",
"en_raw": "What did you do"
},
{
"n": 28,
"h": "ccd4b434",
"en_raw": "to Minami Aiba?"
},
{
"n": 29,
"h": "4633cd60",
"en_raw": "It's not Shiina's fault"
},
{
"n": 30,
"h": "285b6f88",
"en_raw": "She's just that kind of girl"
},
{
"n": 31,
"h": "939a50c0",
"en_raw": "Yeah... but Minami-chan"
},
{
"n": 32,
"h": "d1573f0b",
"en_raw": "says Kurumi will go"
},
{
"n": 33,
"h": "b6987e73",
"en_raw": "somewhere she doesn't know"
},
{
"n": 34,
"h": "45407a26",
"en_raw": "That's not true, though..."
},
{
"n": 35,
"h": "5d349518",
"en_raw": "...That's kind of worrying"
},
{
"n": 36,
"h": "1c6f0562",
"en_raw": "What could it mean?"
},
{
"n": 37,
"h": "e244d93e",
"en_raw": "Don't sweat the small stuff!"
},
{
"n": 38,
"h": "cc819e88",
"en_raw": "Well... Minami Aiba"
},
{
"n": 39,
"h": "6ff4a029",
"en_raw": "has stopped coming to school again"
},
{
"n": 40,
"h": "2328127a",
"en_raw": "Not that it matters..."
},
{
"n": 41,
"h": "a7e0e1e3",
"en_raw": "Solved the rumor of the Fox Spirit"
},
{
"n": 42,
"h": "b48e17e8",
"en_raw": "Minami-chan..."
},
{
"n": 43,
"h": "de14dda9",
"en_raw": "Shiina is"
},
{
"n": 44,
"h": "87727a4c",
"en_raw": "so thoughtful of her friends"
},
{
"n": 45,
"h": "79cc23fa",
"en_raw": "With her rival gone"
},
{
"n": 46,
"h": "00ea4d1b",
"en_raw": "you must be relieved, Nao"
},
{
"n": 47,
"h": "5837ebfd",
"en_raw": "Why does Sango always"
},
{
"n": 48,
"h": "82ba933a",
"en_raw": "take it that way?"
},
{
"n": 49,
"h": "01e8b245",
"en_raw": "I'm just"
},
{
"n": 50,
"h": "af968a16",
"en_raw": "stating facts from an"
},
{
"n": 51,
"h": "f2f93ee8",
"en_raw": "objective point of view"
},
{
"n": 52,
"h": "d6c586a2",
"en_raw": "...Got a problem with that?"
},
{
"n": 53,
"h": "14f5784c",
"en_raw": "Enough, drop it"
},
{
"n": 54,
"h": "da16b673",
"en_raw": "Let's talk about something else already!"
}
]
