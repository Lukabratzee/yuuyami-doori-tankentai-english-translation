},
{
"n": 187,
"h": "41613bfc",
"en_raw": "wouldn't be that overgrown"
},
{
"n": 188,
"h": "52d6d13d",
"en_raw": "...It was in terrible shape"
},
{
"n": 189,
"h": "7ee758d5",
"en_raw": "Yamamoto's grave, huh..."
},
{
"n": 190,
"h": "18a54780",
"en_raw": "I'm totally"
},
{
"n": 191,
"h": "b0f3449b",
"en_raw": "confused now"
},
{
"n": 192,
"h": "a4802d2c",
"en_raw": "Does the class rep still"
},
{
"n": 193,
"h": "2d0972ac",
