},
{
"n": 18,
"h": "041c3879",
"en_raw": "Huh, really?"
},
{
"n": 19,
"h": "d28927d1",
"en_raw": "Apparently"
},
{
"n": 20,
"h": "4df139ca",
"en_raw": "Unexpected, or something"
},
{
"n": 21,
"h": "f67f3d5d",
"en_raw": "I ended up winning the bet"
},
{
"n": 22,
"h": "02a91651",
"en_raw": "...True, the Toilet Gang's"
},
