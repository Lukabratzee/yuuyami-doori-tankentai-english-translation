},
{
"n": 133,
"h": "ff6441c9",
"en_raw": "I didn't notice well"
},
{
"n": 134,
"h": "8a74d194",
"en_raw": "Which means... ugh"
},
{
"n": 135,
"h": "aa8f0a59",
"en_raw": "so the class rep wins?"
},
{
"n": 136,
"h": "c13eb552",
"en_raw": "No, we still don't know"
},
{
"n": 137,
"h": "e6925a22",
"en_raw": "whether that old man"
},
{
"n": 138,
"h": "a8a4091b",
"en_raw": "is the rumored mystery man"
},
{
"n": 139,
"h": "ed6bf325",
