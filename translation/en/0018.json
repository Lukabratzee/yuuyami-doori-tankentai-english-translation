"lines": [
{
"n": 0,
"h": "ad4c8e22",
"en_raw": "Ah, I blew it..."
},
{
"n": 1,
"h": "9036e405",
"en_raw": "What's wrong, Sango?"
},
{
"n": 2,
"h": "e6fb5bc0",
"en_raw": "It's weird to say it myself, but"
},
{
"n": 3,
"h": "0aca5ed0",
