"lines": [
{
"n": 0,
"h": "f7867510",
"en_raw": "Segawa Shinta, was it?"
},
{
"n": 1,
"h": "e497aa13",
"en_raw": "No fishing today..."
},
{
"n": 2,
"h": "e1dd1431",
"en_raw": "He left without"
},
{
"n": 3,
"h": "6386ad54",
"en_raw": "meeting my eyes"
},
{
"n": 4,
"h": "3b2b3994",
"en_raw": "Hey, wait"
},
{
"n": 5,
"h": "06735214",
"en_raw": "Murase Naoki's desk..."
},
{
"n": 6,
"h": "2f9b472b",
"en_raw": "Anyone who'd put it here"
},
{
"n": 7,
"h": "2b4bc504",
"en_raw": "must be extreme"
},
{
"n": 8,
"h": "d0fad1b4",
"en_raw": "Check the desk?"
},
{
"n": 9,
"h": "ab4f1ce0",
"en_raw": "Check anyway / No need  Whoa..."
},
{
"n": 10,
"h": "e5d079f7",
"en_raw": "Unexpected, or rather"
},
{
"n": 11,
"h": "858f8282",
"en_raw": "condolences..."
},
{
"n": 12,
"h": "8dcb37de",
"en_raw": "Well, nobody would put it in"
},
{
"n": 13,
"h": "e5aa2a5b",
"en_raw": "such a harmless person's desk"
},
{
"n": 14,
"h": "8d92f7c6",
"en_raw": "Going home, coward?"
},
{
"n": 15,
"h": "65e823e9",
"en_raw": "Then watch out for your desk"
},
{
"n": 16,
"h": "982405f3",
"en_raw": "Hey, are you that scared?"
},
{
"n": 17,
"h": "8e8f1ebb",
"en_raw": "Of lizard hands"
},
{
"n": 18,
"h": "3764dd8c",
"en_raw": "......"
},
{
"n": 19,
"h": "06479d09",
"en_raw": "Curses, huh, Oahu's curse"
},
{
"n": 20,
"h": "c27f9e16",
"en_raw": "But what's worse"
},
{
"n": 21,
"h": "84e02f2c",
"en_raw": "is how much others dislike you"
},
{
"n": 22,
"h": "3b56aca5",
"en_raw": "or look down on you"
},
{
"n": 23,
"h": "30929858",
"en_raw": "that you can tell"
},
{
"n": 24,
"h": "4b479bd5",
"en_raw": "just by searching your desk"
},
{
"n": 25,
"h": "55e12497",
"en_raw": "......."
},
{
"n": 26,
"h": "ae44fa74",
"en_raw": "So, putting on a straight face"
},
{
"n": 27,
"h": "724ed335",
"en_raw": "into someone else's desk..."
},
{
"n": 28,
"h": "d907c077",
"en_raw": "I-I didn't do it"
},
{
"n": 29,
"h": "282b3711",
"en_raw": "I didn't say anything"
},
{
"n": 30,
"h": "e65a34cd",
"en_raw": "I just asked what you were doing"
},
{
"n": 31,
"h": "cf294d88",
"en_raw": "in front of Nao's desk before"
},
{
"n": 32,
"h": "b1c0dc4b",
"en_raw": "...N-no way"
},
{
"n": 33,
"h": "53d6eb1a",
"en_raw": "I'm just asking..."
},
{
"n": 34,
"h": "026c6eb9",
"en_raw": "No one could've seen me!"
},
{
"n": 35,
"h": "6193a425",
"en_raw": "...It was Segawa"
},
{
"n": 36,
"h": "55e12497",
"en_raw": "......."
},
{
"n": 37,
"h": "f23c9bb7",
"en_raw": "The worst curse"
},
{
"n": 38,
"h": "55e12497",
"en_raw": "......."
},
{
"n": 39,
"h": "f1d13f90",
"en_raw": "I won't get mad"
},
{
"n": 40,
"h": "f6e45b3c",
"en_raw": "tell me what you know"
},
{
"n": 41,
"h": "c97b3168",
"en_raw": "At first I knew too"
},
{
"n": 42,
"h": "ee97cec8",
"en_raw": "who put it in"
},
{
"n": 43,
"h": "999a1fb1",
"en_raw": "...Yuasa"
},
{
"n": 44,
"h": "f867f3a0",
"en_raw": "It must be those guys"
},
{
"n": 45,
"h": "65311e93",
"en_raw": "But no matter how I returned it"
},
{
"n": 46,
"h": "87651b2f",
"en_raw": "it never ended"
},
{
"n": 47,
"h": "c0f5e725",
"en_raw": "and even at home I worry and can't sleep"
},
{
"n": 48,
"h": "e955c665",
"en_raw": "and gradually I"
},
{
"n": 49,
"h": "adaf22f6",
"en_raw": "got exhausted"
},
{
"n": 50,
"h": "8d3bee29",
"en_raw": "so that's why..."
},
{
"n": 51,
"h": "55e12497",
"en_raw": "......."
},
{
"n": 52,
"h": "44c3a7dd",
"en_raw": "Sorry, Murase"
},
{
"n": 53,
"h": "adc8032a",
"en_raw": "Sorry..."
},
{
"n": 54,
"h": "734329e1",
"en_raw": "This is pointless"
},
{
"n": 55,
"h": "848f29a9",
"en_raw": "...The worst, the absolute worst!"
},
{
"n": 56,
"h": "44c3a7dd",
"en_raw": "Sorry, Murase"
},
{
"n": 57,
"h": "adc8032a",
"en_raw": "Sorry..."
},
{
"n": 58,
"h": "b24ef1e6",
"en_raw": "..."
},
{
"n": 59,
"h": "bf9053d4",
"en_raw": "I can't listen to this"
},
{
"n": 60,
"h": "1daea98b",
"en_raw": "Sango, stay out of this"
},
{
"n": 61,
"h": "01eacbb7",
"en_raw": "...Segawa, continue"
}
