},
{
"n": 12,
"h": "73a5a2a6",
"en_raw": "204..."
},
{
"n": 13,
"h": "333582e3",
"en_raw": "A corpse full of grudge"
},
{
"n": 14,
"h": "ad76949a",
"en_raw": "is hidden there..."
},
{
"n": 15,
"h": "511a227f",
"en_raw": "Eek..."
},
{
"n": 16,
"h": "8fc714f9",
"en_raw": "Can't the police tell?"
},
{
"n": 17,
"h": "dc46d13a",
"en_raw": "Without that kind of sense"
},
{
"n": 18,
"h": "549553ee",
