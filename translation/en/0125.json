},
{
"n": 19,
"h": "34cf0292",
"en_raw": "........"
},
{
"n": 20,
"h": "56b6116d",
"en_raw": "Hey, Yuri"
},
{
"n": 21,
"h": "61df903e",
"en_raw": "That otaku girl is standing there again"
},
{
"n": 22,
"h": "7e1a4b29",
"en_raw": "You sense the corpse's grudge"
},
{
"n": 23,
"h": "805e490e",
"en_raw": "but"
},
{
"n": 24,
"h": "bedcbfca",
"en_raw": "you don't sense"
},
{
"n": 25,
"h": "85cab403",
"en_raw": "my presence?"
},
{
"n": 26,
"h": "b0bf25a2",
"en_raw": "How half-baked"
},
{
"n": 27,
"h": "93d7a10f",
"en_raw": "...That Lord Tsukuyomi thing"
},
{
"n": 28,
"h": "35ae4c9a",
"en_raw": "I noticed, all along"
},
{
"n": 29,
"h": "44e227d5",
"en_raw": "...I just thought it'd be pointless to tell"
},
{
"n": 30,
"h": "f8f58e54",
