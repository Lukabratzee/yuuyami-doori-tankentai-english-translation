"lines": [
{
"n": 0,
"h": "c53530c8",
"en_raw": "Hey, Murase"
},
{
"n": 1,
"h": "a4ade5a5",
"en_raw": "What's wrong, Segawa?"
},
{
"n": 2,
"h": "560b2c64",
"en_raw": "Murase, you know"
},
{
"n": 3,
"h": "e39e3294",
"en_raw": "you've changed since second year"
},
{
"n": 4,
"h": "c4df8268",
"en_raw": "Why?"
},
{
"n": 5,
"h": "1b6eb3d0",
"en_raw": "You always seem busy"
},
{
"n": 6,
"h": "3bd22f9b",
"en_raw": "That's not true"
},
{
"n": 7,
"h": "8022fbcb",
"en_raw": "And somehow"
},
{
"n": 8,
"h": "bd8e7f15",
"en_raw": "you're hard to talk to..."
},
{
"n": 9,
"h": "7c3af9c8",
"en_raw": "You're closer to Nishi and them"
},
{
"n": 10,
"h": "f087ac9d",
"en_raw": "That's not true at all"
},
{
"n": 11,
"h": "85045a8a",
"en_raw": "Well, fine"
},
{
"n": 12,
"h": "11509f04",
"en_raw": "I've been busy with lots of things lately too"
},
{
"n": 13,
"h": "b68cd643",
"en_raw": "But if you have free time"
},
{
"n": 14,
"h": "c73b8b2e",
"en_raw": "let's go to the batting center again"
},
{
"n": 15,
"h": "ffb05210",
"en_raw": "I bet Murase"
},
{
"n": 16,
"h": "417819b4",
"en_raw": "has gotten worse"
},
{
"n": 17,
"h": "a30163da",
"en_raw": "Yeah"
},
{
"n": 18,
"h": "56ad11bb",
"en_raw": "Summer break is still a ways off"
},
{
"n": 19,
"h": "b49c048e",
"en_raw": "Let's go again if we have time"
},
{
"n": 20,
"h": "c73b8b2e",
"en_raw": "let's go to the batting center again"
},
{
"n": 21,
"h": "2f4cc007",
"en_raw": "Hey, Murase?"
},
{
"n": 22,
"h": "9ac4cc40",
"en_raw": "I've got a good rumor"
},
{
"n": 23,
"h": "aa5e0482",
"en_raw": "Want to hear it?"
},
{
"n": 24,
"h": "21fdbb07",
"en_raw": "...Yeah, tell me"
},
{
"n": 25,
"h": "7f0dd9ee",
"en_raw": "The other day, at the Tama River"
},
{
"n": 26,
"h": "0be14237",
"en_raw": "I discovered a new species of bug"
},
{
"n": 27,
"h": "9fc37a3b",
"en_raw": "A big grasshopper"
},
{
"n": 28,
"h": "d39200a5",
"en_raw": "...It's really dangerous"
},
{
"n": 29,
"h": "8a4d5d89",
"en_raw": "It was perched on the grass"
},
{
"n": 30,
"h": "64593a04",
"en_raw": "and didn't move when I got close"
},
{
"n": 31,
"h": "90333403",
"en_raw": "so I tried to catch it"
},
{
"n": 32,
"h": "b72b6237",
"en_raw": "and it suddenly charged me"
},
{
"n": 33,
"h": "d19edcac",
"en_raw": "It went for my neck"
},
{
"n": 34,
"h": "56d081e9",
"en_raw": "so I thought, danger"
},
{
"n": 35,
"h": "f0d8dd5d",
"en_raw": "and swatted it away"
},
{
"n": 36,
"h": "666d15f6",
"en_raw": "But after that, I felt a sting"
},
{
"n": 37,
"h": "39eab8e8",
"en_raw": "and when I put my hand to my neck"
},
{
"n": 38,
"h": "a43047d9",
"en_raw": "it was covered in blood"
},
{
"n": 39,
"h": "27b94b45",
"en_raw": "So... what do you think happened?"
},
{
"n": 40,
"h": "de9815e3",
"en_raw": "...What happened?"
},
{
"n": 41,
"h": "6c8d4f55",
"en_raw": "When I looked at the grasshopper"
},
{
"n": 42,
"h": "e984d5f8",
"en_raw": "its mouth had blood too..."
},
{
"n": 43,
"h": "7fbf547b",
"en_raw": "I'm sure that grasshopper"
},
{
"n": 44,
"h": "090f4c96",
"en_raw": "is a new species"
},
{
"n": 45,
"h": "693c2e04",
"en_raw": "Blood-sucking grasshopper..."
},
{
"n": 46,
"h": "f569de01",
"en_raw": "Murase, how's this rumor?"
},
{
"n": 47,
"h": "3036e214",
"en_raw": "Decided against obtaining the rumor of"
},
{
"n": 48,
"h": "ccb2a8e8",
"en_raw": "the Blood-Sucking Grasshopper"
},
{
"n": 49,
"h": "ad3d281e",
"en_raw": "Huh, was my rumor"
},
{
"n": 50,
"h": "1fe7f460",
"en_raw": "boring?"
},
{
"n": 51,
"h": "0a3674ef",
"en_raw": "If I find another interesting rumor"
},
{
"n": 52,
"h": "294e5a62",
"en_raw": "I'll tell you"
}
]
}