"lines": [
{
"n": 0,
"h": "967d4280",
"en_raw": "When that old man walks"
},
{
"n": 1,
"h": "2fedab9a",
"en_raw": "pigeons chase after him"
},
{
"n": 2,
"h": "55c20f6a",
"en_raw": "He walks dropping baby biscuits"
},
{
"n": 3,
"h": "6c36e007",
"en_raw": "crumb by crumb"
},
{
"n": 4,
"h": "975e8fe6",
"en_raw": "And if he gets stuck on a utility pole"
},
{
"n": 5,
"h": "dc417cb3",
"en_raw": "he stops"
},
{
"n": 6,
"h": "9df3978b",
"en_raw": "with a troubled face"
},
{
"n": 7,
"h": "42a06486",
"en_raw": "And passing boys"
},
{
"n": 8,
"h": "8f89d851",
"en_raw": "spin him around"
},
{
"n": 9,
"h": "bfa1e678",
"en_raw": "...But after that"
},
{
"n": 10,
"h": "62f85678",
"en_raw": "class rep Sunakawa came and"
},
{
"n": 11,
"h": "0d740f63",
"en_raw": "scolded the boys"
},
{
"n": 12,
"h": "a9b4325a",
"en_raw": "Seriously, why?"
},
{
"n": 13,
"h": "dba6a13e",
"en_raw": "Who knows, her hobby maybe?"
},
{
"n": 14,
"h": "7412c88e",
"en_raw": "She's really"
},
{
"n": 15,
"h": "a3518175",
"en_raw": "annoying"
},
{
"n": 16,
"h": "af656ec7",
"en_raw": "...But come to think of it"
},
{
"n": 17,
"h": "78c15513",
"en_raw": "I haven't seen that old man lately"
},
{
"n": 18,
"h": "33fb4d93",
"en_raw": "Huh, you don't know?"
},
{
"n": 19,
"h": "fcabc4b0",
"en_raw": "The old man died"
},
{
"n": 20,
"h": "ca623f9c",
"en_raw": "What, he died?"
},
{
"n": 21,
"h": "b92bb863",
"en_raw": "You really don't know? It's famous"
},
{
"n": 22,
"h": "29980d04",
"en_raw": "...Hey hey, Sakai"
},
{
"n": 23,
"h": "44f60675",
"en_raw": "The eavesdropper is here again"
},
{
"n": 24,
"h": "0c66220b",
"en_raw": "Another day of fun gossip, I see"
},
{
"n": 25,
"h": "20879d3e",
"en_raw": "Hirauchi, you"
},
{
"n": 26,
"h": "f08f655c",
"en_raw": "Sunakawa was looking for you"
},
{
"n": 27,
"h": "107a4db5",
"en_raw": "Outcasts should get along"
},
{
"n": 28,
"h": "acedae8f",
"en_raw": "Why not get out of the bathroom already?"
},
{
"n": 29,
"h": "629e34fa",
"en_raw": "........."
},
{
"n": 30,
"h": "e2b454dc",
"en_raw": "Who's today's target"
},
{
"n": 31,
"h": "9aed5adc",
"en_raw": "for the badmouthing?"
},
{
"n": 32,
"h": "58b974f2",
"en_raw": "Don't talk to us"
},
{
"n": 33,
"h": "9c1ff0bd",
"en_raw": "Otaku"
},
{
"n": 34,
"h": "56c56f1c",
"en_raw": "Sorry, idiocy is contagious"
},
{
"n": 35,
"h": "d4050e37",
"en_raw": "With this"
}
]
}