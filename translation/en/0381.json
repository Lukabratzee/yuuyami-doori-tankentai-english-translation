"file": 381,
"paths": [
"d008/d010/f024"
],
"lines": [
{
"n": 0,
"h": "cce70725",
"en_raw": "A cat's voice"
},
{
"n": 1,
"h": "c17964a4",
"en_raw": "Coming from here...?"
},
{
"n": 2,
"h": "2665bb36",
"en_raw": "Could it be a cat...?"
},
{
"n": 3,
"h": "80da038d",
"en_raw": "Gotta help / It's scary..."
},
{
"n": 4,
"h": "8e0a01dd",
"en_raw": "No way..."
},
{
"n": 5,
"h": "0d97d60b",
"en_raw": "Kume, really..."
},
{
"n": 6,
"h": "35396a66",
"en_raw": "I have to get it out quickly..."
},
{
"n": 7,
"h": "55e12497",
"en_raw": "......."
},
{
"n": 8,
"h": "0f0122ae",
"en_raw": "There's no way"
},
{
"n": 9,
"h": "d90c4897",
"en_raw": "It's my imagination..."
},
{
"n": 10,
"h": "04427f5c",
"en_raw": "Segawa!"
},
{
"n": 11,
"h": "058c6b8f",
"en_raw": "Sorry, I'm busy right now"
},
{
"n": 12,
"h": "cb0514d3",
"en_raw": "But there's something I really"
},
{
"n": 13,
"h": "5169790d",
"en_raw": "need to ask you, Segawa"
},
{
"n": 14,
"h": "ac40dadc",
"en_raw": "No, even if it's you, Murase"
},
{
"n": 15,
"h": "31a961f6",
"en_raw": "I can't say this"
},
{
"n": 16,
"h": "5c1c724d",
"en_raw": "...You know, right?"
},
{
"n": 17,
"h": "2cc494e6",
"en_raw": "Yeah, but..."
},
{
"n": 18,
"h": "5a04e8ce",
"en_raw": "The cat you're looking for, Segawa"
},
{
"n": 19,
"h": "1ebfbc7e",
"en_raw": "we're the ones who saved it..."
},
{
"n": 20,
"h": "629e34fa",
"en_raw": "........."
},
{
"n": 21,
"h": "137a7a48",
"en_raw": "Um..."
},
{
"n": 22,
"h": "7413a28d",
"en_raw": "Anyway, I can't talk here"
},
{
"n": 23,
"h": "ce46c9e4",
"en_raw": "Murase, if I say"
},
{
"n": 24,
"h": "6eb2d5b2",
"en_raw": "the woods behind the golf center"
},
{
"n": 25,
"h": "9e455014",
"en_raw": "you know the place, right?"
},
{
"n": 26,
"h": "8f0ef26e",
"en_raw": "Yeah..."
},
{
"n": 27,
"h": "6e65e6e9",
"en_raw": "Tomorrow, after school"
},
{
"n": 28,
"h": "204fedaf",
"en_raw": "I'll talk there"
},
{
"n": 29,
"h": "b2c3c5ca",
"en_raw": "Until then..."
},
{
"n": 30,
"h": "a6072480",
"en_raw": "Sorry, but"
},
{
"n": 31,
"h": "f59dc565",
"en_raw": "don't talk to me at school either"
},
{
"n": 32,
"h": "b2fdeee9",
"en_raw": "I'm counting on you"
},
{
"n": 33,
"h": "9e955586",
"en_raw": "Segawa..."
},
{
"n": 34,
"h": "53833186",
"en_raw": "Sorry..."
},
{
"n": 35,
"h": "3764dd8c",
"en_raw": "......"
},
{
"n": 36,
"h": "ca762390",
"en_raw": "No matter how many times I do this"
},
{
"n": 37,
"h": "d99250fd",
"en_raw": "nothing ever ends..."
}
]
}