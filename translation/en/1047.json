"lines": [
{
"n": 0,
"h": "953944d1",
"en_raw": "Excuse me, there's been an incident"
},
{
"n": 1,
"h": "b8086c87",
"en_raw": "What happened?"
},
{
"n": 2,
"h": "2e4f6f24",
"en_raw": "Don't scare me..."
},
{
"n": 3,
"h": "d25ca693",
"en_raw": "Before that, may I?"
},
{
"n": 4,
"h": "c39c7efb",
"en_raw": "...What?"
},
{
"n": 5,
"h": "0ecf5766",
"en_raw": "Is the suicide at the pachinko parlor"
},
{
"n": 6,
"h": "b641bf2b",
"en_raw": "by the station's north exit a true story?"
},
{
"n": 7,
"h": "3764dd8c",
"en_raw": "......"
},
{
"n": 8,
"h": "4c279a4c",
"en_raw": "Hey hey, officer"
},
{
"n": 9,
"h": "4306078f",
"en_raw": "the pachinko parlor incident"
},
{
"n": 10,
"h": "778e7a72",
"en_raw": "is true, right?"
},
{
"n": 11,
"h": "ab0d39e5",
"en_raw": "Hey, it's true, right?"
},
{
"n": 12,
"h": "14c238fd",
"en_raw": "Could you tell me"
},
{
"n": 13,
"h": "41690e79",
"en_raw": "a bit more than others?"
},
{
"n": 14,
"h": "e8e04cf0",
"en_raw": "What incident?"
},
{
"n": 15,
"h": "1f10ae78",
"en_raw": "Don't confuse me so much"
},
{
"n": 16,
"h": "88bde2aa",
"en_raw": "The pachinko parlor ghost!"
},
{
"n": 17,
"h": "c39c7efb",
"en_raw": "...What?"
},
{
"n": 18,
"h": "116548a9",
"en_raw": "I don't understand at all"
},
{
"n": 19,
"h": "d0ef4307",
"en_raw": "So, a ghost appears"
},
{
"n": 20,
"h": "8e9fd50f",
"en_raw": "I'm scared to death"
},
{
"n": 21,
"h": "b53bdc7a",
"en_raw": "so do something about it"
},
{
"n": 22,
"h": "10df3bbd",
"en_raw": "...Huh?"
},
{
"n": 23,
"h": "5dd402d5",
"en_raw": "Hey, did some mama"
},
{
"n": 24,
"h": "9ac51903",
"en_raw": "die?"
},
{
"n": 25,
"h": "6a419b02",
"en_raw": "You know, mama means..."
},
{
"n": 26,
"h": "461835eb",
"en_raw": "Kids these days, honestly"
},
{
"n": 27,
"h": "c479f9e0",
"en_raw": "where do they get such words..."
},
{
"n": 28,
"h": "7dab651c",
"en_raw": "Ah, you're exasperated now!"
},
{
"n": 29,
"h": "d0893339",
"en_raw": "Protecting citizens"
},
{
"n": 30,
"h": "305ecb82",
"en_raw": "is the police's duty!"
},
{
"n": 31,
"h": "f2990730",
"en_raw": "Sorry, I can't tell you"
},
{
"n": 32,
"h": "453adcd7",
"en_raw": "Raising healthy youth"
},
{
"n": 33,
"h": "4da2fc27",
"en_raw": "is also the police's duty"
},
{
"n": 34,
"h": "bb670836",
"en_raw": "Hey, officer..."
},
{
"n": 35,
"h": "3ea20f43",
"en_raw": "No way"
},
{
"n": 36,
"h": "6d472580",
"en_raw": "Don't stick your neck"
},
{
"n": 37,
"h": "6c1bd37d",
"en_raw": "into weird things"
},
{
"n": 38,
"h": "adbc1ece",
"en_raw": "Aw, it was just innocent curiosity"
}
]
}