"lines": [
{
"n": 0,
"h": "c53530c8",
"en_raw": "Hey, Murase"
},
{
"n": 1,
"h": "f8d397eb",
"en_raw": "Have you ever seen a snake?"
},
{
"n": 2,
"h": "cb87c726",
"en_raw": "A snake...?"
},
{
"n": 3,
"h": "62cf74f4",
"en_raw": "No, never"
},
{
"n": 4,
"h": "fb78b795",
"en_raw": "I've seen"
},
{
"n": 5,
"h": "6cbde901",
"en_raw": "a huge swarm of snakes"
},
{
"n": 6,
"h": "d0322df6",
"en_raw": "It was back in elementary school"
},
{
"n": 7,
"h": "521b1e37",
"en_raw": "Hey, Segawa-kun"
},
{
"n": 8,
"h": "a7608b64",
"en_raw": "About what we just talked about..."
},
{
"n": 9,
"h": "3d0442de",
"en_raw": "Hey, Segawa"
},
{
"n": 10,
"h": "a3f522dd",
"en_raw": "A swarm of snakes"
},
{
"n": 11,
"h": "68e27da7",
"en_raw": "is that even real?"
},
{
"n": 12,
"h": "12c32894",
"en_raw": "You don't believe me, do you?"
},
{
"n": 13,
"h": "3b7b0c85",
"en_raw": "But Yamazaki also"
},
{
"n": 14,
"h": "4c95bc52",
"en_raw": "saw it then"
},
{
"n": 15,
"h": "85df2771",
"en_raw": "Yamazaki?"
},
{
"n": 16,
"h": "60875ea7",
"en_raw": "Takumi Yamazaki, the class rep?"
},
{
"n": 17,
"h": "524fc0f0",
"en_raw": "Yes"
},
{
"n": 18,
"h": "5bc9a72f",
"en_raw": "In elementary school, Yamazaki and I"
},
{
"n": 19,
"h": "97ef261d",
"en_raw": "often went to the reservoir"
},
{
"n": 20,
"h": "787d5a56",
"en_raw": "to fish"
},
{
"n": 21,
"h": "065d0bde",
"en_raw": "...Lately it's just me, though"
},
{
"n": 22,
"h": "48b312d3",
"en_raw": "You and Yamazaki"
},
{
"n": 23,
"h": "96ef1baa",
"en_raw": "were good friends?"
},
{
"n": 24,
"h": "8d934e7a",
"en_raw": "Back then"
},
{
"n": 25,
"h": "09d0f295",
"en_raw": "Let's go fishing together"
},
{
"n": 26,
"h": "207f1921",
"en_raw": "again sometime"
},
{
"n": 27,
"h": "1745d5fc",
"en_raw": "Murase, you've surely"
},
{
"n": 28,
"h": "3701ffe4",
"en_raw": "gotten rusty"
}
]
}