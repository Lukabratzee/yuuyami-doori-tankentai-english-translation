"lines": [
{
"n": 0,
"h": "f02e1745",
"en_raw": "This is the Hilltop Jizo..."
},
{
"n": 1,
"h": "42ad9359",
"en_raw": "Right?"
},
{
"n": 2,
"h": "c58d7f21",
"en_raw": "It's way too late"
},
{
"n": 3,
"h": "86903b00",
"en_raw": "...if you're really serious"
},
{
"n": 4,
"h": "715d39ec",
"en_raw": "but"
},
{
"n": 5,
"h": "d7b0729e",
"en_raw": "Right..."
},
{
"n": 6,
"h": "38e3d6bc",
"en_raw": "This is the Hilltop Jizo, right?"
},
{
"n": 7,
"h": "bce7f456",
"en_raw": "So you wait for dusk"
},
{
"n": 8,
"h": "c94bf502",
"en_raw": "and turn around"
},
{
"n": 9,
"h": "44bd7efd",
"en_raw": "from either the right or the left"
},
{
"n": 10,
"h": "fb6a852b",
"en_raw": "Left, you meet your future self"
},
{
"n": 11,
"h": "9001779b",
"en_raw": "Opposite, the person you'll be bound to"
},
{
"n": 12,
"h": "6fee7132",
"en_raw": "...Shiina, you"
},
{
"n": 13,
"h": "5f5cd8d2",
"en_raw": "Do you even understand what that means?"
},
{
"n": 14,
"h": "68a03d69",
"en_raw": "Wait for dusk / Skip  I can't think about"
},
{
"n": 15,
"h": "6634edb7",
"en_raw": "a future partner yet"
},
{
"n": 16,
"h": "5c6ea933",
"en_raw": "What are you saying, idiot"
},
{
"n": 17,
"h": "082ae175",
"en_raw": "...Anyway, let's go!"
},
{
"n": 18,
"h": "d6039ac6",
"en_raw": "I'll try it"
},
{
"n": 19,
"h": "86fbf47c",
"en_raw": "Oh, okay, good luck"
},
{
"n": 20,
"h": "ede348a3",
"en_raw": "Well, Shiina, let's go"
},
{
"n": 21,
"h": "617519c7",
"en_raw": "You two are leaving?"
},
{
"n": 22,
"h": "5814b0d8",
"en_raw": "I don't believe in this kind of fortune"
},
{
"n": 23,
"h": "54f23dbd",
"en_raw": "from the start"
},
{
"n": 24,
"h": "bdab823f",
"en_raw": "Try anyway / Don't  If you meet future Nao"
},
{
"n": 25,
"h": "371f96f1",
"en_raw": "tell me what he was like"
},
{
"n": 26,
"h": "e70ef1d2",
"en_raw": "Bye, Nao!"
},
{
"n": 27,
"h": "9227714e",
"en_raw": "The sun sets"
},
{
"n": 28,
"h": "b8797ff5",
"en_raw": "A little wind seems to have picked up..."
},
{
"n": 29,
"h": "c1708ca7",
"en_raw": "Um, did you just"
},
{
"n": 30,
"h": "e43dccbd",
"en_raw": "call me?"
},
{
"n": 31,
"h": "29cca894",
"en_raw": "No..."
},
{
"n": 32,
"h": "86a07329",
"en_raw": "What's wrong?"
},
{
"n": 33,
"h": "a67d0bb0",
"en_raw": "Um, I heard that"
},
{
"n": 34,
"h": "068d71be",
"en_raw": "if you turn around in front of that Jizo"
},
{
"n": 35,
"h": "fec5e749",
"en_raw": "you meet your future self"
},
{
"n": 36,
"h": "b58d46bb",
"en_raw": "Everyone gets old, you know"
},
{
"n": 37,
"h": "03c697b8",
"en_raw": "You're still here?"
},
{
"n": 38,
"h": "b8f88bcc",
"en_raw": "...Where's Shiina?"
},
{
"n": 39,
"h": "c6cd4332",
"en_raw": "Shiina went home, I think?"
},
{
"n": 40,
"h": "d670f338",
"en_raw": "Oh, then"
},
{
"n": 41,
"h": "91e1453c",
"en_raw": "that's fine..."
},
{
"n": 42,
"h": "320ea146",
"en_raw": "Let's go home already"
}
]
}