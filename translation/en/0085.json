{
"file": 85,
"paths": [
"d007/d000/f359"
],
"lines": [
{
"n": 0,
"h": "c53530c8",
"en_raw": "Hey, Murase"
},
{
"n": 1,
"h": "26c57dbc",
"en_raw": "Oh, Kume, what's up?"
},
{
"n": 2,
"h": "5fee738e",
"en_raw": "That's a harsh way to put it"
},
{
"n": 3,
"h": "e9e53c71",
"en_raw": "I've been waiting here all this time"
},
{
"n": 4,
"h": "0f29eede",
"en_raw": "No, I didn't know"
},
{
"n": 5,
"h": "5c67247f",
"en_raw": "Kume was here..."
},
{
"n": 6,
"h": "5503dc44",
"en_raw": "Well, we're close, you and I"
},
{
"n": 7,
"h": "473dcd67",
"en_raw": "so I'll make an exception"
},
{
"n": 8,
"h": "48f51884",
"en_raw": "Today there's something"
},
{
"n": 9,
"h": "a55bbc2b",
"en_raw": "I'd like you to see"
},
{
"n": 10,
"h": "da01ec9c",
"en_raw": "It's a certain grimoire..."
},
{
"n": 11,
"h": "887d6dd1",
"en_raw": "...Please don't make"
},
{
"n": 12,
"h": "baee3d01",
"en_raw": "a blatantly uninterested face"
},
{
"n": 13,
"h": "d37ed6c2",
"en_raw": "The facts written in it"
},
{
"n": 14,
"h": "8270fefb",
"en_raw": "concern you too"
},
{
"n": 15,
"h": "900a598b",
"en_raw": "Yeah, okay"
},
{
"n": 16,
"h": "99ba5cbd",
"en_raw": "Then show me next time"
},
{
"n": 17,
"h": "0ac4c831",
"en_raw": "This summer has perfect stars"
},
{
"n": 18,
"h": "895ea270",
"en_raw": "If you're going to do something"
},
{
"n": 19,
"h": "59d0c708",
"en_raw": "this summer is the only time"
},
{
"n": 20,
"h": "0621e163",
"en_raw": "Do you get it, Murase?"
},
{
"n": 21,
"h": "c9168c64",
"en_raw": "Well, sort of..."
}
]
}