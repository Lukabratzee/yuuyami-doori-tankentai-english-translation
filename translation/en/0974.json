],
"lines": [
{
"n": 0,
"h": "c03a63da",
"en_raw": "Um..."
},
{
"n": 1,
"h": "6f4d76f8",
"en_raw": "What's wrong?"
},
{
"n": 2,
"h": "4635fb4a",
"en_raw": "I'm caught up"
},
{
"n": 3,
"h": "6b29c041",
"en_raw": "in a terrible incident now"
},
{
"n": 4,
"h": "bb51264d",
"en_raw": "...What kind?"
},
{
"n": 5,
"h": "f95c61a5",
"en_raw": "A serial murder case"
},
{
"n": 6,
"h": "b42f7838",
"en_raw": "...Tell me more"
},
{
"n": 7,
"h": "b36aab4a",
"en_raw": "The culprit is clear"
},
{
"n": 8,
"h": "0096d48a",
"en_raw": "But, um... before that"
},
{
"n": 9,
"h": "67ee157d",
"en_raw": "I want to ask too"
},
{
"n": 10,
"h": "3ec9d583",
"en_raw": "Has there ever been a murder"
},
{
"n": 11,
"h": "2877dbd7",
"en_raw": "in this town?"
},
{
"n": 12,
"h": "3b060741",
"en_raw": "There've been various incidents"
},
{
"n": 13,
"h": "9fa17fb9",
"en_raw": "but murder... no, none"
},
{
"n": 14,
"h": "cb664006",
"en_raw": "...Huh?"
},
{
"n": 15,
"h": "6a5fe5fa",
"en_raw": "No murders?"
},
{
"n": 16,
"h": "5a3996d5",
"en_raw": "People killing people"
},
{
"n": 17,
"h": "beb83852",
"en_raw": "doesn't happen that often"
},
{
"n": 18,
"h": "0e19f3d3",
"en_raw": "Then recently, has a little girl"
},
{
"n": 19,
"h": "c44fe7f6",
"en_raw": "gone missing or anything...?"
},
{
"n": 20,
"h": "62b6b823",
"en_raw": "What a dangerous thing to ask"
},
{
"n": 21,
"h": "aa165fe3",
"en_raw": "...No"
},
{
"n": 22,
"h": "d59874ac",
"en_raw": "Then who did the murderer clown"
},
{
"n": 23,
"h": "c169366a",
"en_raw": "kill, exactly?"
},
{
"n": 24,
"h": "2536b2de",
"en_raw": "I'd like to ask you that"
},
{
"n": 25,
"h": "755de007",
"en_raw": "What's a murderer clown?"
},
{
"n": 26,
"h": "a93323a2",
"en_raw": "Huh, no way?"
},
{
"n": 27,
"h": "1ac253e7",
"en_raw": "Am I saying something weird?"
},
{
"n": 28,
"h": "e091b08b",
"en_raw": "Sorry, I'm going home"
},
{
"n": 29,
"h": "939de4a8",
"en_raw": "He might be a nationwide wanted criminal"
},
{
"n": 30,
"h": "4eefe9c7",
"en_raw": "so just in case"
},
{
"n": 31,
"h": "435a2cb2",
"en_raw": "these photos here"
},
{
"n": 32,
"h": "ceb00afc",
"en_raw": "take a look"
},
{
"n": 33,
"h": "42f78ef1",
"en_raw": "None of them"
},
{
"n": 34,
"h": "3300530c",
"en_raw": "Please let me go home..."
},
{
"n": 35,
"h": "31c4b02d",
"en_raw": "Yes, thanks for your cooperation"
},
{
"n": 36,
"h": "ea10531c",
"en_raw": "Well, if anything else"
},
{
"n": 37,
"h": "d00a1a37",
"en_raw": "bothers you"
},
{
"n": 38,
"h": "c3a9283e",
"en_raw": "feel free to drop by anytime"
},
{
"n": 39,
"h": "1d43d05d",
"en_raw": "...Thank you"
},
{
"n": 40,
"h": "71624d2b",
"en_raw": "...You shouldn't say such things"
},
{
"n": 41,
"h": "10fafef7",
"en_raw": "even as a joke"
},
{
"n": 42,
"h": "e897d084",
"en_raw": "Um... excuse me!"
}
]
}