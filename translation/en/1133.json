],
"lines": [
{
"n": 0,
"h": "f870a804",
"en_raw": "Hey hey, Mother"
},
{
"n": 1,
"h": "7f780555",
"en_raw": "Please, just this once"
},
{
"n": 2,
"h": "f540ebd5",
"en_raw": "Mom, it's obviously"
},
{
"n": 3,
"h": "6bd7c25a",
"en_raw": "about the phone"
},
{
"n": 4,
"h": "1815113d",
"en_raw": "...You, just the other day"
},
{
"n": 5,
"h": "9c333811",
"en_raw": "you were banned"
},
{
"n": 6,
"h": "dce42651",
"en_raw": "Better than paying phone fees"
},
{
"n": 7,
"h": "91f449ee",
"en_raw": "for rejection stories"
},
{
"n": 8,
"h": "71200936",
"en_raw": "Quit eavesdropping"
},
{
"n": 9,
"h": "b0dedb1b",
"en_raw": "Pervert!"
},
{
"n": 10,
"h": "ad320321",
"en_raw": "I can't help but hear it"
},
{
"n": 11,
"h": "5bfe4c29",
"en_raw": "you whine at full volume"
},
{
"n": 12,
"h": "7226f41e",
"en_raw": "...See, that's why I hate it"
},
{
"n": 13,
"h": "7abc8d46",
"en_raw": "Seriously"
},
{
"n": 14,
"h": "792df453",
"en_raw": "let me live alone!"
},
{
"n": 15,
"h": "caf0c880",
"en_raw": "Why do I always"
},
{
"n": 16,
"h": "71bd6378",
"en_raw": "get this treatment?"
},
{
"n": 17,
"h": "b2c554c2",
"en_raw": "You always play the victim"
},
{
"n": 18,
"h": "bb951016",
"en_raw": "Realize already why you get dumped"
},
{
"n": 19,
"h": "a390e4e2",
"en_raw": "you ugly"
},
{
"n": 20,
"h": "b95998bc",
"en_raw": "I can't live"
},
{
"n": 21,
"h": "1f5ff1de",
"en_raw": "with this!"
},
{
"n": 22,
"h": "a4179762",
"en_raw": "You two, be quiet!"
},
{
"n": 23,
"h": "0051e76e",
"en_raw": "Always asserting rights"
},
{
"n": 24,
"h": "fa656612",
"en_raw": "saying you want this and that!"
},
{
"n": 25,
"h": "42022978",
"en_raw": "Are you two"
},
{
"n": 26,
"h": "cb4fc583",
"en_raw": "fulfilling your own duties at all!"
},
{
"n": 27,
"h": "1d495ed9",
"en_raw": "...Mayu"
},
{
"n": 28,
"h": "9206efc4",
"en_raw": "I saw your midterm results"
},
{
"n": 29,
"h": "fb916cf8",
"en_raw": "Just because Dad"
},
{
"n": 30,
"h": "7501ecc1",
"en_raw": "says nothing"
},
{
"n": 31,
"h": "7a38e352",
"en_raw": "do you think that's acceptable!"
},
{
"n": 32,
"h": "cdf01e11",
"en_raw": "I won't be embarrassed"
},
{
"n": 33,
"h": "37df6ad5",
"en_raw": "at the interview again!"
},
{
"n": 34,
"h": "9a650069",
"en_raw": "...And Ai"
},
{
"n": 35,
"h": "cdb43694",
"en_raw": "Since the new term started"
},
{
"n": 36,
"h": "0200ae0c",
"en_raw": "have you kept curfew even once?"
},
{
"n": 37,
"h": "c096e6be",
"en_raw": "Your father was furious!"
},
{
"n": 38,
"h": "ac6347b1",
"en_raw": "Where are you going, Mayu!"
},
{
"n": 39,
"h": "40e2b538",
"en_raw": "I'm not done talking!"
},
{
"n": 40,
"h": "aac2ff60",
"en_raw": "Both of you, sit there!"
},
{
"n": 41,
"h": "c4049016",
"en_raw": "What about Mayu?"
},
{
"n": 42,
"h": "edac99fc",
"en_raw": "...Still on the phone"
}
]
}