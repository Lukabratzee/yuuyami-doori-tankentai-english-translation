"lines": [
{
"n": 0,
"h": "fd74e2c4",
"en_raw": "Paying respects at the burnt site?"
},
{
"n": 1,
"h": "764c713c",
"en_raw": "If we don't, you see"
},
{
"n": 2,
"h": "bcd4b798",
"en_raw": "Cookie-chan"
},
{
"n": 3,
"h": "d58f2214",
"en_raw": "won't be able to sleep"
},
{
"n": 4,
"h": "4f54cd29",
"en_raw": "Cookie... oh"
},
{
"n": 5,
"h": "ace6e9b4",
"en_raw": "you mean Mika Sakai and Yoshino"
},
{
"n": 6,
"h": "9ea56776",
"en_raw": "Those two are really like twins"
},
{
"n": 7,
"h": "f6862844",
"en_raw": "But they were fighting"
},
{
"n": 8,
"h": "fed31b3d",
"en_raw": "Jelly-chan"
},
{
"n": 9,
"h": "49e5f01e",
"en_raw": "said something mean"
},
{
"n": 10,
"h": "fb5e7c31",
"en_raw": "to Cookie-chan"
},
{
"n": 11,
"h": "9b95fde7",
"en_raw": "I can't tell which is which"
},
{
"n": 12,
"h": "75249b73",
"en_raw": "but that's rare"
},
{
"n": 13,
"h": "e39ab7c9",
"en_raw": "So what does that have to do"
},
{
"n": 14,
"h": "5a148d45",
"en_raw": "with paying respects?"
},
{
"n": 15,
"h": "65b70312",
"en_raw": "...Dunno"
},
{
"n": 16,
"h": "dcd734ff",
"en_raw": "What do you mean, you don't know"
},
{
"n": 17,
"h": "279fafdb",
"en_raw": "Listen, Shiina"
},
{
"n": 18,
"h": "a6a383a2",
"en_raw": "Sango, I know about the fire"
},
{
"n": 19,
"h": "34c7a364",
"en_raw": "the other day"
},
{
"n": 20,
"h": "dc2dc750",
"en_raw": "I heard fire engine sirens"
},
{
"n": 21,
"h": "67522ca6",
"en_raw": "and saw smoke rising"
},
{
"n": 22,
"h": "90f3db2e",
"en_raw": "Oh, right, and then"
},
{
"n": 23,
"h": "aa5e3c0d",
"en_raw": "kids play there"
},
{
"n": 24,
"h": "3574409b",
"en_raw": "A boy who burned to death"
},
{
"n": 25,
"h": "433101a4",
"en_raw": "Burned to death...?"
},
{
"n": 26,
"h": "1eed70ac",
"en_raw": "What, that's suddenly horror"
},
{
"n": 27,
"h": "00f61c38",
"en_raw": "Shiina, is that story true?"
},
{
"n": 28,
"h": "a2c7d06f",
"en_raw": "Jelly-chan said so"
},
{
"n": 29,
"h": "ec8f4246",
"en_raw": "Playing in the burnt ruins, laughing"
},
{
"n": 30,
"h": "6f5ef532",
"en_raw": "the spirits of charred children, huh..."
},
{
"n": 31,
"h": "e1835e2f",
"en_raw": "Nao, what do you think?"
},
{
"n": 32,
"h": "7bbf9dce",
"en_raw": "I... can go if you want"
},
{
"n": 33,
"h": "2d004144",
"en_raw": "I'm not scared or anything"
},
{
"n": 34,
"h": "d93f79d5",
"en_raw": "...Hmm"
},
{
"n": 35,
"h": "4fd47963",
"en_raw": "Then let's go"
},
{
"n": 36,
"h": "fd488f1b",
"en_raw": "Nao goes first!"
},
{
"n": 37,
"h": "1b86f75f",
"en_raw": "What?!"
},
{
"n": 38,
"h": "4a68694e",
"en_raw": "Nao, do you remember"
},
{
"n": 39,
"h": "5233bd14",
"en_raw": "where the fire was?"
},
{
"n": 40,
"h": "44145d11",
"en_raw": "I think it was around the Karugane"
},
{
"n": 41,
"h": "bfae6bd1",
"en_raw": "town area, but..."
},
{
"n": 42,
"h": "28f79bd9",
"en_raw": "Where the shrine and the waterworks are"
},
{
"n": 43,
"h": "e273786e",
"en_raw": "that area?"
},
{
"n": 44,
"h": "26187f0b",
"en_raw": "Yes, but are we really going?"
},
{
"n": 45,
"h": "a888254d",
"en_raw": "Yes, but..."
},
{
"n": 46,
"h": "20a340fc",
"en_raw": "Are we really going?"
},
{
"n": 47,
"h": "5bf33a53",
"en_raw": "Of course"
},
{
"n": 48,
"h": "3231f9e8",
"en_raw": "To get accurate information"
},
{
"n": 49,
"h": "62116c9a",
"en_raw": "we'll even ask around"
},
{
"n": 50,
"h": "8f22b66b",
"en_raw": "It was a strange place, sure, but"
},
{
"n": 51,
"h": "6fb0478d",
"en_raw": "in the end, there's nothing there"
},
{
"n": 52,
"h": "eeea2d35",
"en_raw": "Ah!"
},
{
"n": 53,
"h": "4c8f881c",
"en_raw": "What is it, Shiina?"
},
{
"n": 54,
"h": "698200df",
"en_raw": "Kurumi forgot"
},
{
"n": 55,
"h": "242906f7",
"en_raw": "the promise to Cookie-chan!"
},
{
"n": 56,
"h": "40312f8a",
"en_raw": "Oh, what was it, paying respects?"
},
{
"n": 57,
"h": "daa548f7",
"en_raw": "Whatever"
},
{
"n": 58,
"h": "21b084ac",
"en_raw": "No spirits showed up anyway"
},
{
"n": 59,
"h": "24f85291",
"en_raw": "I guess"
},
{
"n": 60,
"h": "c1140adf",
"en_raw": "...Hm?"
},
{
"n": 61,
"h": "f9cd601c",
"en_raw": "What's wrong, Nao, you look pale"
},
{
"n": 62,
"h": "19e8bdd8",
"en_raw": "I... may have heard something"
},
{
"n": 63,
"h": "1fa65a7a",
"en_raw": "What is?"
},
{
"n": 64,
"h": "8ef0453b",
"en_raw": "A child's... spirit's... voice..."
},
{
"n": 65,
"h": "dd04d029",
"en_raw": "A spirit's voice?"
},
{
"n": 66,
"h": "42c0a518",
"en_raw": "Nao, is that true?"
},
{
"n": 67,
"h": "ca421c26",
"en_raw": "I don't know, but..."
},
{
"n": 68,
"h": "92b8d5cf",
"en_raw": "Let's go again"
},
{
"n": 69,
"h": "9ec78258",
"en_raw": "tomorrow or so"
},
{
"n": 70,
"h": "56b739b5",
"en_raw": "Ah, Kurumi"
},
{
"n": 71,
"h": "1beca43a",
"en_raw": "forgot to pay respects"
},
{
"n": 72,
"h": "242906f7",
"en_raw": "the promise to Cookie-chan!"
},
{
"n": 73,
"h": "daa548f7",
"en_raw": "Whatever"
},
{
"n": 74,
"h": "21b084ac",
"en_raw": "No spirits showed up anyway"
},
{
"n": 75,
"h": "24f85291",
"en_raw": "I guess"
},
{
"n": 76,
"h": "c1140adf",
"en_raw": "...Hm?"
},
{
"n": 77,
"h": "327f247d",
"en_raw": "What's wrong, Nao?"
},
{
"n": 78,
"h": "99823c23",
"en_raw": "...Shiina, that's no good"
},
{
"n": 79,
"h": "6a0e8405",
"en_raw": "You have to do it properly"
},
{
"n": 80,
"h": "e2e6c742",
"en_raw": "What are you mumbling about?"
},
{
"n": 81,
"h": "e506a397",
"en_raw": "I... heard it"
},
{
"n": 82,
"h": "e08b5879",
"en_raw": "A child's, spirit's, playing voice..."
},
{
"n": 83,
"h": "d0a54c90",
"en_raw": "...Really?"
},
{
"n": 84,
"h": "823ff8e7",
"en_raw": "Shiina, did you hear it?"
},
{
"n": 85,
"h": "9c515849",
"en_raw": "No"
},
{
"n": 86,
"h": "fef729ea",
"en_raw": "Maybe I imagined it..."
},
{
"n": 87,
"h": "3fecbce9",
"en_raw": "Or maybe there really were"
},
{
"n": 88,
"h": "541b88f4",
"en_raw": "kids playing?"
},
{
"n": 89,
"h": "669463fc",
"en_raw": "I don't know..."
},
{
"n": 90,
"h": "dd81c1fd",
"en_raw": "But we have to pay respects"
},
{
"n": 91,
"h": "8e269449",
"en_raw": "properly"
},
{
"n": 92,
"h": "fb8dc857",
"en_raw": "Kurumi was right after all"
},
{
"n": 93,
"h": "e57b49e2",
"en_raw": "Sango, let's do it, paying respects"
},
{
"n": 94,
"h": "cd1451a7",
"en_raw": "Tch"
},
{
"n": 95,
"h": "ded22672",
"en_raw": "I feel kind of left out..."
},
{
"n": 96,
"h": "ff815429",
"en_raw": "What are we supposed to do, exactly?"
},
{
"n": 97,
"h": "acb881ef",
"en_raw": "Um, like buy flowers..."
},
{
"n": 98,
"h": "952012db",
"en_raw": "You're not going to say incense too, are you"
},
{
"n": 99,
"h": "5f2dd459",
"en_raw": "Sango seems to know better"
},
{
"n": 100,
"h": "29385193",
"en_raw": "Hey, are you serious?"
},
{
"n": 101,
"h": "2d25845a",
"en_raw": "Everyone, let's each get"
},
{
"n": 102,
"h": "e429320b",
"en_raw": "the things we need"
},
{
"n": 103,
"h": "bcd84d83",
"en_raw": "Yay, paying respects!"
},
{
"n": 104,
"h": "321eedb7",
"en_raw": "You've got to be kidding..."
},
{
"n": 105,
"h": "bcd84d83",
"en_raw": "Yay, paying respects!"
},
{
"n": 106,
"h": "aeeb66d5",
"en_raw": "Paying respects, honestly"
},
{
"n": 107,
"h": "2dfdb865",
"en_raw": "why such a gloomy thing"
},
{
"n": 108,
"h": "cfe02bd6",
"en_raw": "while walking the dog?"
},
{
"n": 109,
"h": "b1d53643",
"en_raw": "I'll go buy flowers!"
},
{
"n": 110,
"h": "7172c930",
"en_raw": "Someone stop these two"
},
{
"n": 111,
"h": "d3bcd41b",
"en_raw": "What's wrong, Shiina?"
},
{
"n": 112,
"h": "d13958fb",
"en_raw": "She's sulking"
},
{
"n": 113,
"h": "a504adfa",
"en_raw": "Because she's the only one without"
},
{
"n": 114,
"h": "af03ea9e",
"en_raw": "paying-respects items"
},
{
"n": 115,
"h": "749ff48e",
"en_raw": "Nao and Sango"
},
{
"n": 116,
"h": "a7974758",
"en_raw": "are unfair"
},
{
"n": 117,
"h": "2bf485cd",
"en_raw": "Kurumi wants to"
},
{
"n": 118,
"h": "7f240b6a",
"en_raw": "pay respects properly too"
},
{
"n": 119,
"h": "217445ff",
"en_raw": "Shiina, it's the thought that counts"
},
{
"n": 120,
"h": "f0cb7e18",
"en_raw": "You're saying something"
},
{
"n": 121,
"h": "3d04ac19",
"en_raw": "not like you, Sango..."
},
{
"n": 122,
"h": "9e7fe8fa",
"en_raw": "What?"
},
{
"n": 123,
"h": "852b6f62",
"en_raw": "Kurumi will go buy some now!"
},
{
"n": 124,
"h": "67918aa0",
"en_raw": "Something better for paying respects!"
},
{
"n": 125,
"h": "e2960871",
"en_raw": "Shiina, what are you going to buy?"
},
{
"n": 126,
"h": "dc0c27c3",
"en_raw": "A shop that sells good things"
},
{
"n": 127,
"h": "62161a2f",
"en_raw": "Kurumi's secret shop"
},
{
"n": 128,
"h": "86b08608",
"en_raw": "by the school slope"
},
{
"n": 129,
"h": "6eef524e",
"en_raw": "you can get there next to the greengrocer"
},
{
"n": 130,
"h": "8f96dee3",
"en_raw": "Incense"
},
{
"n": 131,
"h": "390f79ca",
"en_raw": "Flowers"
},
{
"n": 132,
"h": "c50a4ac9",
"en_raw": "Hee hee, this"
},
{
"n": 133,
"h": "ce1e876a",
"en_raw": "Weirdly colored sweets"
},
{
"n": 134,
"h": "710927aa",
"en_raw": "Okay, then"
},
{
"n": 135,
"h": "bdfd3b4b",
"en_raw": "now nobody can complain, right?"
},
{
"n": 136,
"h": "6677278a",
"en_raw": "Yeah"
},
{
"n": 137,
"h": "775fb317",
"en_raw": "Paying respects"
},
{
"n": 138,
"h": "082e1d42",
"en_raw": "...Hold on!"
},
{
"n": 139,
"h": "5bf17142",
"en_raw": "I have a complaint"
},
{
"n": 140,
"h": "d3b7f58e",
"en_raw": "Why did I have to do"
},
{
"n": 141,
"h": "18df70ad",
"en_raw": "this?"
},
{
"n": 142,
"h": "c7cd1b43",
"en_raw": "Paying respects is normal"
},
{
"n": 143,
"h": "1bbcce68",
"en_raw": "It's normal, Sango"
},
{
"n": 144,
"h": "1471c115",
"en_raw": "It's the vacant lot of the burnt site, right?"
},
{
"n": 145,
"h": "40df4c54",
"en_raw": "Behind the waterworks..."
},
{
"n": 146,
"h": "48ca2c52",
"en_raw": "Come on, let's just get it over with"
},
{
"n": 147,
"h": "4663a99d",
"en_raw": "Hey Nao, I'll ask once more"
},
{
"n": 148,
"h": "649db074",
"en_raw": "did you really hear it?"
},
{
"n": 149,
"h": "972871a2",
"en_raw": "That child's spirit's... voice?"
},
{
"n": 150,
"h": "056d6fb3",
"en_raw": "I think so"
},
{
"n": 151,
"h": "b734f7ed",
"en_raw": "Not 'I think', is it really true?"
},
{
"n": 152,
"h": "d7e1e0b2",
"en_raw": "...Yeah"
},
{
"n": 153,
"h": "497734fb",
"en_raw": "So if we do just this"
},
{
"n": 154,
"h": "5c49fbd7",
"en_raw": "you think that sort of thing will stop?"
},
{
"n": 155,
"h": "0ae936fe",
"en_raw": "I'm sure it will"
},
{
"n": 156,
"h": "da859be1",
"en_raw": "...You know, you're"
},
{
"n": 157,
"h": "54f27c05",
"en_raw": "a lucky guy"
},
{
"n": 158,
"h": "fb8b191e",
"en_raw": "You think so?"
},
{
"n": 159,
"h": "c866bfba",
"en_raw": "Yes, paying respects"
},
{
"n": 160,
"h": "bb706ded",
"en_raw": "Sango had fun too"
},
{
"n": 161,
"h": "1e3c635a",
"en_raw": "You just did what you"
},
{
"n": 162,
"h": "9eb9c6f1",
"en_raw": "wanted to do, didn't you?"
},
{
"n": 163,
"h": "a1b06c5b",
"en_raw": "But Cookie-chan can sleep now"
},
{
"n": 164,
"h": "7e4aeca1",
"en_raw": "She'll forget anyway"
},
{
"n": 165,
"h": "3bd22f9b",
"en_raw": "That's not true"
},
{
"n": 166,
"h": "110d2d8b",
"en_raw": "Good for you, Shiina"
},
{
"n": 167,
"h": "59f2d7b9",
"en_raw": "Nao is, you know, Nao is"
},
{
"n": 168,
"h": "54897795",
"en_raw": "kind"
},
{
"n": 169,
"h": "316e12af",
"en_raw": "Solved the rumor of the Burnt Ruins"
},
{
"n": 170,
"h": "f8fd1b64",
"en_raw": "About this rumor"
},
{
"n": 171,
"h": "bc6d6610",
"en_raw": "there's actually a huge twist"
},
{
"n": 172,
"h": "82e6a389",
"en_raw": "That fire, actually"
},
{
"n": 173,
"h": "13016914",
"en_raw": "nobody died at all"
},
{
"n": 174,
"h": "92f505e2",
"en_raw": "So the child spirits"
},
{
"n": 175,
"h": "4b2b11a2",
"en_raw": "are of course a hoax"
},
{
"n": 176,
"h": "3fa7b4d7",
"en_raw": "The spirit's voice was Nao mishearing"
},
{
"n": 177,
"h": "4d5602a8",
"en_raw": "But Kurumi had fun"
},
{
"n": 178,
"h": "934df03f",
"en_raw": "...Right, Nao?"
},
{
"n": 179,
"h": "14f5784c",
"en_raw": "Enough, drop it"
},
{
"n": 180,
"h": "da16b673",
"en_raw": "Let's talk about something else already!"
}
]
}