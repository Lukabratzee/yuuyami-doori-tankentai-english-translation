"lines": [
{
"n": 0,
"h": "80585de1",
"en_raw": "Kasuka-chan?"
},
{
"n": 1,
"h": "9c4ab485",
"en_raw": "She's here"
},
{
"n": 2,
"h": "68eb40c4",
"en_raw": "I can't see her"
},
{
"n": 3,
"h": "be1bc86f",
"en_raw": "It's okay, Kasuka"
},
{
"n": 4,
"h": "0737bc4f",
"en_raw": "will be gone soon..."
},
{
"n": 5,
"h": "aaa32b33",
"en_raw": "Why? Kasuka"
},
{
"n": 6,
"h": "cd797f33",
"en_raw": "...You see"
},
{
"n": 7,
"h": "bf8205cb",
"en_raw": "Long, long ago"
},
{
"n": 8,
"h": "bb88a326",
"en_raw": "they built a bridge and a flood came"
},
{
"n": 9,
"h": "a3dad90a",
"en_raw": "it was terrible"
},
{
"n": 10,
"h": "f6d84449",
"en_raw": "Kasuka was an offering"
},
{
"n": 11,
"h": "de9b6537",
"en_raw": "and then everyone"
},
{
"n": 12,
"h": "1b7944e3",
"en_raw": "remembered her for ages..."
},
{
"n": 13,
"h": "9f0fe914",
"en_raw": "Hey, you know! Kurumi!"
},
{
"n": 14,
"h": "1a72f13c",
"en_raw": "came to play with Kasuka!"
},
{
"n": 15,
"h": "a022a7a8",
"en_raw": "Yeah, thank you"
},
{
"n": 16,
"h": "82a915eb",
"en_raw": "...It's been fun until now"
},
{
"n": 17,
"h": "1428c084",
"en_raw": "Kasuka, where!?"
},
{
"n": 18,
"h": "b6556d99",
"en_raw": "The girl with the hat"
},
{
"n": 19,
"h": "d5f3d1f6",
"en_raw": "everyone will surely never forget"
},
{
"n": 20,
"h": "78314a97",
"en_raw": "Kasuka!?"
},
{
"n": 21,
"h": "eed0b48d",
"en_raw": "Forever, ever..."
}
]
