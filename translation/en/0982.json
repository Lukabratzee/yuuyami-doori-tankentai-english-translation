"lines": [
{
"n": 0,
"h": "54dc8c9d",
"en_raw": "Ah, Nao, lots of cats"
},
{
"n": 1,
"h": "a8432587",
"en_raw": "sunbathing"
},
{
"n": 2,
"h": "a79b002a",
"en_raw": "Kind of creepy..."
},
{
"n": 3,
"h": "d25609e8",
"en_raw": "There really are a lot"
},
{
"n": 4,
"h": "81b9dc1e",
"en_raw": "But they don't run, and hardly"
},
{
"n": 5,
"h": "c53d52e9",
"en_raw": "move"
},
{
"n": 6,
"h": "16e7b57e",
"en_raw": "They must all be"
},
{
"n": 7,
"h": "4756812c",
"en_raw": "sleepy"
},
{
"n": 8,
"h": "fab6aead",
"en_raw": "There are cat pictures drawn on them"
},
{
"n": 9,
"h": "9b2e81df",
"en_raw": "Cat votive plaques are rare"
},
{
"n": 10,
"h": "9c236602",
"en_raw": "Is that why it's full of cats here?"
},
{
"n": 11,
"h": "c74e5474",
"en_raw": "Found Jiji cat"
},
{
"n": 12,
"h": "ee5d9e7e",
"en_raw": "Don't run away"
},
{
"n": 13,
"h": "18fab0f9",
"en_raw": "I am Great Avatar Nekohazama"
},
{
"n": 14,
"h": "e10c9be0",
"en_raw": "the wild cat god who lived 404 years"
},
{
"n": 15,
"h": "05c641ed",
"en_raw": "who has guarded Hirumi since ancient times"
},
{
"n": 16,
"h": "731c84cb",
"en_raw": "...Child of man"
},
{
"n": 17,
"h": "d1df4e31",
"en_raw": "By what art"
},
{
"n": 18,
"h": "b72d10ca",
"en_raw": "did you enter Nekohazama?"
},
{
"n": 19,
"h": "a1626af4",
"en_raw": "I just came a bit late"
},
{
"n": 20,
"h": "2933468a",
"en_raw": "I see..."
},
{
"n": 21,
"h": "d0d7ca98",
"en_raw": "But this place"
},
{
"n": 22,
"h": "9506ecdc",
"en_raw": "is sanctified from the mundane"
},
{
"n": 23,
"h": "fbcbb837",
"en_raw": "a seat of the gods..."
},
{
"n": 24,
"h": "276d5647",
"en_raw": "Leave at once"
},
{
"n": 25,
"h": "26e73aaa",
"en_raw": "Why?"
},
{
"n": 26,
"h": "5d2db7c4",
"en_raw": "Do not ask"
},
{
"n": 27,
"h": "7337fa9b",
"en_raw": "Then Kurumi won't go"
},
{
"n": 28,
"h": "3b3fc170",
"en_raw": "I see, then"
},
{
"n": 29,
"h": "6cfe2d61",
"en_raw": "do you intend not to answer?"
},
{
"n": 30,
"h": "23ce3bc4",
"en_raw": "...Then"
},
{
"n": 31,
"h": "e4131cf5",
"en_raw": "...Wind of dusk, wrap around"
},
{
"n": 32,
"h": "1e3b14c7",
"en_raw": "and tumble, fall..."
},
{
"n": 33,
"h": "c76a9d45",
"en_raw": "...?"
},
{
"n": 34,
"h": "29264dac",
"en_raw": "...Bonfire, light up"
},
{
"n": 35,
"h": "6aa6a76e",
"en_raw": "and flicker, rise..."
},
{
"n": 36,
"h": "496fc628",
"en_raw": "I feel kind of warm"
},
{
"n": 37,
"h": "c4d7bb58",
"en_raw": "...Burn, flow"
},
{
"n": 38,
"h": "b5b39334",
"en_raw": "eyes, close..."
},
{
"n": 39,
"h": "a2bbfa34",
"en_raw": "Mm~, Kurumi"
},
{
"n": 40,
"h": "60bb023f",
"en_raw": "is sleepy..."
},
{
"n": 41,
"h": "ddc39092",
"en_raw": "Leave at once..."
},
{
"n": 42,
"h": "b088ee38",
"en_raw": "Huh, they're leaving?"
},
{
"n": 43,
"h": "7650f6ec",
"en_raw": "How vexing..."
},
{
"n": 44,
"h": "3b68a0e4",
"en_raw": "To be known by a child of man"
},
{
"n": 45,
"h": "b6ab6b93",
"en_raw": "The ancient rite, the feast"
},
{
"n": 46,
"h": "44c3d584",
"en_raw": "should have ended today, but..."
},
{
"n": 47,
"h": "71e83826",
"en_raw": "Hmm,"
},
{
"n": 48,
"h": "d8398314",
"en_raw": "why were you able to know?"
},
{
"n": 49,
"h": "4d638946",
"en_raw": "Are you not"
},
{
"n": 50,
"h": "620dc007",
"en_raw": "a child of man?"
},
{
"n": 51,
"h": "97ba18d9",
"en_raw": "Kurumi is Kurumi"
},
{
"n": 52,
"h": "3764dd8c",
"en_raw": "......"
},
{
"n": 53,
"h": "f2e83da4",
"en_raw": "Hey hey, kinked tail"
},
{
"n": 54,
"h": "d5c93c47",
"en_raw": "do a cat fortune for Kurumi!"
},
{
"n": 55,
"h": "b7a56395",
"en_raw": "No no, you'll die, you'll die"
},
{
"n": 56,
"h": "227e77dd",
"en_raw": "Go home, go home... hmph"
},
{
"n": 57,
"h": "fcf8fcea",
"en_raw": "Wait, child of man"
},
{
"n": 58,
"h": "52c661d1",
"en_raw": "I cannot let you leave in silence"
},
{
"n": 59,
"h": "46d88741",
"en_raw": "...Ah!"
},
{
"n": 60,
"h": "7b796233",
"en_raw": "What?"
},
{
"n": 61,
"h": "8101ee78",
"en_raw": "Kinked tail!"
},
{
"n": 62,
"h": "e158cd6f",
"en_raw": "I am a nekomata"
},
{
"n": 63,
"h": "fd2093be",
"en_raw": "How disrespectful, child of man"
},
{
"n": 64,
"h": "3719abfe",
"en_raw": "Bonfire, light up..."
},
{
"n": 65,
"h": "ae75e012",
"en_raw": "We don't need that anymore"
},
{
"n": 66,
"h": "f2e83da4",
"en_raw": "Hey hey, kinked tail"
},
{
"n": 67,
"h": "33dd88a6",
"en_raw": "I am a nekomata"
},
{
"n": 68,
"h": "86f28495",
"en_raw": "Do not make me repeat myself"
},
{
"n": 69,
"h": "e23bee81",
"en_raw": "I don't know that"
},
{
"n": 70,
"h": "1c4f7279",
"en_raw": "You're kinked tail"
},
{
"n": 71,
"h": "855d1a3d",
"en_raw": "Hmm..."
},
{
"n": 72,
"h": "ee22bbed",
"en_raw": "Stop it, Shiina"
},
{
"n": 73,
"h": "6be1266e",
"en_raw": "The cat doesn't like it"
},
{
"n": 74,
"h": "2a5b607c",
"en_raw": "Shiina"
},
{
"n": 75,
"h": "bed8c510",
"en_raw": "Aren't you done with cat fortune?"
},
{
"n": 76,
"h": "54332bb3",
"en_raw": "Ah, I forgot!"
},
{
"n": 77,
"h": "8283029b",
"en_raw": "Hey hey, kinked tail"
},
{
"n": 78,
"h": "2a5b607c",
"en_raw": "Shiina"
},
{
"n": 79,
"h": "bed8c510",
"en_raw": "Aren't you done with cat fortune?"
},
{
"n": 80,
"h": "54332bb3",
"en_raw": "Ah, I forgot!"
},
{
"n": 81,
"h": "9394cd1e",
"en_raw": "I did it"
},
{
"n": 82,
"h": "33dd88a6",
"en_raw": "I am a nekomata"
},
{
"n": 83,
"h": "aaa84ff3",
"en_raw": "Do a cat fortune for Kurumi!"
},
{
"n": 84,
"h": "724f4874",
"en_raw": "Ugh, go home, go home"
},
{
"n": 85,
"h": "2aa0d6c5",
"en_raw": "I've gotten sleepy..."
},
{
"n": 86,
"h": "56c65fd5",
"en_raw": "...Fortune?"
}
]
}