"lines": [
{
"n": 0,
"h": "455e9eb4",
"en_raw": "Sorry, I have"
},
{
"n": 1,
"h": "9b7b35fe",
"en_raw": "something to do..."
},
{
"n": 2,
"h": "baeb2477",
"en_raw": "Hey Murase"
},
{
"n": 3,
"h": "824687fc",
"en_raw": "The other night"
},
{
"n": 4,
"h": "430a27e1",
"en_raw": "didn't you hear an ambulance?"
},
{
"n": 5,
"h": "1ef08366",
"en_raw": "Oh, now that you mention it..."
},
{
"n": 6,
"h": "d672a720",
"en_raw": "Segawa?"
},
{
"n": 7,
"h": "7b4a568c",
"en_raw": "Oh, Murase"
},
{
"n": 8,
"h": "824687fc",
"en_raw": "The other night"
},
{
"n": 9,
"h": "430a27e1",
"en_raw": "didn't you hear an ambulance?"
},
{
"n": 10,
"h": "ed94266f",
"en_raw": "...Did you hear?"
},
{
"n": 11,
"h": "a3be7d9f",
"en_raw": "No, I didn't hear it"
},
{
"n": 12,
"h": "9f0852ef",
"en_raw": "My mom said"
},
{
"n": 13,
"h": "6494cf5a",
"en_raw": "our dog imitated the siren"
},
{
"n": 14,
"h": "27ce82f3",
"en_raw": "and howled"
},
{
"n": 15,
"h": "222f0803",
"en_raw": "...That was it"
},
{
"n": 16,
"h": "421c45f3",
"en_raw": "There was a traffic accident"
},
{
"n": 17,
"h": "b0d47b13",
"en_raw": "near the station, it seems"
},
{
"n": 18,
"h": "9fa39a8c",
"en_raw": "I saw a bit on the news"
},
{
"n": 19,
"h": "ced94023",
"en_raw": "That place was really dark"
},
{
"n": 20,
"h": "1f5c860a",
"en_raw": "and the car didn't notice"
},
{
"n": 21,
"h": "16e462e1",
"en_raw": "a woman lying in the road"
},
{
"n": 22,
"h": "f8f61d53",
"en_raw": "and ran her over..."
},
{
"n": 23,
"h": "95c2d764",
"en_raw": "That woman"
},
{
"n": 24,
"h": "85def84e",
"en_raw": "died, they say"
},
{
"n": 25,
"h": "6fc36085",
"en_raw": "...Huh"
},
{
"n": 26,
"h": "6f4f1214",
"en_raw": "Somehow, that underpass"
},
{
"n": 27,
"h": "8a9ed16a",
"en_raw": "has so many accidents"
},
{
"n": 28,
"h": "d5224ef6",
"en_raw": "I try not to go through it"
},
{
"n": 29,
"h": "0290d4aa",
"en_raw": "if I can..."
},
{
"n": 30,
"h": "78d6a3c2",
"en_raw": "It's not like I'm scared"
},
{
"n": 31,
"h": "ec274112",
"en_raw": "like the girls, but..."
},
{
"n": 32,
"h": "108eedbf",
"en_raw": "Not interested?"
},
{
"n": 33,
"h": "69fda0d4",
"en_raw": "I see, sorry..."
}
]
}