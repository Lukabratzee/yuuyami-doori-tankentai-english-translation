"lines": [
{
"n": 0,
"h": "2509d88f",
"en_raw": "Sorry, I just"
},
{
"n": 1,
"h": "2a8de5f6",
"en_raw": "I have something to do..."
},
{
"n": 2,
"h": "0892df76",
"en_raw": "Sanjo's circle"
},
{
"n": 3,
"h": "029d4401",
"en_raw": "always seems lively"
},
{
"n": 4,
"h": "f5397d8f",
"en_raw": "Not really"
},
{
"n": 5,
"h": "43ffd2bf",
"en_raw": "Today it's a scary story"
},
{
"n": 6,
"h": "774f368e",
"en_raw": "Hey Murase"
},
{
"n": 7,
"h": "ee28fef0",
"en_raw": "On the Hirumi Station side far from the police box"
},
{
"n": 8,
"h": "b1cc0228",
"en_raw": "do you go through the underpass often?"
},
{
"n": 9,
"h": "39f297ab",
"en_raw": "What's today's story?"
},
{
"n": 10,
"h": "c962f24b",
"en_raw": "Oh, Murase"
},
{
"n": 11,
"h": "ee28fef0",
"en_raw": "On the Hirumi Station side far from the police box"
},
{
"n": 12,
"h": "b1cc0228",
"en_raw": "do you go through the underpass often?"
},
{
"n": 13,
"h": "c4df8268",
"en_raw": "Why?"
},
{
"n": 14,
"h": "d6f441fe",
"en_raw": "My junior, on her way home from club"
},
{
"n": 15,
"h": "f41cb4b7",
"en_raw": "passed through that place"
},
{
"n": 16,
"h": "9962790f",
"en_raw": "and said someone called out from behind"
},
{
"n": 17,
"h": "e1fd3c7d",
"en_raw": "and made a huge fuss"
},
{
"n": 18,
"h": "b9b73df3",
"en_raw": "It's a common story"
},
{
"n": 19,
"h": "d5e942c6",
"en_raw": "Me, you know"
},
{
"n": 20,
"h": "6e03907a",
"en_raw": "I don't believe in ghosts"
},
{
"n": 21,
"h": "2c96daeb",
"en_raw": "so even when I heard that"
},
{
"n": 22,
"h": "e8964b80",
"en_raw": "I thought it was silly"
},
{
"n": 23,
"h": "59642d93",
"en_raw": "So I walked home with"
},
{
"n": 24,
"h": "a3b7eedc",
"en_raw": "the junior who wanted company"
},
{
"n": 25,
"h": "54a9166b",
"en_raw": "taking a detour on purpose"
},
{
"n": 26,
"h": "e6075de6",
"en_raw": "to go through there, but..."
},
{
"n": 27,
"h": "629c9319",
"en_raw": "...Nothing happened, right?"
},
{
"n": 28,
"h": "7607fba6",
"en_raw": "No, that's the thing"
},
{
"n": 29,
"h": "c8743d2e",
"en_raw": "as we walked"
},
{
"n": 30,
"h": "85c75bd7",
"en_raw": "it gradually felt strange"
},
{
"n": 31,
"h": "7e29c7bb",
"en_raw": "and I was thinking 'ugh'"
},
{
"n": 32,
"h": "13583e46",
"en_raw": "when suddenly, aaaah!"
},
{
"n": 33,
"h": "caed8e15",
"en_raw": "my junior started screaming"
},
{
"n": 34,
"h": "efe6d8b4",
"en_raw": "Even Sanjo was startled"
},
{
"n": 35,
"h": "70eac216",
"en_raw": "and ran full speed"
},
{
"n": 36,
"h": "930c0133",
"en_raw": "...Ha ha, that's a bit unexpected"
},
{
"n": 37,
"h": "cf5567dd",
"en_raw": "Murase,"
},
{
"n": 38,
"h": "8c346b7f",
"en_raw": "believe it or not, it's up to you"
},
{
"n": 39,
"h": "deff94a6",
"en_raw": "but that underpass in particular"
},
{
"n": 40,
"h": "2979001b",
"en_raw": "is definitely bad news"
},
{
"n": 41,
"h": "a941594b",
"en_raw": "There's definitely something"
},
{
"n": 42,
"h": "d324489b",
"en_raw": "I don't know what it is"
},
{
"n": 43,
"h": "753caa66",
"en_raw": "either, but"
},
{
"n": 44,
"h": "5aa57937",
"en_raw": "I'm sure it can be explained"
},
{
"n": 45,
"h": "38d9d31d",
"en_raw": "Hmm, then explain it"
},
{
"n": 46,
"h": "54365a7a",
"en_raw": "and put a frail girl's mind"
},
{
"n": 47,
"h": "0869967f",
"en_raw": "at ease"
},
{
"n": 48,
"h": "7de8966c",
"en_raw": "Obtained the rumor of the Underpass Ghost..."
},
{
"n": 49,
"h": "7b40f794",
"en_raw": "Somehow, about that place"
},
{
"n": 50,
"h": "1dd23226",
"en_raw": "Just talking like this"
},
{
"n": 51,
"h": "bcea9a62",
"en_raw": "I feel like I'm doing something wrong"
},
{
"n": 52,
"h": "2d6fc450",
"en_raw": "Hey, Sanjo"
},
{
"n": 53,
"h": "ad49992d",
"en_raw": "About what we were saying..."
},
{
"n": 54,
"h": "f1cb8bfa",
"en_raw": "I'm getting goosebumps"
},
{
"n": 55,
"h": "cce05598",
"en_raw": "Let's stop this story..."
}
]
}