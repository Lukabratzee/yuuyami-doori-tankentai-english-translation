],
"lines": [
{
"n": 0,
"h": "fb284e95",
"en_raw": "Hey Murase, you"
},
{
"n": 1,
"h": "9e78abf9",
"en_raw": "got asked by Sanjo, didn't you?"
},
{
"n": 2,
"h": "d3f69c80",
"en_raw": "Yeah, about the construction site"
},
{
"n": 3,
"h": "e231bc9d",
"en_raw": "You'd better stay away"
},
{
"n": 4,
"h": "c4df8268",
"en_raw": "Why?"
},
{
"n": 5,
"h": "5fda51bd",
"en_raw": "Seems like you really want to die"
},
{
"n": 6,
"h": "be974c5d",
"en_raw": "What are you saying?"
},
{
"n": 7,
"h": "ee56cd58",
"en_raw": "You see, that place"
},
{
"n": 8,
"h": "35a4ffb8",
"en_raw": "used to be a graveyard"
},
{
"n": 9,
"h": "5409c9a2",
"en_raw": "and you dug it up..."
},
{
"n": 10,
"h": "11770434",
"en_raw": "That's a lie"
},
{
"n": 11,
"h": "84a3cd3d",
"en_raw": "I've played"
},
{
"n": 12,
"h": "4e2696c2",
"en_raw": "there before"
},
{
"n": 13,
"h": "2cf444f0",
"en_raw": "It was a small forest, I'm sure"
},
{
"n": 14,
"h": "c680261b",
"en_raw": "No"
},
{
"n": 15,
"h": "c789c66d",
"en_raw": "It was way earlier"
},
{
"n": 16,
"h": "90870e46",
"en_raw": "You really don't know anything"
},
{
"n": 17,
"h": "e4208c08",
"en_raw": "I don't know as little"
},
{
"n": 18,
"h": "125e5ef8",
"en_raw": "as you think, Yuasa"
},
{
"n": 19,
"h": "dc6d1837",
"en_raw": "That place was definitely"
},
{
"n": 20,
"h": "4430de4c",
"en_raw": "never a graveyard"
},
{
"n": 21,
"h": "0a527adc",
"en_raw": "Shut up, anyway"
},
{
"n": 22,
"h": "3c77d83f",
"en_raw": "stay away for sure"
},
{
"n": 23,
"h": "941b1f0e",
"en_raw": "The mystery of the construction site"
},
{
"n": 24,
"h": "7bb8b982",
"en_raw": "is mine to solve"
},
{
"n": 25,
"h": "b36993fb",
"en_raw": "You should have said so"
},
{
"n": 26,
"h": "82cd6714",
"en_raw": "from the start"
},
{
"n": 27,
"h": "c1fbc92e",
"en_raw": "Hey, Murase"
},
{
"n": 28,
"h": "843e0e37",
"en_raw": "Since then"
},
{
"n": 29,
"h": "a5b5cf3c",
"en_raw": "you've got a big attitude"
},
{
"n": 30,
"h": "c70de543",
"en_raw": "That's right, I'll flush you down the drain"
}
]
}