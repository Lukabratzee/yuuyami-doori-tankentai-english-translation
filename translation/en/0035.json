"lines": [
{
"n": 0,
"h": "2a787e45",
"en_raw": "What do you think, anyway?"
},
{
"n": 1,
"h": "7b58679d",
"en_raw": "About what?"
},
{
"n": 2,
"h": "53d5c873",
"en_raw": "The cursed antique shop story"
},
{
"n": 3,
"h": "0425d747",
"en_raw": "...It's just a rumor, right?"
},
{
"n": 4,
"h": "f0c02cc4",
"en_raw": "A necklace that strangles you"
},
{
"n": 5,
"h": "31904164",
"en_raw": "a diamond that kills everyone who owns it"
},
{
"n": 6,
"h": "5fbf521c",
"en_raw": "a skull that rattles"
},
{
"n": 7,
"h": "aad45644",
"en_raw": "at night"
},
{
"n": 8,
"h": "bfc84406",
"en_raw": "Is that what the shop sells?"
},
{
"n": 9,
"h": "8c0a4f25",
"en_raw": "Don't ask me, I don't know"
},
{
"n": 10,
"h": "6572c25c",
"en_raw": "No way"
},
{
"n": 11,
"h": "6338ff1a",
"en_raw": "That idiot Inagaki..."
},
{
"n": 12,
"h": "3eec96f2",
"en_raw": "Why are you convinced all by yourself..."
},
{
"n": 13,
"h": "7aecc5eb",
"en_raw": "But what bugs me is that shop"
},
{
"n": 14,
"h": "d899c9ab",
"en_raw": "It's right next to the used bookstore"
},
{
"n": 15,
"h": "96ee5cfb",
"en_raw": "I often go to"
},
{
"n": 16,
"h": "d4686e08",
"en_raw": "So?"
},
{
"n": 17,
"h": "5f038269",
"en_raw": "I thought I'd drop by"
},
{
"n": 18,
"h": "358af260",
"en_raw": "that's all"
},
{
"n": 19,
"h": "a9082ec8",
"en_raw": "The rumored antique shop is"
},
{
"n": 20,
"h": "19f2f6c0",
"en_raw": "in the building next to"
},
{
"n": 21,
"h": "9ae0c3b4",
"en_raw": "the donut shop by the station"
},
{
"n": 22,
"h": "83f16229",
"en_raw": "I'll stop by the used bookstore too"
},
{
"n": 23,
"h": "ab2e295a",
"en_raw": "No"
},
{
"n": 24,
"h": "0836f377",
"en_raw": "I'm walking Melos right now"
},
{
"n": 25,
"h": "52c81329",
"en_raw": "See, you got scolded"
},
{
"n": 26,
"h": "5be7f594",
"en_raw": "Nao, you"
},
{
"n": 27,
"h": "f721225f",
"en_raw": "look at things so one-sidedly"
},
{
"n": 28,
"h": "e754406a",
"en_raw": "You'd better not"
},
{
"n": 29,
"h": "daaf402d",
"en_raw": "What's that supposed to mean..."
},
{
"n": 30,
"h": "079d8965",
"en_raw": "Getting angry means"
},
{
"n": 31,
"h": "108d54c5",
"en_raw": "there's something"
},
{
"n": 32,
"h": "6ba6e605",
"en_raw": "you feel guilty about"
},
{
"n": 33,
"h": "d28aee6a",
"en_raw": "The old man at the next-door used bookstore"
},
{
"n": 34,
"h": "fbba8ba6",
"en_raw": "might know something"
},
{
"n": 35,
"h": "7231a67b",
"en_raw": "I'll go ask him"
},
{
"n": 36,
"h": "b12478a1",
"en_raw": "True, over ten times"
},
{
"n": 37,
"h": "e3a7e8ca",
"en_raw": "is no small number"
},
{
"n": 38,
"h": "912afa73",
"en_raw": "Inagaki's stories are"
},
{
"n": 39,
"h": "535cd9da",
"en_raw": "more reliable than expected"
},
{
"n": 40,
"h": "f42317b4",
"en_raw": "Hey, what would happen"
},
{
"n": 41,
"h": "9183432e",
"en_raw": "if we told this"
},
{
"n": 42,
"h": "fb22db27",
"en_raw": "to the antique shop clerk?"
},
{
"n": 43,
"h": "32f7c108",
"en_raw": "Stop it, Sango"
},
{
"n": 44,
"h": "5de34d6f",
"en_raw": "They'd call it obstruction of business"
},
{
"n": 45,
"h": "d71e1486",
"en_raw": "Damn, that hurt"
},
{
"n": 46,
"h": "9241e6ce",
"en_raw": "That antique shop"
},
{
"n": 47,
"h": "ef0258be",
"en_raw": "is totally cursed"
},
{
"n": 48,
"h": "52280cc2",
"en_raw": "Don't say that"
},
{
"n": 49,
"h": "771cb5e7",
"en_raw": "it's rude to the shop's people"
},
{
"n": 50,
"h": "698a4f28",
"en_raw": "You're the one who said it!"
},
{
"n": 51,
"h": "3d5cf044",
"en_raw": "...I'm going to find out"
},
{
"n": 52,
"h": "55a3c0d0",
"en_raw": "where that shop's"
},
{
"n": 53,
"h": "54f71352",
"en_raw": "cursed goods"
},
{
"n": 54,
"h": "fb598c48",
"en_raw": "are being stocked from"
},
{
"n": 55,
"h": "9241e6ce",
"en_raw": "That antique shop"
},
{
"n": 56,
"h": "4e1dcc75",
"en_raw": "It's definitely cursed"
},
{
"n": 57,
"h": "ddcbaffd",
"en_raw": "Sango falling"
},
{
"n": 58,
"h": "24d2d211",
"en_raw": "was just a coincidence, wasn't it?"
},
{
"n": 59,
"h": "8a5befa3",
"en_raw": "Anyway, I'm going to investigate"
},
{
"n": 60,
"h": "bdef8e1c",
"en_raw": "that shop again today"
},
{
"n": 61,
"h": "d991c854",
"en_raw": "I knew it, that shop was cursed"
},
{
"n": 62,
"h": "6e726113",
"en_raw": "Solved the rumor of the Cursed Antiques"
},
{
"n": 63,
"h": "0566bb25",
"en_raw": "Anyway"
},
{
"n": 64,
"h": "0f88b158",
"en_raw": "what we proved this time"
},
{
"n": 65,
"h": "f6ac0a31",
"en_raw": "is that Mario Inagaki"
},
{
"n": 66,
"h": "2fefa596",
"en_raw": "might occasionally say"
},
{
"n": 67,
"h": "7cba9d4c",
"en_raw": "something with a bit"
},
{
"n": 68,
"h": "ea019b99",
"en_raw": "of truth mixed in"
},
{
"n": 69,
"h": "50954137",
"en_raw": "...A major discovery"
},
{
"n": 70,
"h": "14f5784c",
"en_raw": "Enough, drop it"
},
{
"n": 71,
"h": "da16b673",
"en_raw": "Let's talk about something else already!"
}
]
}