"lines": [
{
"n": 0,
"h": "9268db09",
"en_raw": "Hey, Murase,"
},
{
"n": 1,
"h": "2e9dc2db",
"en_raw": "long time no see"
},
{
"n": 2,
"h": "47119c88",
"en_raw": "Cheering for soccer today?"
},
{
"n": 3,
"h": "2d6fc450",
"en_raw": "Hey, Sanjo"
},
{
"n": 4,
"h": "c962f24b",
"en_raw": "Oh, Murase"
},
{
"n": 5,
"h": "076ec3b6",
"en_raw": "Yeah, it's the prefectural tournament"
},
{
"n": 6,
"h": "8e2dafde",
"en_raw": "Our soccer club is"
},
{
"n": 7,
"h": "916420b1",
"en_raw": "pretty good"
},
{
"n": 8,
"h": "a30163da",
"en_raw": "Yeah"
},
{
"n": 9,
"h": "c9f534f4",
"en_raw": "By the way, totally"
},
{
"n": 10,
"h": "e47fc047",
"en_raw": "unrelated, but"
},
{
"n": 11,
"h": "5f0311d7",
"en_raw": "did you see the horror special last night?"
},
{
"n": 12,
"h": "69428a2e",
"en_raw": "No..."
},
{
"n": 13,
"h": "20b99cff",
"en_raw": "You see, that program"
},
{
"n": 14,
"h": "1f5eb8db",
"en_raw": "did a will-o'-the-wisp feature"
},
{
"n": 15,
"h": "1f1b7aac",
"en_raw": "and our club got"
},
{
"n": 16,
"h": "de54aab0",
"en_raw": "really excited"
},
{
"n": 17,
"h": "12dcce64",
"en_raw": "Because of TV, everyone"
},
{
"n": 18,
"h": "5692ce8e",
"en_raw": "was talking about will-o'-the-wisps"
},
{
"n": 19,
"h": "98d4f43b",
"en_raw": "And apparently Hirumi City"
},
{
"n": 20,
"h": "d6a47bf2",
"en_raw": "has a few will-o'-the-wisp"
},
{
"n": 21,
"h": "d991c850",
"en_raw": "spots"
},
{
"n": 22,
"h": "a98fcc99",
"en_raw": "Will-o'-the-wisp spots?"
},
{
"n": 23,
"h": "5185932a",
"en_raw": "Funny, right?"
},
{
"n": 24,
"h": "17c2e5b0",
"en_raw": "What I heard from a junior"
},
{
"n": 25,
"h": "e58a8c45",
"en_raw": "was that she saw one on Takadai Street"
},
{
"n": 26,
"h": "58bd6416",
"en_raw": "Murase, do you believe in that stuff?"
},
{
"n": 27,
"h": "38362dcc",
"en_raw": "I don't believe it... I guess"
},
{
"n": 28,
"h": "29e1d201",
"en_raw": "Right, me neither"
},
{
"n": 29,
"h": "3b6ce391",
"en_raw": "Will-o'-the-wisps are surely"
},
{
"n": 30,
"h": "58097d24",
"en_raw": "just misidentified things"
},
{
"n": 31,
"h": "2d6fc450",
"en_raw": "Hey, Sanjo"
},
{
"n": 32,
"h": "441b90a1",
"en_raw": "Well, Murase,"
},
{
"n": 33,
"h": "a619ca35",
"en_raw": "if, just if"
},
{
"n": 34,
"h": "2b8200c0",
"en_raw": "you see a will-o'-the-wisp"
},
{
"n": 35,
"h": "a2b1b7a9",
"en_raw": "tell me too"
},
{
"n": 36,
"h": "33c57f69",
"en_raw": "Then maybe I could"
},
{
"n": 37,
"h": "e08f07ed",
"en_raw": "believe it a little"
},
{
"n": 38,
"h": "9f2b0ede",
"en_raw": "Not interested in that stuff?"
},
{
"n": 39,
"h": "524609ca",
"en_raw": "As the serious Murase"
},
{
"n": 40,
"h": "76484f63",
"en_raw": "Oh, you're a bit scared, aren't you"
},
{
"n": 41,
"h": "32f7660b",
"en_raw": "Hee hee"
}
]
