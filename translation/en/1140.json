"lines": [
{
"n": 0,
"h": "8cd80078",
"en_raw": "Tomoki?"
},
{
"n": 1,
"h": "bf17635e",
"en_raw": "...Of course not"
},
{
"n": 2,
"h": "6985c754",
"en_raw": "Tomoki"
},
{
"n": 3,
"h": "052f5f33",
"en_raw": "is my unrequited love"
},
{
"n": 4,
"h": "8ac3684c",
"en_raw": "I wish the phone ban would end soon"
},
{
"n": 5,
"h": "2311971d",
"en_raw": "Mayu~, phone~!"
},
{
"n": 6,
"h": "ea14ab71",
"en_raw": "It's a guy~!"
},
{
"n": 7,
"h": "4a0886c2",
"en_raw": "He says let's go home together"
},
{
"n": 8,
"h": "1d52e54a",
"en_raw": "How stupid"
},
{
"n": 9,
"h": "6547e93a",
"en_raw": "Why do I"
},
{
"n": 10,
"h": "2c262d34",
"en_raw": "Someone like Nao..."
},
{
"n": 11,
"h": "34cf0292",
"en_raw": "........"
},
{
"n": 12,
"h": "597b17dc",
"en_raw": "Shiina, huh..."
},
{
"n": 13,
"h": "c760b4a0",
"en_raw": "She is cute, after all"
},
{
"n": 14,
"h": "7c7a4a61",
"en_raw": "unlike me"
},
{
"n": 15,
"h": "34cf0292",
"en_raw": "........"
},
{
"n": 16,
"h": "97f1b8d8",
"en_raw": "If only she weren't around"
},
{
"n": 17,
"h": "2fee68b4",
"en_raw": "I'd do anything"
},
{
"n": 18,
"h": "2fb7d400",
"en_raw": "In the end I'm the same"
},
{
"n": 19,
"h": "8667babf",
"en_raw": "Get a grip, me"
},
{
"n": 20,
"h": "195a0a3f",
"en_raw": "If I collapsed"
},
{
"n": 21,
"h": "e147ae97",
"en_raw": "would Nao make that face?"
},
{
"n": 22,
"h": "ddf39ae1",
"en_raw": "I have to finish the Comikomi manuscript"
},
{
"n": 23,
"h": "713e32ac",
"en_raw": "My promise with Tomoki..."
},
{
"n": 24,
"h": "9d542086",
"en_raw": "Tomoki will abandon me"
},
{
"n": 25,
"h": "cd5794ea",
"en_raw": "...There's no way"
},
{
"n": 26,
"h": "35eb68cb",
"en_raw": "Shiina really is cute..."
},
{
"n": 27,
"h": "4c24bf21",
"en_raw": "Then why not act girly?"
},
{
"n": 28,
"h": "e60c24a7",
"en_raw": "Why would I do that..."
},
{
"n": 29,
"h": "bd0e4f3c",
"en_raw": "Aren't you afraid of changing?"
},
{
"n": 30,
"h": "cac02546",
"en_raw": "I just decide my own worth"
},
{
"n": 31,
"h": "de313299",
"en_raw": "but..."
},
{
"n": 32,
"h": "8457a874",
"en_raw": "Nao doesn't like me..."
},
{
"n": 33,
"h": "a1921fd1",
"en_raw": "No, no"
},
{
"n": 34,
"h": "b1fb1c86",
"en_raw": "What I need to think about"
},
{
"n": 35,
"h": "3f1187de",
"en_raw": "isn't that!"
},
{
"n": 36,
"h": "62228a14",
"en_raw": "Mayu~, how long are you sleeping!"
},
{
"n": 37,
"h": "3968eaeb",
"en_raw": "Every single week"
},
{
"n": 38,
"h": "c2638455",
"en_raw": "don't make me say the same thing!"
}
]
