},
{
"n": 14,
"h": "f5850842",
"en_raw": "Shiina's phone number..."
},
{
"n": 15,
"h": "3c12ba41",
"en_raw": "Idiot!"
},
{
"n": 16,
"h": "c6eaa7fa",
"en_raw": "An ambulance!"
},
{
"n": 17,
"h": "dfd14a72",
"en_raw": "...Shiina?"
