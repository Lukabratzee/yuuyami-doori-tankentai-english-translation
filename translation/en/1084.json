},
{
"n": 20,
"h": "2cdc6c68",
"en_raw": "Call Shiina's house and an ambulance"
},
{
"n": 21,
"h": "67ba2422",
"en_raw": "Correct"
},
{
"n": 22,
"h": "c3c91ac3",
"en_raw": "But you stay with Shiina"
},
{
"n": 23,
"h": "67b2a717",
"en_raw": "I can explain faster"
},
{
"n": 24,
"h": "8b5eb15f",
"en_raw": "Fine"
},
{
"n": 25,
"h": "9fd85a19",
"en_raw": "...Damn it"
},
{
"n": 26,
"h": "de43d341",
"en_raw": "If only we had a cell phone"
},
{
"n": 27,
"h": "80188a39",
"en_raw": "The crow's curse?"
},
{
"n": 28,
"h": "e1cf63c8",
"en_raw": "No way, it's a lie..."
},
{
"n": 29,
"h": "b14a8119",
"en_raw": "It's happening again..."
},
{
"n": 30,
"h": "96a3351e",
"en_raw": "...I have to chase it!"
},
{
"n": 31,
"h": "4102c7b0",
"en_raw": "This is bad, Nao..."
},
{
"n": 32,
"h": "4fdee70f",
"en_raw": "We have to search!"
},
{
"n": 33,
"h": "d291a494",
"en_raw": "I'll go, so Sango"
},
{
"n": 34,
"h": "692b67ad",
"en_raw": "call Shiina's house!"
},
{
"n": 35,
"h": "5260e728",
"en_raw": "Shiina?"
},
{
"n": 36,
"h": "90247c3f",
"en_raw": "This smell... blood?"
},
{
"n": 37,
"h": "307be39f",
"en_raw": "Ugh..."
},
{
"n": 38,
"h": "5fe9e964",
"en_raw": "What am I even doing"
},
{
"n": 39,
"h": "3764dd8c",
