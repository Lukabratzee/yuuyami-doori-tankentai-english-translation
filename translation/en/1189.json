{
"file": 1189,
"paths": [
"d010/d001/f094"
],
"lines": [
{
"n": 0,
"h": "deca2e56",
"en_raw": "Huh, that child..."
},
{
"n": 1,
"h": "babdeb00",
"en_raw": "You're..."
},
{
"n": 2,
"h": "80585de1",
"en_raw": "Kasuka-chan?"
},
{
"n": 3,
"h": "bf91f16e",
"en_raw": "A pinwheel spins without wind"
},
{
"n": 4,
"h": "276355f2",
"en_raw": "A ten-yen coin moves by itself"
},
{
"n": 5,
"h": "717c2801",
"en_raw": "A grandma died far away"
},
{
"n": 6,
"h": "c0a645a0",
"en_raw": "And then, and then,"
},
{
"n": 7,
"h": "eae0b614",
"en_raw": "after crying"
},
{
"n": 8,
"h": "6d164927",
"en_raw": "around the light, round and round"
},
{
"n": 9,
"h": "abb1c563",
"en_raw": "the swirling spins..."
},
{
"n": 10,
"h": "719504e8",
"en_raw": "...Shiina"
},
{
"n": 11,
"h": "628a63d4",
"en_raw": "is still collapsed"
},
{
"n": 12,
"h": "36f573de",
"en_raw": "The 100th-day curse..."
},
{
"n": 13,
"h": "6c770b3c",
"en_raw": "At this rate Shiina..."
},
{
"n": 14,
"h": "9fdf811e",
"en_raw": "Feelings don't disappear"
},
{
"n": 15,
"h": "f2708c11",
"en_raw": "Feelings make things move"
},
{
"n": 16,
"h": "8ee37fe4",
"en_raw": "Feelings, you see,"
},
{
"n": 17,
"h": "bd42e6e9",
"en_raw": "cause all sorts of things"
},
{
"n": 18,
"h": "999529b0",
"en_raw": "...good things and bad things"
},
{
"n": 19,
"h": "bf8f8fc0",
"en_raw": "Wait!"
},
{
"n": 20,
"h": "65312395",
"en_raw": "It's the 100th-day curse"
},
{
"n": 21,
"h": "4130374e",
"en_raw": "of the human-faced crow!"
},
{
"n": 22,
"h": "63173f65",
"en_raw": "I..."
},
{
"n": 23,
"h": "c96a34ff",
"en_raw": "I saw it"
},
{
"n": 24,
"h": "5174c335",
"en_raw": "Do you want to know"
},
{
"n": 25,
"h": "f93906e9",
"en_raw": "why the crow cries?"
},
{
"n": 26,
"h": "2882a7cc",
"en_raw": "Then I'll wait for"
},
{
"n": 27,
"h": "66cbb4b9",
"en_raw": "the sun to set"
},
{
"n": 28,
"h": "9f5a4cd4",
"en_raw": "so hurry"
},
{
"n": 29,
"h": "44384b36",
"en_raw": "But I don't understand!"
},
{
"n": 30,
"h": "9cbdf4b2",
"en_raw": "What on earth should I do..."
},
{
"n": 31,
"h": "84bda669",
"en_raw": "Kago-me, kago-me,"
},
{
"n": 32,
"h": "6997599b",
"en_raw": "the bird in the cage,"
},
{
"n": 33,
"h": "f7601669",
"en_raw": "when, when will it come out..."
},
{
"n": 34,
"h": "cc496ec7",
"en_raw": "Go to the back of the wall"
},
{
"n": 35,
"h": "8449c70d",
"en_raw": "big brother"
},
{
"n": 36,
"h": "bfc9e2b3",
"en_raw": "to Kasuka's friend"
},
{
"n": 37,
"h": "6d8c7bab",
"en_raw": "Six more..."
},
{
"n": 38,
"h": "68a9e746",
"en_raw": "If you go around six"
},
{
"n": 39,
"h": "f2513472",
"en_raw": "it's complete..."
},
{
"n": 40,
"h": "2402a0c5",
"en_raw": "If you do that..."
},
{
"n": 41,
"h": "5a81a107",
"en_raw": "the curse will be broken?"
},
{
"n": 42,
"h": "ae51bfc0",
"en_raw": "Giggle"
},
{
"n": 43,
"h": "289fba08",
"en_raw": "Giggle giggle..."
},
{
"n": 44,
"h": "10606860",
"en_raw": "Thoughts circle"
},
{
"n": 45,
"h": "91abdb8b",
"en_raw": "They circle round and round"
}
]
}