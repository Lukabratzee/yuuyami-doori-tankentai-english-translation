{
"file": 278,
"paths": [
"d007/d012/f113"
],
"lines": [
{
"n": 0,
"h": "f276104d",
"en_raw": "...Hey, Murase"
},
{
"n": 1,
"h": "560b2c64",
"en_raw": "Murase, you know"
},
{
"n": 2,
"h": "5e4ef6ab",
"en_raw": "Do you believe in ghosts?"
},
{
"n": 3,
"h": "b63b7b9f",
"en_raw": "What's up, all of a sudden?"
},
{
"n": 4,
"h": "458abe89",
"en_raw": "I want you to answer, please"
},
{
"n": 5,
"h": "bb36647b",
"en_raw": "whether you believe in ghosts..."
},
{
"n": 6,
"h": "e113fdbd",
"en_raw": "Hey, answer properly!"
},
{
"n": 7,
"h": "027c0295",
"en_raw": "...I"
},
{
"n": 8,
"h": "38a35b10",
"en_raw": "don't really believe"
},
{
"n": 9,
"h": "2aa18f4e",
"en_raw": "Hey"
},
{
"n": 10,
"h": "0c8a7d6e",
"en_raw": "What do you mean, 'really'?"
},
{
"n": 11,
"h": "a9ade26a",
"en_raw": "Does that really mean"
},
{
"n": 12,
"h": "89032a24",
"en_raw": "you believe a little?"
},
{
"n": 13,
"h": "3d148f6d",
"en_raw": "Let's stop, Segawa"
},
{
"n": 14,
"h": "a9dc81ce",
"en_raw": "If you see a ghost..."
},
{
"n": 15,
"h": "c7c6673c",
"en_raw": "you get possessed or something..."
},
{
"n": 16,
"h": "0bcf30d2",
"en_raw": "There's no way that happens"
},
{
"n": 17,
"h": "d4e04a07",
"en_raw": "It's fine"
},
{
"n": 18,
"h": "49227703",
"en_raw": "You should calm down a bit"
},
{
"n": 19,
"h": "f6e4079c",
"en_raw": "I meant no harm at all"
},
{
"n": 20,
"h": "aed4a0c6",
"en_raw": "I just went fishing"
},
{
"n": 21,
"h": "25977e8a",
"en_raw": "But never again"
},
{
"n": 22,
"h": "3b790bcc",
"en_raw": "no matter how good the spot is"
},
{
"n": 23,
"h": "dca15630",
"en_raw": "I will never"
},
{
"n": 24,
"h": "4b2caae0",
"en_raw": "go to the Tama River"
},
{
"n": 25,
"h": "c4df8268",
"en_raw": "Why?"
},
{
"n": 26,
"h": "0c6f6820",
"en_raw": "There was one..."
},
{
"n": 27,
"h": "a2a6e735",
"en_raw": "In the evening, a barefoot woman..."
},
{
"n": 28,
"h": "d6c29546",
"en_raw": "It was strange, somehow"
},
{
"n": 29,
"h": "2f670698",
"en_raw": "she didn't seem like a normal person..."
},
{
"n": 30,
"h": "866a91cf",
"en_raw": "And when I passed by her"
},
{
"n": 31,
"h": "a2a4695e",
"en_raw": "I heard a strange voice"
},
{
"n": 32,
"h": "5b0abb24",
"en_raw": "But there was nobody around"
},
{
"n": 33,
"h": "9cbd2a9a",
"en_raw": "except the woman..."
},
{
"n": 34,
"h": "eeaba3b4",
"en_raw": "I ran away in a panic"
},
{
"n": 35,
"h": "7ecfeda1",
"en_raw": "Murase, what should I do?"
},
{
"n": 36,
"h": "f77cf290",
"en_raw": "I might be possessed..."
},
{
"n": 37,
"h": "bed00a63",
"en_raw": "Ha ha, you misheard"
},
{
"n": 38,
"h": "2ba1e798",
"en_raw": "It was a bird or something"
},
{
"n": 39,
"h": "73018af7",
"en_raw": "Murase, your voice is shaking..."
},
{
"n": 40,
"h": "4a256289",
"en_raw": "So last night"
},
{
"n": 41,
"h": "98469ea2",
"en_raw": "I slept with the lights on all night"
},
{
"n": 42,
"h": "b5596c9d",
"en_raw": "Murase"
},
{
"n": 43,
"h": "7cfb3783",
"en_raw": "Don't you have any fun stories?"
},
{
"n": 44,
"h": "7ac10e1d",
"en_raw": "Talking with you, Murase"
},
{
"n": 45,
"h": "49185a83",
"en_raw": "Somehow"
},
{
"n": 46,
"h": "74d8a35e",
"en_raw": "just makes me more and more anxious"
},
{
"n": 47,
"h": "833125f5",
"en_raw": "What should I do..."
}
]
}