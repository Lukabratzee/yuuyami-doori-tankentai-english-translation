"lines": [
{
"n": 0,
"h": "6cd97eb2",
"en_raw": "A miserable, shameful fight"
},
{
"n": 1,
"h": "1de5905a",
"en_raw": "...No"
},
{
"n": 2,
"h": "e0914550",
"en_raw": "it wasn't even a fight"
},
{
"n": 3,
"h": "91cbaecc",
"en_raw": "They planned it that way from the start"
},
{
"n": 4,
"h": "6bf35797",
"en_raw": "those guys"
},
{
"n": 5,
"h": "1367f418",
"en_raw": "I was just"
},
{
"n": 6,
"h": "4bab9c0f",
"en_raw": "played with"
},
{
"n": 7,
"h": "763e514d",
"en_raw": "Nishi looked at me with"
},
{
"n": 8,
"h": "e65bb746",
"en_raw": "pitying eyes"
},
{
"n": 9,
"h": "524fc0f0",
"en_raw": "Yes"
},
{
"n": 10,
"h": "5c5ae033",
"en_raw": "If I were Nishi, guys like them"
},
{
"n": 11,
"h": "17a1e16b",
"en_raw": "I could have beaten"
},
{
"n": 12,
"h": "ab41c0f1",
"en_raw": "to a pulp"
},
{
"n": 13,
"h": "46b7da96",
"en_raw": "I can't even make them apologize"
},
{
"n": 14,
"h": "e3c0efa7",
"en_raw": "for that one remark"
},
{
"n": 15,
"h": "0f77ffed",
"en_raw": "I can't do anything"
},
{
"n": 16,
"h": "2847235e",
"en_raw": "After all, I have no"
},
{
"n": 17,
"h": "e2babe62",
"en_raw": "right to like anyone..."
},
{
"n": 18,
"h": "52b2413c",
"en_raw": "Hey, Sango, not yet?"
},
{
"n": 19,
"h": "07fd0853",
"en_raw": "Nao, Sango's on the phone~"
},
{
"n": 20,
"h": "da36e052",
"en_raw": "Ah, Nao, what's this?"
},
{
"n": 21,
"h": "32011400",
"en_raw": "It's an airplane, a radio-controlled one"
},
{
"n": 22,
"h": "df4394cf",
"en_raw": "...It really flies"
},
{
"n": 23,
"h": "0e833887",
"en_raw": "Eh, fly it, fly it!"
},
{
"n": 24,
"h": "4fb23366",
"en_raw": "Sorry, but not today"
},
{
"n": 25,
"h": "0c87c3f0",
"en_raw": "...because of the rain"
},
{
"n": 26,
"h": "39e8c5a7",
"en_raw": "Stop it"
}
]
}