"file": 117,
"paths": [
"d007/d004/f037"
],
"lines": [
{
"n": 0,
"h": "8b264735",
"en_raw": "Who sees Hanako these days"
},
{
"n": 1,
"h": "03e5debd",
"en_raw": "Well"
},
{
"n": 2,
"h": "7bcdf32a",
"en_raw": "That's idiotic"
},
{
"n": 3,
"h": "8610b8f2",
"en_raw": "Really, such an old story"
},
{
"n": 4,
"h": "b92a9ae6",
"en_raw": "But Yuri"
},
{
"n": 5,
"h": "616f585a",
"en_raw": "that story, I think..."
},
{
"n": 6,
"h": "2b78448f",
"en_raw": "Yeah, actually..."
},
{
"n": 7,
"h": "3322691f",
"en_raw": "Huh, what?"
},
{
"n": 8,
"h": "5ec83ffe",
"en_raw": "I told Sakai this"
},
{
"n": 9,
"h": "a6e11a4e",
"en_raw": "before, didn't I?"
},
{
"n": 10,
"h": "75e993c3",
"en_raw": "Yeah, I guess."
},
{
"n": 11,
"h": "c08a97f9",
"en_raw": "Huh, tell me!"
},
{
"n": 12,
"h": "00ac54c1",
"en_raw": "...Hanako's grave"
},
{
"n": 13,
"h": "29974753",
"en_raw": "What, that's creepy..."
},
{
"n": 14,
"h": "e081ca0d",
"en_raw": "...That Hanako"
},
{
"n": 15,
"h": "903c4490",
"en_raw": "was a real person"
},
{
"n": 16,
"h": "7aebf36a",
"en_raw": "is, right?"
},
{
"n": 17,
"h": "8ac2d73d",
"en_raw": "Then do you know"
},
{
"n": 18,
"h": "b553b699",
"en_raw": "where Hanako lived?"
},
{
"n": 19,
"h": "a3721fcd",
"en_raw": "...No way"
},
{
"n": 20,
"h": "1049ca7e",
"en_raw": "...Is it near here?"
},
{
"n": 21,
"h": "90218a2c",
"en_raw": "Yes, the Tama River, near Hirumi Bridge"
},
{
"n": 22,
"h": "f553b6fb",
"en_raw": "Really?!"
},
{
"n": 23,
"h": "6f751cde",
"en_raw": "But her power is weak now"
},
{
"n": 24,
"h": "fc1097ba",
"en_raw": "so tales of seeing Hanako these days"
},
{
"n": 25,
"h": "cd76c836",
"en_raw": "are all lies"
},
{
"n": 26,
"h": "eabe36df",
"en_raw": "Hey, that grave"
},
{
"n": 27,
"h": "ed835b98",
"en_raw": "is it still there?"
},
{
"n": 28,
"h": "4654d17c",
"en_raw": "...Probably"
},
{
"n": 29,
"h": "efd6dd5f",
"en_raw": "Hey, Iwase"
},
{
"n": 30,
"h": "14e9b603",
"en_raw": "take us there"
},
{
"n": 31,
"h": "1d6a9c33",
"en_raw": "I'm not interested"
},
{
"n": 32,
"h": "8c03e5a2",
"en_raw": "but I can tell you"
},
{
"n": 33,
"h": "a9e364f3",
"en_raw": "how to get there"
},
{
"n": 34,
"h": "6d4c8aae",
"en_raw": "At the crossroads near the Tama River"
},
{
"n": 35,
"h": "acdb25b4",
"en_raw": "ask the first person you meet"
},
{
"n": 36,
"h": "fbe350e1",
"en_raw": "where the grave is"
},
{
"n": 37,
"h": "c993d9c7",
"en_raw": "If you go as they say"
},
{
"n": 38,
"h": "b976233e",
"en_raw": "you should reach the grave"
},
{
"n": 39,
"h": "b11fa86d",
"en_raw": "But"
},
{
"n": 40,
"h": "657f8ccb",
"en_raw": "if you don't say this then"
},
{
"n": 41,
"h": "32ecdb78",
"en_raw": "instead of reaching the grave"
},
{
"n": 42,
"h": "f9a286e6",
"en_raw": "misfortune will strike..."
},
{
"n": 43,
"h": "8e2d4ff5",
"en_raw": "..............."
},
{
"n": 44,
"h": "109ab76b",
"en_raw": "Hey, Yuri"
},
{
"n": 45,
"h": "79d42c06",
"en_raw": "Wait a second"
},
{
"n": 46,
"h": "0cf25e76",
"en_raw": "That one's been"
},
{
"n": 47,
"h": "3546088f",
"en_raw": "eavesdropping, hasn't she?"
},
{
"n": 48,
"h": "67f7daf2",
"en_raw": "That was a very entertaining made-up story"
},
{
"n": 49,
"h": "f4767973",
"en_raw": "Rumor of Hanako's Grave"
},
{
"n": 50,
"h": "18599688",
"en_raw": "obtained!"
},
{
"n": 51,
"h": "8054b128",
"en_raw": "...The worst!"
},
{
"n": 52,
"h": "b8dfa7be",
"en_raw": "Go away!"
},
{
"n": 53,
"h": "b6f9e55f",
"en_raw": "Also"
},
{
"n": 54,
"h": "55cfc89c",
"en_raw": "could you get out of the way?"
},
{
"n": 55,
"h": "f428a00a",
"en_raw": "Thanks to your long chat"
},
{
"n": 56,
"h": "b599d5b5",
"en_raw": "I'm about to leak"
},
{
"n": 57,
"h": "161fd2ad",
"en_raw": "Mayu Hirauchi, was it?"
},
{
"n": 58,
"h": "19862aba",
"en_raw": "The restroom next to the staff room"
},
{
"n": 59,
"h": "ecdc37e4",
"en_raw": "is free"
},
{
"n": 60,
"h": "ec9ba111",
"en_raw": "But be careful, Hirauchi"
},
{
"n": 61,
"h": "8296f8e6",
"en_raw": "You have a face"
},
{
"n": 62,
"h": "439117be",
"en_raw": "that really attracts misfortune"
},
{
"n": 63,
"h": "9feccbd2",
"en_raw": "Thanks for the advice"
},
{
"n": 64,
"h": "2420c2de",
"en_raw": "Guardian ghost"
},
{
"n": 65,
"h": "3bce33c4",
"en_raw": "...Anyway"
},
{
"n": 66,
"h": "2598dddb",
"en_raw": "if you gather there"
},
{
"n": 67,
"h": "efc6db35",
"en_raw": "I can't get in"
},
{
"n": 68,
"h": "d0d62326",
"en_raw": "the bathroom"
},
{
"n": 69,
"h": "161fd2ad",
"en_raw": "Mayu Hirauchi, was it?"
},
{
"n": 70,
"h": "19862aba",
"en_raw": "The restroom next to the staff room"
},
{
"n": 71,
"h": "ecdc37e4",
"en_raw": "is free"
}
]
}