"lines": [
{
"n": 0,
"h": "fe905840",
"en_raw": "Takehiko?"
},
{
"n": 1,
"h": "651af5f6",
"en_raw": "Don't you trust my examination anymore?"
},
{
"n": 2,
"h": "b5b390c4",
"en_raw": "...Listen"
},
{
"n": 3,
"h": "3c6575ce",
"en_raw": "you can't apply"
},
{
"n": 4,
"h": "4ff8154b",
"en_raw": "so-called medical thinking"
},
{
"n": 5,
"h": "dc30d443",
"en_raw": "to Kurumi..."
},
{
"n": 6,
"h": "de941311",
"en_raw": "That's right"
},
{
"n": 7,
"h": "7171d62d",
"en_raw": "If you know, don't make me repeat it"
},
{
"n": 8,
"h": "abde3425",
"en_raw": "But what you say"
},
{
"n": 9,
"h": "3dfbab28",
"en_raw": "is too idealistic"
},
{
"n": 10,
"h": "10740e1d",
"en_raw": "Raising children is a parent's job"
},
{
"n": 11,
"h": "aa90a045",
"en_raw": "We can't"
},
{
"n": 12,
"h": "339bbe58",
"en_raw": "help but face"
},
{
"n": 13,
"h": "b6d9c322",
"en_raw": "reality"
},
{
"n": 14,
"h": "847a8372",
"en_raw": "Something happened..."
},
{
"n": 15,
"h": "f5d55631",
"en_raw": "Is it Masayo?"
},
{
"n": 16,
"h": "00622994",
"en_raw": "Hey, what's wrong?"
},
{
"n": 17,
"h": "fd1fca93",
"en_raw": "Making a pathetic voice"
},
{
"n": 18,
"h": "7a5c1243",
"en_raw": "It's nothing else, it's about Kurumi"
},
{
"n": 19,
"h": "9b1b32ab",
"en_raw": "Oh come on, you're stirring it up again?"
},
{
"n": 20,
"h": "6aaef0db",
"en_raw": "No, I want to ask"
},
{
"n": 21,
"h": "b25aa2a0",
"en_raw": "Can Kurumi be accepted?"
},
{
"n": 22,
"h": "8bb4f7eb",
"en_raw": "Kurumi is..."
},
{
"n": 23,
"h": "3c05d2f9",
"en_raw": "Are you"
},
{
"n": 24,
"h": "ccf256b4",
"en_raw": "denying Kurumi?"
},
{
"n": 25,
"h": "203a83d1",
"en_raw": "It's not about denying"
},
{
"n": 26,
"h": "a0b6ac76",
"en_raw": "If things stay as they are, can she"
},
{
"n": 27,
"h": "c89f6a3e",
"en_raw": "ever be happy, that's..."
}
