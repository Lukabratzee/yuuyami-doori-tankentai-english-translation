"lines": [
{
"n": 0,
"h": "1a421de3",
"en_raw": "Hey Yuri, the portrait artist"
},
{
"n": 1,
"h": "f138cbe9",
"en_raw": "who draws guardian spirits, is he real?"
},
{
"n": 2,
"h": "22125fa0",
"en_raw": "...The one at the Wildflower Garden, right?"
},
{
"n": 3,
"h": "24a37fea",
"en_raw": "No doubt"
},
{
"n": 4,
"h": "c1e69f75",
"en_raw": "I sense it too"
},
{
"n": 5,
"h": "f086c11d",
"en_raw": "Huh, then maybe I should"
},
{
"n": 6,
"h": "1c743ea1",
"en_raw": "get one drawn too"
},
{
"n": 7,
"h": "c889dfdd",
"en_raw": "A picture of the guardian"
},
{
"n": 8,
"h": "e84743fa",
"en_raw": "spirit protecting me"
},
{
"n": 9,
"h": "d0604f32",
"en_raw": "Hey hey, Yuri, you too"
},
{
"n": 10,
"h": "a4d77bc9",
"en_raw": "could have him draw"
},
{
"n": 11,
"h": "6b27a929",
"en_raw": "Lord Tsukuyomi?"
},
{
"n": 12,
"h": "d79d3572",
"en_raw": "No way, no way"
},
{
"n": 13,
"h": "6e6b46be",
"en_raw": "Lord Tsukuyomi must never"
},
{
"n": 14,
"h": "37e9f2f9",
"en_raw": "be shown in public"
},
{
"n": 15,
"h": "c4df8268",
"en_raw": "Why?"
},
{
"n": 16,
"h": "34cf0292",
"en_raw": "........"
},
{
"n": 17,
"h": "91dc0e1a",
"en_raw": "Because of the scar on his face..."
},
{
"n": 18,
"h": "67cb1a2a",
"en_raw": "Long ago, Lord Tsukuyomi"
},
{
"n": 19,
"h": "fd513cba",
"en_raw": "was envied for his beauty"
},
{
"n": 20,
"h": "d4d551e8",
"en_raw": "and had a single line"
},
{
"n": 21,
"h": "9c54ec47",
"en_raw": "cut across his face"
},
{
"n": 22,
"h": "972dc148",
"en_raw": "How sad..."
},
{
"n": 23,
"h": "13da224a",
"en_raw": "The otaku girl is eavesdropping"
},
{
"n": 24,
"h": "6b72514c",
"en_raw": "Day after day, you can talk"
},
{
"n": 25,
"h": "328cf862",
"en_raw": "about the same stuff so long"
},
{
"n": 26,
"h": "7533eaf0",
"en_raw": "Otaku, be quiet"
},
{
"n": 27,
"h": "a1f9d35d",
"en_raw": "You always seem to be having fun"
},
{
"n": 28,
"h": "3a88e2c6",
"en_raw": "By the way, with Lord Tsukuyomi"
},
{
"n": 29,
"h": "00eca5e2",
"en_raw": "there's a girls' manga with"
},
{
"n": 30,
"h": "ca8c5677",
"en_raw": "the same setup, did you know?"
},
{
"n": 31,
"h": "e99bf1d8",
"en_raw": "For lower elementary schoolers"
},
{
"n": 32,
"h": "55e12497",
"en_raw": "......."
},
{
"n": 33,
"h": "6a93d15a",
"en_raw": "There's nothing"
},
{
"n": 34,
"h": "53e81b91",
"en_raw": "I can say to you"
}
]
