"n": 42,
"h": "cef9049f",
"en_raw": "Are you interested in me?"
},
{
"n": 43,
"h": "2acd3596",
"en_raw": "There's nothing on it, is there??"
},
{
"n": 44,
"h": "677db820",
"en_raw": "Students should just go to school."
},
{
"n": 45,
"h": "661e8057",
"en_raw": "Kurumi has never taken a day off"
},
{
"n": 46,
"h": "d54e2289",
