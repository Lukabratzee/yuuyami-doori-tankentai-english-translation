},
{
"n": 47,
"h": "0f35ce2c",
"en_raw": "Okay~"
},
{
"n": 48,
"h": "b4dbe595",
"en_raw": "Hm? On a school field trip?"
},
{
"n": 49,
"h": "82808a59",
"en_raw": "Kurumi"
},
{
"n": 50,
"h": "6257384a",
"en_raw": "I found a frog during science class"
},
{
"n": 51,
"h": "fe138147",
