},
{
"n": 52,
"h": "86a1ad9a",
"en_raw": "I'm no good with dogs..."
},
{
"n": 53,
"h": "b5ec956c",
"en_raw": "Kurumi likes everything"
},
{
"n": 54,
"h": "4bf18c94",
"en_raw": "Oh, a doggy"
},
{
"n": 55,
"h": "3dc6fe96",
"en_raw": "Melos is a boy"
},
{
"n": 56,
"h": "e8f8bc39",
"en_raw": "I want to go to the sea"
},
{
"n": 57,
"h": "82808a59",
"en_raw": "Kurumi"
},
{
"n": 58,
"h": "817fb24d",
