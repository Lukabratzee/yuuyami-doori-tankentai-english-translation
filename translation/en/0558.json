"lines": [
{
"n": 0,
"h": "6a796ed4",
"en_raw": "Welcome home"
},
{
"n": 1,
"h": "09e1cd27",
"en_raw": "After welcome home comes"
},
{
"n": 2,
"h": "42127a58",
"en_raw": "taking off my shoes"
},
{
"n": 3,
"h": "1730be9d",
"en_raw": "and going up into the house"
},
{
"n": 4,
"h": "d885df47",
"en_raw": "Nanako comes to greet me"
},
{
"n": 5,
"h": "152c7443",
"en_raw": "Then I say"
},
{
"n": 6,
"h": "8f6f8976",
"en_raw": "I'm home and go inside..."
},
{
"n": 7,
"h": "272ae9dc",
"en_raw": "No, wait"
},
{
"n": 8,
"h": "6877be2e",
"en_raw": "I'm already"
},
{
"n": 9,
"h": "51802815",
"en_raw": "in the house..."
},
{
"n": 10,
"h": "9f654048",
"en_raw": "Hey hey"
},
{
"n": 11,
"h": "217a1cbf",
"en_raw": "What are you doing?"
},
{
"n": 12,
"h": "2e4c7ad4",
"en_raw": "What do I do to get in the house"
},
{
"n": 13,
"h": "aea1a6ed",
"en_raw": "I've forgotten"
},
{
"n": 14,
"h": "c04ed743",
"en_raw": "Until I remember"
},
{
"n": 15,
"h": "6aaff48f",
"en_raw": "I can't enter the house"
},
{
"n": 16,
"h": "de941311",
"en_raw": "That's right"
},
{
"n": 17,
"h": "ad8922d9",
"en_raw": "I haven't been home in four months..."
},
{
"n": 18,
"h": "fcf14016",
"en_raw": "This project"
},
{
"n": 19,
"h": "bc167306",
"en_raw": "can't"
},
{
"n": 20,
"h": "172ce882",
"en_raw": "be allowed to fail"
},
{
"n": 21,
"h": "97e84b72",
"en_raw": "So I couldn't go home"
},
{
"n": 22,
"h": "b5d7da37",
"en_raw": "Four months... you can forget"
},
{
"n": 23,
"h": "9d3b3491",
"en_raw": "that you used to just go home"
},
{
"n": 24,
"h": "a758d8fb",
"en_raw": "I can't believe it"
},
{
"n": 25,
"h": "0cf6d74a",
"en_raw": "If I say I'm home"
},
{
"n": 26,
"h": "03f1691c",
"en_raw": "will you say welcome back?"
},
{
"n": 27,
"h": "aa1e08e7",
"en_raw": "Ah, I see"
},
{
"n": 28,
"h": "c2ab063e",
"en_raw": "I don't have to think about anything"
},
{
"n": 29,
"h": "4d28615f",
"en_raw": "Right, if I just say I'm home, then..."
},
{
"n": 30,
"h": "73ae8e3c",
"en_raw": "I'm home..."
},
{
"n": 31,
"h": "b4510347",
"en_raw": "When it's this hot"
},
{
"n": 32,
"h": "a76d36b0",
"en_raw": "I can't work"
},
{
"n": 33,
"h": "e90c1c2b",
"en_raw": "School's out, you know"
},
{
"n": 34,
"h": "25abd5cc",
"en_raw": "This summer is hot"
},
{
"n": 35,
"h": "ea84b501",
