"lines": [
{
"n": 0,
"h": "b2ef141b",
"en_raw": "Nao, did you see a tanuki?"
},
{
"n": 1,
"h": "2459c1dd",
"en_raw": "That's not the point right now"
},
{
"n": 2,
"h": "2afc8a80",
"en_raw": "What Sango said was true"
},
{
"n": 3,
"h": "ca2cfd6a",
"en_raw": "...True? Did I"
},
{
"n": 4,
"h": "2008809e",
"en_raw": "say something?"
},
{
"n": 5,
"h": "60d61207",
"en_raw": "A murder scene... no"
},
{
"n": 6,
"h": "cfa38a3c",
"en_raw": "it's worse than that"
},
{
"n": 7,
"h": "0898f2ea",
"en_raw": "That place is a man-eating..."
},
{
"n": 8,
"h": "720e7a66",
"en_raw": "Hey, hey"
},
{
"n": 9,
"h": "5e4f106b",
"en_raw": "tanuki are omnivores, sure"
},
{
"n": 10,
"h": "192c1446",
"en_raw": "but they don't eat people"
},
{
"n": 11,
"h": "f22b4712",
"en_raw": "You were tricked, that's all"
},
{
"n": 12,
"h": "4df0660c",
"en_raw": "They're called the Narusawa tanuki"
},
{
"n": 13,
"h": "efc91d98",
"en_raw": "and they tricked people a lot long ago"
},
{
"n": 14,
"h": "99d14829",
"en_raw": "...Huh?"
},
{
"n": 15,
"h": "5f2edf17",
"en_raw": "Especially cowards"
},
{
"n": 16,
"h": "86e20864",
"en_raw": "Ha ha ha ha..."
},
{
"n": 17,
"h": "52c85b82",
"en_raw": "It wasn't a tanuki"
},
{
"n": 18,
"h": "cdd648dc",
"en_raw": "a person really lived there"
},
{
"n": 19,
"h": "e0ec74f0",
"en_raw": "I lived there once too"
},
{
"n": 20,
"h": "03064627",
"en_raw": "About thirty years ago"
},
{
"n": 21,
"h": "d0c9ff25",
"en_raw": "But these days..."
},
{
"n": 22,
"h": "2b5b8ea7",
"en_raw": "But that person seemed sick"
},
{
"n": 23,
"h": "cc0afa43",
"en_raw": "and suddenly crouched down..."
},
{
"n": 24,
"h": "868320fb",
"en_raw": "That, young man"
},
{
"n": 25,
"h": "16043e40",
"en_raw": "is called 'tanuki napping'"
},
{
"n": 26,
"h": "ad7a978b",
"en_raw": "I understand"
},
{
"n": 27,
"h": "4f7014be",
"en_raw": "Never mind, it's fine..."
}
]
}