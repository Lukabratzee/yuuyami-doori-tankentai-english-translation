},
{
"n": 97,
"h": "5aa45920",
"en_raw": "Ah, I'll accept that"
},
{
"n": 98,
"h": "0ed0004a",
"en_raw": "Um... the pachinko stools"
},
{
"n": 99,
"h": "5431d0df",
"en_raw": "are dusty, though?"
},
{
"n": 100,
"h": "18d5cc2e",
"en_raw": "But finally I got here"
},
{
"n": 101,
"h": "f4766dc7",
"en_raw": "Since that woman, it's been awful"
},
{
"n": 102,
"h": "47ed7618",
"en_raw": "Customers dropped"
},
{
"n": 103,
"h": "0fbd10a4",
"en_raw": "part-timers quit..."
},
{
"n": 104,
"h": "70f3ebd7",
"en_raw": "A place with a history, huh"
},
{
"n": 105,
"h": "a224eaa2",
"en_raw": "Yes, that woman"
},
{
"n": 106,
"h": "18b5f0ff",
"en_raw": "covered herself in kerosene..."
},
{
"n": 107,
"h": "17c23486",
"en_raw": "and burned black"
},
{
"n": 108,
"h": "e6ea044e",
"en_raw": "but she still comes to the shop"
},
{
"n": 109,
"h": "b5ff964b",
"en_raw": "Persistent woman..."
},
{
"n": 110,
"h": "c326a57a",
"en_raw": "How many people killed themselves?"
},
{
"n": 111,
"h": "b5ef768b",
"en_raw": "But listen"
},
{
"n": 112,
"h": "a3fa7d21",
"en_raw": "I thought of the best"
},
{
"n": 113,
"h": "7011ed47",
