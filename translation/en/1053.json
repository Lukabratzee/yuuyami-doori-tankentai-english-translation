},
{
"n": 91,
"h": "2ca4d74d",
"en_raw": "Oh, a customer already..."
},
{
"n": 92,
"h": "c687e56f",
"en_raw": "The grand opening is tomorrow though"
},
{
"n": 93,
"h": "d577a4f1",
"en_raw": "...Huh, it opens tomorrow?"
},
{
"n": 94,
"h": "8b730ebe",
"en_raw": "...Oh, that kid from before"
},
{
"n": 95,
"h": "49ef49e9",
