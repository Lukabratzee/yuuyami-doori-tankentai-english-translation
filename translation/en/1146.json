"lines": [
{
"n": 0,
"h": "9ece5fd2",
"en_raw": "Worrying won't"
},
{
"n": 1,
"h": "2bf45a4a",
"en_raw": "do anything for you"
},
{
"n": 2,
"h": "20d5dee0",
"en_raw": "And either way"
},
{
"n": 3,
"h": "30a9599c",
"en_raw": "her life isn't in danger"
},
{
"n": 4,
"h": "cb37a128",
"en_raw": "Yeah, well, that's"
},
{
"n": 5,
"h": "378939d0",
"en_raw": "That's true but..."
},
{
"n": 6,
"h": "a9331aa1",
"en_raw": "She'll be fine tomorrow"
},
{
"n": 7,
"h": "5e46f500",
"en_raw": "and show up"
},
{
"n": 8,
"h": "aa8bb759",
"en_raw": "Perfect attendance is"
},
{
"n": 9,
"h": "c35a54dc",
"en_raw": "her only merit"
},
{
"n": 10,
"h": "19f17e63",
"en_raw": "...Okay, I got it"
},
{
"n": 11,
"h": "9b215287",
"en_raw": "Then I'm busy"
},
{
"n": 12,
"h": "a53e6fb9",
"en_raw": "Yes, Sango here!"
},
{
"n": 13,
"h": "05bcd0ba",
"en_raw": "...Die!"
},
{
"n": 14,
"h": "379c1367",
"en_raw": "Then I'll hang up"
},
{
"n": 15,
"h": "79dba5e2",
"en_raw": "wait up"
},
{
"n": 16,
"h": "fe0a404b",
"en_raw": "Sango's been strange lately"
},
{
"n": 17,
"h": "b8e18bd9",
"en_raw": "Seems irritated"
},
{
"n": 18,
"h": "629aef7e",
"en_raw": "then suddenly spaced out..."
},
{
"n": 19,
"h": "fd351663",
"en_raw": "Just say what you want"
},
{
"n": 20,
"h": "93c5c9e0",
"en_raw": "Um, about tomorrow"
},
{
"n": 21,
"h": "c4743733",
"en_raw": "want to visit Shiina in the hospital?"
},
{
"n": 22,
"h": "b016c0b8",
"en_raw": "Huh?"
},
{
"n": 23,
"h": "f11f0d14",
"en_raw": "...Yeah, yeah"
},
{
"n": 24,
"h": "c1754da1",
"en_raw": "Then tomorrow at one"
},
{
"n": 25,
"h": "6dc07c69",
"en_raw": "If you like it that much"
},
{
"n": 26,
"h": "f999ea43",
"en_raw": "go alone"
},
{
"n": 27,
"h": "89993c67",
"en_raw": "...Oh, it's just Nao"
},
{
"n": 28,
"h": "0a4d624e",
"en_raw": "Do you remember the rumor"
},
{
"n": 29,
"h": "8ed0de15",
"en_raw": "about the crow's curse?"
},
{
"n": 30,
"h": "50119715",
"en_raw": "What's that, out of nowhere"
},
{
"n": 31,
"h": "eb1ffe78",
"en_raw": "No, um, I thought Sango"
},
{
"n": 32,
"h": "1382af02",
"en_raw": "might laugh at it"
},
{
"n": 33,
"h": "c412c6ad",
"en_raw": "...What's that supposed to be?"
},
{
"n": 34,
"h": "b98d9ede",
"en_raw": "Something even worse"
},
{
"n": 35,
"h": "7cb852b3",
"en_raw": "I'd like to say to you but"
},
{
"n": 36,
"h": "7779d754",
"en_raw": "I'm not really in the mood"
},
{
"n": 37,
"h": "b01d1d06",
"en_raw": "so for now, with this"
},
{
"n": 38,
"h": "c2c8f862",
"en_raw": "will you put up with it?"
},
{
"n": 39,
"h": "79f75e96",
"en_raw": "Ah, Nao, it's me"
},
{
"n": 40,
"h": "8881483a",
"en_raw": "...Is Shiina there yet?"
},
{
"n": 41,
"h": "7f8a338f",
"en_raw": "I'm..."
},
{
"n": 42,
"h": "cc64a9a0",
"en_raw": "I'm Sango!"
},
{
"n": 43,
"h": "bec44984",
"en_raw": "You see"
},
{
"n": 44,
"h": "2175cabe",
"en_raw": "I can't go today"
},
{
"n": 45,
"h": "9ac8ef1c",
"en_raw": "That's sudden... I'm in trouble"
},
{
"n": 46,
"h": "c1545e39",
"en_raw": "The manuscript is stuck again"
},
{
"n": 47,
"h": "5f8e20ff",
"en_raw": "and the rain is awful"
},
{
"n": 48,
"h": "17ecfa57",
"en_raw": "sorry, but you two"
},
{
"n": 49,
"h": "50dd0720",
"en_raw": "have fun on your own"
},
{
"n": 50,
"h": "91e696bd",
"en_raw": "...Did I sound a bit old-man-ish?"
},
{
"n": 51,
"h": "49d7ff36",
"en_raw": "Wait, that's..."
},
{
"n": 52,
"h": "64fbb706",
"en_raw": "Bye, then"
},
{
"n": 53,
"h": "ddd3bcc3",
"en_raw": "I'm Sango"
},
{
"n": 54,
"h": "ddd3bcc3",
"en_raw": "I'm Sango"
},
{
"n": 55,
"h": "be50fc6b",
"en_raw": "Yes, Hirauchi here~"
},
{
"n": 56,
"h": "777fe76a",
"en_raw": "...So what does that have"
},
{
"n": 57,
"h": "689eb33d",
"en_raw": "to do with me?"
},
{
"n": 58,
"h": "9d041e1a",
"en_raw": "It was all the curse's fault!"
},
{
"n": 59,
"h": "2a5b607c",
"en_raw": "Shiina"
},
{
"n": 60,
"h": "6b1e5bd3",
"en_raw": "She might die!"
},
{
"n": 61,
"h": "345a2a5d",
"en_raw": "So..."
},
{
"n": 62,
"h": "41726d0a",
"en_raw": "I'm asking what that has"
},
{
"n": 63,
"h": "d3312a8c",
"en_raw": "to do with me!"
},
{
"n": 64,
"h": "ad8cfaf1",
"en_raw": "...Sango?"
},
{
"n": 65,
"h": "b5a0647c",
"en_raw": "It's not like I owe"
},
{
"n": 66,
"h": "6ef13eb0",
"en_raw": "Kurumi Shiina anything"
},
{
"n": 67,
"h": "03f6747c",
"en_raw": "or was her friend"
},
{
"n": 68,
"h": "2b07d150",
"en_raw": "Besides"
},
{
"n": 69,
"h": "f47c9640",
"en_raw": "I'm busy now"
},
{
"n": 70,
"h": "65065d4d",
"en_raw": "Spare me from being dragged"
},
{
"n": 71,
"h": "2f160084",
"en_raw": "into stupid talk"
},
{
"n": 72,
"h": "29b0d48c",
"en_raw": "Oh, it's just Nao..."
},
{
"n": 73,
"h": "5a58cb2d",
"en_raw": "Why so excited..."
},
{
"n": 74,
"h": "b2553d14",
"en_raw": "...And Nao"
},
{
"n": 75,
"h": "a7c38fa1",
"en_raw": "it's about time you"
},
{
"n": 76,
"h": "fb09e747",
"en_raw": "woke up too"
},
{
"n": 77,
"h": "4f0e39fc",
"en_raw": "...What do you mean?"
},
{
"n": 78,
"h": "84c960fb",
"en_raw": "Face reality already"
},
{
"n": 79,
"h": "d1039689",
"en_raw": "that's what I mean!"
},
{
"n": 80,
"h": "ca302a66",
"en_raw": "Sango!!"
},
{
"n": 81,
"h": "ea51f8a1",
"en_raw": "This is the end"
},
{
"n": 82,
"h": "ba3b97be",
"en_raw": "It's all over..."
},
{
"n": 83,
"h": "2628fac9",
"en_raw": "Sango, don't laugh, listen!"
},
{
"n": 84,
"h": "8c888fb6",
"en_raw": "Tomorrow is day 100!"
},
{
"n": 85,
"h": "c1050db1",
"en_raw": "of the curse..."
},
{
"n": 86,
"h": "1f423cef",
"en_raw": "the last day of the crow's curse!"
},
{
"n": 87,
"h": "97f4fea7",
"en_raw": "What are you talking..."
},
{
"n": 88,
"h": "27fbc6a3",
"en_raw": "Just listen"
},
{
"n": 89,
"h": "71236b87",
"en_raw": "Shiina collapsed today, right?"
},
{
"n": 90,
"h": "7f600701",
"en_raw": "I counted just now"
},
{
"n": 91,
"h": "d2464630",
"en_raw": "the crow..."
},
{
"n": 92,
"h": "d0b8f203",
"en_raw": "how many days passed"
},
{
"n": 93,
"h": "6832e84b",
"en_raw": "since that crow day"
}
]
