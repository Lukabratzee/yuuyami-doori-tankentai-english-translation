{
"file": 120,
"paths": [
"d007/d004/f121"
],
"lines": [
{
"n": 0,
"h": "28d55795",
"en_raw": "When I listen to the water"
},
{
"n": 1,
"h": "19f1e276",
"en_raw": "flowing down a drain"
},
{
"n": 2,
"h": "2715c44e",
"en_raw": "in my case, I often"
},
{
"n": 3,
"h": "29cc21e9",
"en_raw": "get called"
},
{
"n": 4,
"h": "c8402288",
"en_raw": "from deep, deep inside..."
},
{
"n": 5,
"h": "5e63854b",
"en_raw": "Called, you say"
},
{
"n": 6,
"h": "cf46ed67",
"en_raw": "...By what?"
},
{
"n": 7,
"h": "7202c126",
"en_raw": "A baby"
},
{
"n": 8,
"h": "f142f589",
"en_raw": "What's that..."
},
{
"n": 9,
"h": "0c07b802",
"en_raw": "When I went into the bathroom at Hirumi Station"
},
{
"n": 10,
"h": "b7616c86",
"en_raw": "it was awful"
},
{
"n": 11,
"h": "6e6c8480",
"en_raw": "The stall was filled"
},
{
"n": 12,
"h": "18c69d7b",
"en_raw": "with crying..."
},
{
"n": 13,
"h": "7790be29",
"en_raw": "Why would that happen?"
},
{
"n": 14,
"h": "fa58766b",
"en_raw": "That's, um..."
},
{
"n": 15,
"h": "3197d788",
"en_raw": "Women who can't deal with"
},
{
"n": 16,
"h": "1a468839",
"en_raw": "newborn babies"
},
{
"n": 17,
"h": "875ab609",
"en_raw": "flush them down the toilet..."
},
{
"n": 18,
"h": "6ba06db5",
"en_raw": "So the sewers are"
},
{
"n": 19,
"h": "9bcf8039",
"en_raw": "full of Mizuko spirits"
},
{
"n": 20,
"h": "73df0397",
"en_raw": "Yuri, this is a bathroom"
},
{
"n": 21,
"h": "944b4aee",
"en_raw": "Can you hear them, Yuri?"
},
{
"n": 22,
"h": "6fc4d92c",
"en_raw": "Babies' voices..."
},
{
"n": 23,
"h": "3586df05",
"en_raw": "It's a bit far"
},
{
"n": 24,
"h": "fe0b5dca",
"en_raw": "but if you listen closely..."
},
{
"n": 25,
"h": "40c59c73",
"en_raw": "Yuri, I'm scared"
},
{
"n": 26,
"h": "2e88f4ee",
"en_raw": "...Hey, look"
},
{
"n": 27,
"h": "30180936",
"en_raw": "She's eavesdropping again"
},
{
"n": 28,
"h": "56e3d1de",
"en_raw": "What an amazing made-up story"
},
{
"n": 29,
"h": "7922b22c",
"en_raw": "From now on I'll be too scared"
},
{
"n": 30,
"h": "a2e4743f",
"en_raw": "to enter the bathroom"
},
{
"n": 31,
"h": "004be625",
"en_raw": "Then get out!"
},
{
"n": 32,
"h": "f04df937",
"en_raw": "You're in the way"
},
{
"n": 33,
"h": "3764dd8c",
"en_raw": "......"
},
{
"n": 34,
"h": "3b2b3994",
"en_raw": "Hey, wait"
},
{
"n": 35,
"h": "3764dd8c",
"en_raw": "......"
},
{
"n": 36,
"h": "56c56f1c",
"en_raw": "Sorry, idiocy is contagious"
},
{
"n": 37,
"h": "d4050e37",
"en_raw": "With this"
}
]
}