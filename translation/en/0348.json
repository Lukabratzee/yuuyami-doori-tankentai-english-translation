"lines": [
{
"n": 0,
"h": "9dd29ada",
"en_raw": "...This pachinko parlor"
},
{
"n": 1,
"h": "9a48b4d8",
"en_raw": "has been shut"
},
{
"n": 2,
"h": "12fd7986",
"en_raw": "since last year"
},
{
"n": 3,
"h": "a3b7eee8",
"en_raw": "Excuse me, um..."
},
{
"n": 4,
"h": "565670b8",
"en_raw": "this pachinko parlor"
},
{
"n": 5,
"h": "53c62672",
"en_raw": "Oh dear, we were just"
},
{
"n": 6,
"h": "d4482961",
"en_raw": "talking about that"
},
{
"n": 7,
"h": "7eb2b7d0",
"en_raw": "Honestly, when will it"
},
{
"n": 8,
"h": "d43d139c",
"en_raw": "open again?"
},
{
"n": 9,
"h": "a9e0052f",
"en_raw": "Can't even kill time"
},
{
"n": 10,
"h": "1e405684",
"en_raw": "It won't open again, surely"
},
{
"n": 11,
"h": "3c94f692",
"en_raw": "There was a lot of trouble here..."
},
{
"n": 12,
"h": "1e3b3693",
"en_raw": "Good for saving money, no?"
},
{
"n": 13,
"h": "ae40ef89",
"en_raw": "That's true"
},
{
"n": 14,
"h": "a3b7eee8",
"en_raw": "Excuse me, um..."
},
{
"n": 15,
"h": "c33368e1",
"en_raw": "Oh dear"
},
{
"n": 16,
"h": "4a4a92c8",
"en_raw": "That's right..."
},
{
"n": 17,
"h": "86da8be9",
"en_raw": "Seems they can't hear me..."
},
{
"n": 18,
"h": "e333a75e",
"en_raw": "Thank you very much"
},
{
"n": 19,
"h": "d4fcf196",
"en_raw": "Excuse me..."
},
{
"n": 20,
"h": "9cab5f11",
"en_raw": "What a nuisance"
},
{
"n": 21,
"h": "f6a75dfc",
"en_raw": "Oh, how unpleasant"
},
{
"n": 22,
"h": "d45e1f55",
"en_raw": "...She's not listening at all"
},
{
"n": 23,
"h": "69b1d6cb",
"en_raw": "...160,000"
},
{
"n": 24,
"h": "e930c03d",
"en_raw": "You could borrow that much"
},
{
"n": 25,
"h": "9bf8762a",
"en_raw": "from your parents, right?"
},
{
"n": 26,
"h": "876a9e0d",
"en_raw": "Anything works, tuition or whatever"
},
{
"n": 27,
"h": "b69d007c",
"en_raw": "Just say something plausible..."
},
{
"n": 28,
"h": "d4fcf196",
"en_raw": "Excuse me..."
},
{
"n": 29,
"h": "bee0a74a",
"en_raw": "Oh, need something?"
},
{
"n": 30,
"h": "e2f98045",
"en_raw": "It's about the pachinko parlor"
},
{
"n": 31,
"h": "23a5a6d7",
"en_raw": "over there..."
},
{
"n": 32,
"h": "f866c224",
"en_raw": "A middle schooler gambling"
},
{
"n": 33,
"h": "a883c4ef",
"en_raw": "is bad, you know"
},
{
"n": 34,
"h": "4168cf55",
"en_raw": "No, that's not it"
},
{
"n": 35,
"h": "b4f03e54",
"en_raw": "it's about the person in the shop"
},
{
"n": 36,
"h": "5e8b6834",
"en_raw": "...The shopkeeper?"
},
{
"n": 37,
"h": "3045d5d4",
"en_raw": "Isn't the manager the only one"
},
{
"n": 38,
"h": "c9c334ca",
"en_raw": "there now?"
},
{
"n": 39,
"h": "5513a61f",
"en_raw": "Oh, it's about that person"
},
{
"n": 40,
"h": "4b426675",
"en_raw": "Um..."
},
{
"n": 41,
"h": "75538a33",
"en_raw": "...So what?"
},
{
"n": 42,
"h": "b7368766",
"en_raw": "Don't talk to me if you don't need anything"
},
{
"n": 43,
"h": "858f410e",
"en_raw": "Is he a living person?"
},
{
"n": 44,
"h": "4bd935db",
"en_raw": "Hey, what is that?"
},
{
"n": 45,
"h": "53798e37",
"en_raw": "Don't kill people off on your own"
},
{
"n": 46,
"h": "32105de5",
"en_raw": "He's alive"
},
{
"n": 47,
"h": "6b04b4ff",
"en_raw": "Don't say weird things"
},
{
"n": 48,
"h": "cc9699fc",
"en_raw": "Go away"
},
{
"n": 49,
"h": "06da73d8",
"en_raw": "I'm working right now"
},
{
"n": 50,
"h": "6f4cfba2",
"en_raw": "...Oh, long time no see, how are you?"
},
{
"n": 51,
"h": "bd8b58e3",
"en_raw": "Oh, yakiniku? Sounds good"
},
{
"n": 52,
"h": "d1147a96",
"en_raw": "Over here, some middle schooler"
},
{
"n": 53,
"h": "ce5555f0",
"en_raw": "asked me weird stuff"
},
{
"n": 54,
"h": "433a06b8",
"en_raw": "Sorry to bother you"
},
{
"n": 55,
"h": "68d2524b",
"en_raw": "Still closed..."
},
{
"n": 56,
"h": "1c530a82",
"en_raw": "Don't get in the way"
},
{
"n": 57,
"h": "3203ffc5",
"en_raw": "Wait until you're older"
},
{
"n": 58,
"h": "12232be8",
"en_raw": "Come to the shop in three years"
}
]
}