"lines": [
{
"n": 0,
"h": "2145fa48",
"en_raw": "Oh, it's Murase"
},
{
"n": 1,
"h": "898f22d6",
"en_raw": "But there are irrelevant ones too"
},
{
"n": 2,
"h": "ad8e44bf",
"en_raw": "I'm just a spectator"
},
{
"n": 3,
"h": "3fe536d7",
"en_raw": "Well, anyway, tonight"
},
{
"n": 4,
"h": "0391e67c",
"en_raw": "Murase, everyone"
},
{
"n": 5,
"h": "867ec605",
"en_raw": "gathered for you"
},
{
"n": 6,
"h": "a2a87605",
"en_raw": "You're prepared, right?"
},
{
"n": 7,
"h": "1ac9a3c4",
"en_raw": "Not running away now..."
},
{
"n": 8,
"h": "56b0be78",
"en_raw": "you won't say that, right?"
},
{
"n": 9,
"h": "3764dd8c",
"en_raw": "......"
},
{
"n": 10,
"h": "cd9aa2d5",
"en_raw": "I said that, but"
},
{
"n": 11,
"h": "88dcebbb",
"en_raw": "somehow I'm getting"
},
{
"n": 12,
"h": "c7b17912",
"en_raw": "angry too"
},
{
"n": 13,
"h": "aff7865b",
"en_raw": "...Why not quit?"
},
{
"n": 14,
"h": "1147e587",
"en_raw": "Hey, ugly"
},
{
"n": 15,
"h": "aca959ae",
"en_raw": "The kid from the next class"
},
{
"n": 16,
"h": "b707ac07",
"en_raw": "has nothing to do with this!"
},
{
"n": 17,
"h": "8d7a6791",
"en_raw": "Or, Murase"
},
{
"n": 18,
"h": "f93efbd6",
"en_raw": "are you going to listen to a girl"
},
{
"n": 19,
"h": "26d7c5a0",
"en_raw": "and go home with her?"
},
{
"n": 20,
"h": "3764dd8c",
"en_raw": "......"
},
{
"n": 21,
"h": "d6fdb7c9",
"en_raw": "That's not fair, senor"
},
{
"n": 22,
"h": "0e528013",
"en_raw": "What a selfish guy"
},
{
"n": 23,
"h": "c6205913",
"en_raw": "Go easy on him"
},
{
"n": 24,
"h": "6bea3908",
"en_raw": "everyone"
},
{
"n": 25,
"h": "e046a399",
"en_raw": "Murase's off today"
},
{
"n": 26,
"h": "ff9cf1ea",
"en_raw": "but he'll definitely do it tomorrow"
},
{
"n": 27,
"h": "d30fb3d9",
"en_raw": "I can't deal with idiots"
},
{
"n": 28,
"h": "874c75cd",
"en_raw": "Hey Murase, your coward level"
},
{
"n": 29,
"h": "b0d0b35b",
"en_raw": "went up another notch today"
},
{
"n": 30,
"h": "528f0daa",
"en_raw": "Tomorrow's a must"
},
{
"n": 31,
"h": "9143d8d0",
"en_raw": "Sanjo will"
},
{
"n": 32,
"h": "5eb1f065",
"en_raw": "We'll be waiting~"
},
{
"n": 33,
"h": "cb6f2317",
"en_raw": "Don't wait"
},
{
"n": 34,
"h": "3b2b3994",
"en_raw": "Hey, wait"
},
{
"n": 35,
"h": "7be1de26",
"en_raw": "Why doesn't the class rep"
},
{
"n": 36,
"h": "744630b6",
"en_raw": "stop a kids' game"
},
{
"n": 37,
"h": "a1e77600",
"en_raw": "like this?"
},
{
"n": 38,
"h": "599c80ea",
"en_raw": "Well,"
},
{
"n": 39,
"h": "242d0540",
"en_raw": "Yuasa is rude, but"
},
{
"n": 40,
"h": "57dad378",
"en_raw": "Sanjo, you know"
},
{
"n": 41,
"h": "121b078f",
"en_raw": "wants to see Murase's"
},
{
"n": 42,
"h": "6211bfd5",
"en_raw": "various faces"
},
{
"n": 43,
"h": "c5968f68",
"en_raw": "You"
},
{
"n": 44,
"h": "9458bf75",
"en_raw": "can't not know"
},
{
"n": 45,
"h": "880e1380",
"en_raw": "His heart is"
},
{
"n": 46,
"h": "f494cbe4",
"en_raw": "like a lab mouse's"
},
{
"n": 47,
"h": "fb0635dd",
"en_raw": "I don't know~"
},
{
"n": 48,
"h": "7a0effcf",
"en_raw": "I'm not as close as"
},
{
"n": 49,
"h": "4485d0e3",
"en_raw": "Hirauchi, you see"
},
{
"n": 50,
"h": "3e31646e",
"en_raw": "Oh my..."
},
{
"n": 51,
"h": "e20525a1",
"en_raw": "If even you're in on it"
},
{
"n": 52,
"h": "2c9ed070",
"en_raw": "Nao has no chance"
},
{
"n": 53,
"h": "3143252c",
"en_raw": "Bailing tonight was right"
},
{
"n": 54,
"h": "656d576b",
"en_raw": "Oh, how kind"
},
{
"n": 55,
"h": "1e337f95",
"en_raw": "Hirauchi really"
},
{
"n": 56,
"h": "a6e630af",
"en_raw": "Murase's..."
},
{
"n": 57,
"h": "9e7fe8fa",
"en_raw": "What?"
},
{
"n": 58,
"h": "5ec5469f",
"en_raw": "It's nothing~"
},
{
"n": 59,
"h": "c323ead2",
"en_raw": "Let's both do our best"
},
{
"n": 60,
"h": "471c29da",
"en_raw": "Hey, about earlier..."
},
{
"n": 61,
"h": "5ec5469f",
"en_raw": "It's nothing~"
},
{
"n": 62,
"h": "c323ead2",
"en_raw": "Let's both do our best"
},
{
"n": 63,
"h": "e11ba01c",
"en_raw": "Hmm, I see"
},
{
"n": 64,
"h": "f919c1ce",
"en_raw": "Why are you here too?"
},
{
"n": 65,
"h": "e0200367",
"en_raw": "Something important of mine was taken"
},
{
"n": 66,
"h": "a16e112e",
"en_raw": "Hey, Murase, sorry, but"
},
{
"n": 67,
"h": "737146e9",
"en_raw": "be sure to go get it tomorrow"
},
{
"n": 68,
"h": "9d857b83",
"en_raw": "...I see"
},
{
"n": 69,
"h": "263ed9c7",
"en_raw": "Solve your own"
},
{
"n": 70,
"h": "003e6938",
"en_raw": "troubles yourself"
},
{
"n": 71,
"h": "c331bf3f",
"en_raw": "Coward"
},
{
"n": 72,
"h": "5fa6965c",
"en_raw": "You also got invited by Yuasa"
},
{
"n": 73,
"h": "6c10f842",
"en_raw": "and tagged along, didn't you"
},
{
"n": 74,
"h": "629c8222",
"en_raw": "Hirauchi has nothing to do with it"
},
{
"n": 75,
"h": "3b2b3994",
"en_raw": "Hey, wait"
},
{
"n": 76,
"h": "dc1d5ac2",
"en_raw": "Aren't you ashamed"
},
{
"n": 77,
"h": "61cafb51",
"en_raw": "of obeying Yuasa?"
},
{
"n": 78,
"h": "d0daf9d2",
"en_raw": "Anything fun is fine"
},
{
"n": 79,
"h": "29f1b825",
"en_raw": "And you"
},
{
"n": 80,
"h": "addc4ceb",
"en_raw": "why do you come up with"
},
{
"n": 81,
"h": "a88b014a",
"en_raw": "such stupid"
},
{
"n": 82,
"h": "4a6710ed",
"en_raw": "events?"
},
{
"n": 83,
"h": "75c729d5",
"en_raw": "Girls wouldn't get it"
},
{
"n": 84,
"h": "3b2b3994",
"en_raw": "Hey, wait"
},
{
"n": 85,
"h": "56c1ac8b",
"en_raw": "I have no use for you"
},
{
"n": 86,
"h": "ac1d4edc",
"en_raw": "Better go home quickly"
},
{
"n": 87,
"h": "db5351a3",
"en_raw": "Go easy on him,"
},
{
"n": 88,
"h": "6bea3908",
"en_raw": "everyone"
},
{
"n": 89,
"h": "e046a399",
"en_raw": "Murase's off today"
},
{
"n": 90,
"h": "ff9cf1ea",
"en_raw": "but he'll definitely do it tomorrow"
}
]
