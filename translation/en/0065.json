"lines": [
{
"n": 0,
"h": "b5596c9d",
"en_raw": "Murase"
},
{
"n": 1,
"h": "3cdf9c7d",
"en_raw": "Are you really going there?"
},
{
"n": 2,
"h": "c61b412e",
"en_raw": "I..."
},
{
"n": 3,
"h": "e0d7bdf2",
"en_raw": "Maybe I don't have to go"
},
{
"n": 4,
"h": "f32ff96d",
"en_raw": "What are you talking about?"
},
{
"n": 5,
"h": "09c1223e",
"en_raw": "...Oh, today"
},
{
"n": 6,
"h": "96a80736",
"en_raw": "I have something to do"
},
{
"n": 7,
"h": "b8671c0a",
"en_raw": "I can't go today after all"
},
{
"n": 8,
"h": "f574bfa4",
"en_raw": "Sorry, Murase"
},
{
"n": 9,
"h": "ebc743fc",
"en_raw": "Hey, what you said..."
},
{
"n": 10,
"h": "8cd56ad8",
"en_raw": "Oh, no, Kume..."
},
{
"n": 11,
"h": "5cd37936",
"en_raw": "No, it's nothing"
},
{
"n": 12,
"h": "19e8b4ef",
"en_raw": "Sorry, I have to..."
},
{
"n": 13,
"h": "076a742d",
"en_raw": "You'll finally set foot"
},
{
"n": 14,
"h": "f9c931df",
"en_raw": "in that forbidden place too?"
},
{
"n": 15,
"h": "3647183b",
"en_raw": "...What are you talking about?"
},
{
"n": 16,
"h": "31659cf2",
"en_raw": "In my experience, evil spirits..."
},
{
"n": 17,
"h": "10ca34f6",
"en_raw": "can't touch people"
},
{
"n": 18,
"h": "850ebe3c",
"en_raw": "who have proper knowledge"
},
{
"n": 19,
"h": "400b5bc1",
"en_raw": "Hey, evil spirits?"
},
{
"n": 20,
"h": "d6099b0c",
"en_raw": "It's fine, you remember"
},
{
"n": 21,
"h": "0ee037b4",
"en_raw": "what I told you, don't you?"
},
{
"n": 22,
"h": "21d98ce2",
"en_raw": "Hey, what are you talking about?"
},
{
"n": 23,
"h": "3c0d4336",
"en_raw": "I told you the other day"
},
{
"n": 24,
"h": "048985aa",
"en_raw": "About psychic self-defense..."
},
{
"n": 25,
"h": "c9c7799e",
"en_raw": "...Did you?"
},
{
"n": 26,
"h": "6ee02451",
"en_raw": "But Yuasa and them..."
},
{
"n": 27,
"h": "9e9cd5f7",
"en_raw": "Those guys don't know it"
},
{
"n": 28,
"h": "20e1254a",
"en_raw": "This time they're finished"
},
{
"n": 29,
"h": "80895114",
"en_raw": "Hey, Kume..."
},
{
"n": 30,
"h": "3036db96",
"en_raw": "Yuasa and them"
},
{
"n": 31,
"h": "f3858f55",
"en_raw": "are finished this time..."
},
{
"n": 32,
"h": "a51a3350",
"en_raw": "...Maybe you forgot"
},
{
"n": 33,
"h": "66a2cad3",
"en_raw": "Can't be helped"
},
{
"n": 34,
"h": "cfad031a",
"en_raw": "It's a theory a bit hard"
},
{
"n": 35,
"h": "eb36b3fe",
"en_raw": "for an ordinary person like you..."
},
{
"n": 36,
"h": "19e8b4ef",
"en_raw": "Sorry, I have to..."
},
{
"n": 37,
"h": "8ccfde1b",
"en_raw": "Murase, tonight at 7"
},
{
"n": 38,
"h": "14ecc1af",
"en_raw": "you'd better come"
},
{
"n": 39,
"h": "9dce6e83",
"en_raw": "...If you don't, I'll kill you"
},
{
"n": 40,
"h": "cf0562cc",
"en_raw": "I don't know about that"
},
{
"n": 41,
"h": "a79ee97a",
"en_raw": "Oh, I forgot to tell you"
},
{
"n": 42,
"h": "9800d97c",
"en_raw": "Today, for you"
},
{
"n": 43,
"h": "d0291bfc",
"en_raw": "I'm holding a courage test"
},
{
"n": 44,
"h": "81e6a741",
"en_raw": "at the redevelopment site"
},
{
"n": 45,
"h": "7fcfea66",
"en_raw": "Most of the class is coming, so"
},
{
"n": 46,
"h": "f7545532",
"en_raw": "if you don't want to be humiliated"
},
{
"n": 47,
"h": "a1b06244",
"en_raw": "you'd better come"
},
{
"n": 48,
"h": "b352dcab",
"en_raw": "Obtained the rumor of the Courage Test"
},
{
"n": 49,
"h": "bdd57487",
"en_raw": "I didn't hear about this"
},
{
"n": 50,
"h": "14ecc1af",
"en_raw": "you'd better come"
},
{
"n": 51,
"h": "339836d3",
"en_raw": "Hey, Yuasa..."
},
{
"n": 52,
"h": "14ecc1af",
"en_raw": "you'd better come"
}
]
