"d008/d031/f024"
],
"lines": [
{
"n": 0,
"h": "1e105b78",
"en_raw": "What if the black dog shows up?"
},
{
"n": 1,
"h": "3a3cc39a",
"en_raw": "Um, excuse me"
},
{
"n": 2,
"h": "a8103523",
"en_raw": "...Ah, thank goodness"
},
{
"n": 3,
"h": "ebaab111",
"en_raw": "Good thing someone's here"
},
{
"n": 4,
"h": "6aef23ed",
"en_raw": "You look that way yourself"
},
{
"n": 5,
"h": "630e7e9c",
"en_raw": "With so few people"
},
{
"n": 6,
"h": "36bea7ae",
"en_raw": "around"
},
{
"n": 7,
"h": "949dd466",
"en_raw": "is it really true after all?"
},
{
"n": 8,
"h": "d6f13626",
"en_raw": "That black dog rumor"
},
{
"n": 9,
"h": "65f95dbe",
"en_raw": "What do you think?"
},
{
"n": 10,
"h": "6ebaf812",
"en_raw": "Well, at first, I"
},
{
"n": 11,
"h": "f34fc078",
"en_raw": "didn't believe it"
},
{
"n": 12,
"h": "7e918630",
"en_raw": "Everybody's like that"
},
{
"n": 13,
"h": "799b5aab",
"en_raw": "It's like the lie"
},
{
"n": 14,
"h": "5b6fa147",
"en_raw": "is becoming true"
},
{
"n": 15,
"h": "17edb63e",
"en_raw": "Elementary school doing group trips home"
},
{
"n": 16,
"h": "2ba32452",
"en_raw": "is what blows the story up"
},
{
"n": 17,
"h": "8a45cdbe",
"en_raw": "To begin with, nobody has"
},
{
"n": 18,
"h": "da94a75c",
"en_raw": "actually seen a black dog"
},
{
"n": 19,
"h": "3f602a4f",
"en_raw": "...except elementary schoolers"
},
{
"n": 20,
"h": "c61ea3ea",
"en_raw": "So the rumor's a lie, then"
},
{
"n": 21,
"h": "20ba3751",
"en_raw": "At least in my book"
},
{
"n": 22,
"h": "21f31632",
"en_raw": "If I were scared of dogs"
},
{
"n": 23,
"h": "5e367d06",
"en_raw": "I couldn't go buy cigarettes"
},
{
"n": 24,
"h": "2c42aa51",
"en_raw": "If you're scared, go home early"
},
{
"n": 25,
"h": "e5e4eb2a",
"en_raw": "Um... I'm going home"
},
{
"n": 26,
"h": "749f5b41",
"en_raw": "Yeah, that's probably best"
},
{
"n": 27,
"h": "6ae6cb3b",
"en_raw": "As you can see, nobody's here..."
},
{
"n": 28,
"h": "753176f6",
"en_raw": "Could it be the black dog...?"
},
{
"n": 29,
"h": "f0fb6608",
"en_raw": "This is bad, Nao!"
},
{
"n": 30,
"h": "1dbc4287",
"en_raw": "Let's bring Melos after all"
},
{
"n": 31,
"h": "80480ea4",
"en_raw": "(I've got a bad feeling about this)"
},
{
"n": 32,
"h": "6472b7c5",
"en_raw": "(Maybe it'd be"
},
{
"n": 33,
"h": "dff60b76",
"en_raw": "better with Melos...)"
}
]
}