{
"file": 842,
"paths": [
"d008/d077/f018"
],
"lines": [
{
"n": 0,
"h": "23cf49b6",
"en_raw": "Murase!"
},
{
"n": 1,
"h": "8c142093",
"en_raw": "Walking the dog all the way out here?"
},
{
"n": 2,
"h": "406cdfc0",
"en_raw": "Gotta go on a long trip sometimes"
},
{
"n": 3,
"h": "ca1da4e6",
"en_raw": "Girls are here again today"
},
{
"n": 4,
"h": "e786a3de",
"en_raw": "Let's meet a bit"
},
{
"n": 5,
"h": "5b94ac72",
"en_raw": "...By the way, Segawa"
},
{
"n": 6,
"h": "96e3d30a",
"en_raw": "the place where the car is sunk"
},
{
"n": 7,
"h": "e6a137d5",
"en_raw": "have you been there?"
},
{
"n": 8,
"h": "a7ef2412",
"en_raw": "Oh, that's just up ahead"
},
{
"n": 9,
"h": "eed1ed13",
"en_raw": "Actually I was just about to"
},
{
"n": 10,
"h": "0d3d571e",
"en_raw": "move over there"
},
{
"n": 11,
"h": "f8c564b4",
"en_raw": "Hey, Murase, if you have time"
},
{
"n": 12,
"h": "55d8da57",
"en_raw": "let's play a bit"
},
{
"n": 13,
"h": "cfd43f2e",
"en_raw": "I got a new lure"
},
{
"n": 14,
"h": "53c7bf45",
"en_raw": "bought for me"
},
{
"n": 15,
"h": "7c5de62d",
"en_raw": "Hey, Segawa, know what?"
},
{
"n": 16,
"h": "b9d59275",
"en_raw": "This place"
},
{
"n": 17,
"h": "aefccfbf",
"en_raw": "had a double suicide"
},
{
"n": 18,
"h": "31f943d1",
"en_raw": "A double suicide?"
},
{
"n": 19,
"h": "510bb249",
"en_raw": "...Someone died here?"
},
{
"n": 20,
"h": "6eedfaa7",
"en_raw": "Yeah, and the car used for it"
},
{
"n": 21,
"h": "359c3dbd",
"en_raw": "is the one sunk there, they say"
},
{
"n": 22,
"h": "607567b0",
"en_raw": "...Is that true?"
},
{
"n": 23,
"h": "22c54ed3",
"en_raw": "Apparently"
},
{
"n": 24,
"h": "f4b507f1",
"en_raw": "...Say, Murase"
},
{
"n": 25,
"h": "028b3f3a",
"en_raw": "I'm going home"
},
{
"n": 26,
"h": "1717d26c",
"en_raw": "...See you"
},
{
"n": 27,
"h": "1cd5dae1",
"en_raw": "The rumored double-suicide car..."
},
{
"n": 28,
"h": "6a2cb58a",
"en_raw": "Peer at the water and the shadows"
},
{
"n": 29,
"h": "16049932",
"en_raw": "of the couple who died are in the water..."
},
{
"n": 30,
"h": "f1ef97bc",
"en_raw": "How about it, Nao"
},
{
"n": 31,
"h": "6c1211d5",
"en_raw": "...Is it reflected?"
},
{
"n": 32,
"h": "2cd87ba2",
"en_raw": "No way"
},
{
"n": 33,
"h": "aeda4649",
"en_raw": "Look more carefully"
},
{
"n": 34,
"h": "2af20805",
"en_raw": "Peer at the water / Stop  Guess it doesn't show..."
},
{
"n": 35,
"h": "a0e84a11",
"en_raw": "Peer at the water / Stop  Only my shadow..."
},
{
"n": 36,
"h": "2a757a0e",
"en_raw": "...Right"
},
{
"n": 37,
"h": "8c3e665e",
"en_raw": "Of course not"
},
{
"n": 38,
"h": "120f70c7",
"en_raw": "...There's no way I'd see it"
},
{
"n": 39,
"h": "ee58ce14",
"en_raw": "Nao and Segawa both"
},
{
"n": 40,
"h": "5d7855a1",
"en_raw": "birds of a feather flock together"
},
{
"n": 41,
"h": "ee9d0be7",
"en_raw": "exactly right"
}
]
}