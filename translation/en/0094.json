"file": 94,
"paths": [
"d007/d001/f281"
],
"lines": [
{
"n": 0,
"h": "89929aa0",
"en_raw": "Yo!"
},
{
"n": 1,
"h": "7a6f12ff",
"en_raw": "Oh, Sanjo"
},
{
"n": 2,
"h": "5a9f27fe",
"en_raw": "What are you doing?"
},
{
"n": 3,
"h": "76b9bf98",
"en_raw": "It's cool here, isn't it"
},
{
"n": 4,
"h": "e4d120c4",
"en_raw": "I'm thinking of making it"
},
{
"n": 5,
"h": "1b00b7d8",
"en_raw": "my own secret place"
},
{
"n": 6,
"h": "ac0bbc28",
"en_raw": "Nishi comes here sometimes too"
},
{
"n": 7,
"h": "fe2576eb",
"en_raw": "Huh, he comes too?"
},
{
"n": 8,
"h": "eac114a1",
"en_raw": "...You're surprised"
},
{
"n": 9,
"h": "597450f8",
"en_raw": "Nishi really is"
},
{
"n": 10,
"h": "4803059a",
"en_raw": "cool, isn't he?"
},
{
"n": 11,
"h": "a64080ff",
"en_raw": "I wonder?"
},
{
"n": 12,
"h": "a2152d7c",
"en_raw": "Oh, come to think of it"
},
{
"n": 13,
"h": "cb0f9091",
"en_raw": "you and Nishi"
},
{
"n": 14,
"h": "260c8764",
"en_raw": "don't talk much, Sanjo"
},
{
"n": 15,
"h": "8b896a7b",
"en_raw": "Hmm, true"
},
{
"n": 16,
"h": "c6fac074",
"en_raw": "I've never really thought about it"
},
{
"n": 17,
"h": "111263e7",
"en_raw": "...Yeah, we don't talk"
},
{
"n": 18,
"h": "013e99a1",
"en_raw": "Maybe because we're both popular?"
},
{
"n": 19,
"h": "09a2c116",
"en_raw": "Murase, are you tight-lipped?"
},
{
"n": 20,
"h": "b6dc6578",
"en_raw": "Well..."
},
{
"n": 21,
"h": "6322f219",
"en_raw": "I don't say"
},
{
"n": 22,
"h": "7239f981",
"en_raw": "what I shouldn't, but"
},
{
"n": 23,
"h": "52907a69",
"en_raw": "I see..."
},
{
"n": 24,
"h": "b16a7d50",
"en_raw": "I think Nishi"
},
{
"n": 25,
"h": "e8e5ae8d",
"en_raw": "is an extremely dangerous person"
},
{
"n": 26,
"h": "313ba078",
"en_raw": "...What!?"
},
{
"n": 27,
"h": "0f2502a2",
"en_raw": "We still have parents"
},
{
"n": 28,
"h": "2776cf87",
"en_raw": "whatever else you say"
},
{
"n": 29,
"h": "3b9b12b5",
"en_raw": "how should I put it, like..."
},
{
"n": 30,
"h": "6bcb3592",
"en_raw": "in the end, we're kids"
},
{
"n": 31,
"h": "6677278a",
"en_raw": "Yeah"
},
{
"n": 32,
"h": "2701f166",
"en_raw": "But somehow, it's different"
},
{
"n": 33,
"h": "2319c783",
"en_raw": "in his case..."
},
{
"n": 34,
"h": "f1678ba6",
"en_raw": "He's strangely mature"
},
{
"n": 35,
"h": "eb61d51d",
"en_raw": "Sanjo"
},
{
"n": 36,
"h": "06aa7a53",
"en_raw": "had noticed"
},
{
"n": 37,
"h": "b42223e0",
"en_raw": "that the idol Nishi"
},
{
"n": 38,
"h": "313c01f1",
"en_raw": "is actually..."
},
{
"n": 39,
"h": "01e32e62",
"en_raw": "...So Sanjo too"
},
{
"n": 40,
"h": "14df5d89",
"en_raw": "about Nishi?"
},
{
"n": 41,
"h": "bbb8598b",
"en_raw": "You"
},
{
"n": 42,
"h": "c450833e",
"en_raw": "how are you listening to this?"
},
{
"n": 43,
"h": "b564195b",
"en_raw": "That's enough about Takayuki Nishi"
},
{
"n": 44,
"h": "d73825a1",
"en_raw": "I'm telling you, I"
},
{
"n": 45,
"h": "f9915167",
"en_raw": "hate badmouthing"
}
]
}