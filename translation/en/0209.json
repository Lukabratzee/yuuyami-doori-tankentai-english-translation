"lines": [
{
"n": 0,
"h": "d6bb9a34",
"en_raw": "Is she here today too?"
},
{
"n": 1,
"h": "336804e2",
"en_raw": "Yeah, in the observation seats..."
},
{
"n": 2,
"h": "f9fdb045",
"en_raw": "sitting like a ghost"
},
{
"n": 3,
"h": "7b8b2641",
"en_raw": "That's definitely on purpose"
},
{
"n": 4,
"h": "baf93aa6",
"en_raw": "What do we do, Sakai?"
},
{
"n": 5,
"h": "30a4e280",
"en_raw": "Why me?"
},
{
"n": 6,
"h": "9b756620",
"en_raw": "...It's got nothing to do with me"
},
{
"n": 7,
"h": "2589251c",
"en_raw": "But the class rep is like that"
},
{
"n": 8,
"h": "86b1ed8f",
"en_raw": "talking like this"
},
{
"n": 9,
"h": "4e2b6665",
"en_raw": "she might do it again..."
},
{
"n": 10,
"h": "95abb3ce",
"en_raw": "Like I said, I don't know"
},
{
"n": 11,
"h": "1ae475de",
"en_raw": "I told you"
},
{
"n": 12,
"h": "987d6977",
"en_raw": "Do you have a problem with me?"
},
{
"n": 13,
"h": "55e12497",
"en_raw": "......."
},
{
"n": 14,
"h": "5f916523",
"en_raw": "The Toilet Gang might be"
},
{
"n": 15,
"h": "017b8530",
"en_raw": "near collapse soon"
},
{
"n": 16,
"h": "0122ff52",
"en_raw": "...Hirauchi, you"
},
{
"n": 17,
"h": "5d4e1c47",
"en_raw": "always act like an outsider"
},
{
"n": 18,
"h": "35c4f0dd",
"en_raw": "but nobody in the class"
},
{
"n": 19,
"h": "995b960e",
"en_raw": "is unrelated"
},
{
"n": 20,
"h": "799cfacb",
"en_raw": "She's totally brazen now"
},
{
"n": 21,
"h": "1172f868",
"en_raw": "...I wish she'd copy the class rep"
},
{
"n": 22,
"h": "55274551",
"en_raw": "too"
},
{
"n": 23,
"h": "d942f9d9",
"en_raw": "When I do it"
},
{
"n": 24,
"h": "76f9c355",
"en_raw": "I'll put plenty about you guys in the"
},
{
"n": 25,
"h": "76f3d78f",
"en_raw": "suicide note"
},
{
"n": 26,
"h": "30fd6078",
"en_raw": "Don't think you'll"
},
{
"n": 27,
"h": "2af28b30",
"en_raw": "live a decent life"
},
{
"n": 28,
"h": "3d57738a",
"en_raw": "Same old badmouthing"
},
{
"n": 29,
"h": "a8b92df3",
"en_raw": "Even after the bathroom became a changing room"
},
{
"n": 30,
"h": "cc1ce253",
"en_raw": "or changing room, you do the same thing"
}
]
