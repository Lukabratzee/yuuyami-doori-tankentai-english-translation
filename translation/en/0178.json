"lines": [
{
"n": 0,
"h": "9c4e1d8e",
"en_raw": "Next is Mr. Kamei's class"
},
{
"n": 1,
"h": "41a1686c",
"en_raw": "That teacher, in this day and age"
},
{
"n": 2,
"h": "a32a4fbc",
"en_raw": "forces rote memorization"
},
{
"n": 3,
"h": "8213fc0b",
"en_raw": "In the quiz, writing in hiragana"
},
{
"n": 4,
"h": "23085cdb",
"en_raw": "gets you an X"
},
{
"n": 5,
"h": "11d60dc9",
"en_raw": "It's weird to begin with"
},
{
"n": 6,
"h": "379939ac",
"en_raw": "Why can a civics teacher"
},
{
"n": 7,
"h": "48934818",
"en_raw": "teach history?"
},
{
"n": 8,
"h": "7396a070",
"en_raw": "Is human history"
},
{
"n": 9,
"h": "c50b7d79",
"en_raw": "such a trivial thing?"
},
{
"n": 10,
"h": "94dfa927",
"en_raw": "Kurumi gets her head"
},
{
"n": 11,
"h": "5c336435",
"en_raw": "smacked"
},
{
"n": 12,
"h": "9920e2e0",
"en_raw": "He doesn't understand the essence"
},
{
"n": 13,
"h": "f57a0771",
"en_raw": "of what history even is"
},
{
"n": 14,
"h": "dcc3bff2",
"en_raw": "But when it comes to food"
},
{
"n": 15,
"h": "72d3d1f6",
"en_raw": "he's interesting, can't stop"
},
{
"n": 16,
"h": "06fd8145",
"en_raw": "Right"
},
{
"n": 17,
"h": "fcbd3c22",
"en_raw": "Home ec would've been better"
},
{
"n": 18,
"h": "cc3c764b",
"en_raw": "Kurumi is getting hungry"
},
{
"n": 19,
"h": "8f4e1ed9",
"en_raw": "If we go to the staff room"
},
{
"n": 20,
"h": "c471bb7b",
"en_raw": "they'll surely give us kakipi"
},
{
"n": 21,
"h": "c98bd245",
"en_raw": "saying 'grow big'"
},
{
"n": 22,
"h": "d6deb78c",
"en_raw": "Hey, Shiina"
},
{
"n": 23,
"h": "59f2f8ba",
"en_raw": "what do you think about math?"
},
{
"n": 24,
"h": "96e15f00",
"en_raw": "It's hard"
},
{
"n": 25,
"h": "c74e8a23",
"en_raw": "Mr. Kanbara is a bit scary"
},
{
"n": 26,
"h": "03955b1e",
"en_raw": "I'm bad at it too"
},
{
"n": 27,
"h": "6dcf691f",
"en_raw": "He's definitely a number"
},
{
"n": 28,
"h": "83fab717",
"en_raw": "worshipper type"
},
{
"n": 29,
"h": "606cdc40",
"en_raw": "And so"
},
{
"n": 30,
"h": "a45c8a20",
"en_raw": "Kurumi didn't do the homework"
},
{
"n": 31,
"h": "33744f16",
"en_raw": "...Homework!"
},
{
"n": 32,
"h": "d2850c8a",
"en_raw": "I totally forgot"
},
{
"n": 33,
"h": "3f63ba59",
"en_raw": "or rather was trying to forget..."
},
{
"n": 34,
"h": "8c545f60",
"en_raw": "Kurumi somehow"
},
{
"n": 35,
"h": "fcc85fd3",
"en_raw": "has a stomachache now"
},
{
"n": 36,
"h": "d941711e",
"en_raw": "Oh, really, me too..."
},
{
"n": 37,
"h": "2d423acc",
"en_raw": "Kurumi has a tummy ache"
},
{
"n": 38,
"h": "3a9ae7a1",
"en_raw": "Oh, I"
},
{
"n": 39,
"h": "a340293c",
"en_raw": "just had a great idea"
},
{
"n": 40,
"h": "145e4366",
"en_raw": "It's fine, Shiina"
},
{
"n": 41,
"h": "50aa5c4e",
"en_raw": "I'll take the homework notebook"
},
{
"n": 42,
"h": "be247609",
"en_raw": "from Nao"
},
{
"n": 43,
"h": "b727fc9e",
"en_raw": "Then I'll go for a bit"
},
{
"n": 44,
"h": "ab757784",
"en_raw": "Even if I'm called on today"
},
{
"n": 45,
"h": "3a0de779",
"en_raw": "I'll be fine"
},
{
"n": 46,
"h": "1a9c4888",
"en_raw": "The only time he's useful"
},
{
"n": 47,
"h": "49029692",
"en_raw": "is times like this, though"
},
{
"n": 48,
"h": "d6deb78c",
"en_raw": "Hey, Shiina"
},
{
"n": 49,
"h": "59f2f8ba",
"en_raw": "what do you think about math?"
},
{
"n": 50,
"h": "b1e00c59",
"en_raw": "It's hard..."
},
{
"n": 51,
"h": "c74e8a23",
"en_raw": "Mr. Kanbara is a bit scary"
},
{
"n": 52,
"h": "d0d2293d",
"en_raw": "You told me that before"
},
{
"n": 53,
"h": "d43ff106",
"en_raw": "Then... um"
},
{
"n": 54,
"h": "d41e87aa",
"en_raw": "Dunno"
},
{
"n": 55,
"h": "0e5dd901",
"en_raw": "It feels like math has a major lie"
},
{
"n": 56,
"h": "b55c5465",
"en_raw": "in it"
},
{
"n": 57,
"h": "42416a55",
"en_raw": "Why, you ask?"
},
{
"n": 58,
"h": "1c2cbe1f",
"en_raw": "The other day I"
},
{
"n": 59,
"h": "82342794",
"en_raw": "tried something, you know?"
},
{
"n": 60,
"h": "dd8ee086",
"en_raw": "What kind?"
},
{
"n": 61,
"h": "09128e7b",
"en_raw": "Shiina, what's 10 divided by 3?"
},
{
"n": 62,
"h": "8d9e630e",
"en_raw": "It leaves one left over"
},
{
"n": 63,
"h": "ff73f0a0",
"en_raw": "So it doesn't divide, ding ding!"
},
{
"n": 64,
"h": "948b318c",
"en_raw": "But a 10 cm origami paper"
},
{
"n": 65,
"h": "eee1f27e",
"en_raw": "can be cut into three equal parts"
},
{
"n": 66,
"h": "eaf22fef",
"en_raw": "and without a remainder"
},
{
"n": 67,
"h": "cb7fc118",
"en_raw": "exactly"
},
{
"n": 68,
"h": "f553b6fb",
"en_raw": "Really?!"
},
{
"n": 69,
"h": "16971d87",
"en_raw": "What's the point of lying?"
},
{
"n": 70,
"h": "97fee145",
"en_raw": "Sango, amazing"
},
{
"n": 71,
"h": "9a0c13db",
"en_raw": "Mr. Kanbara will be surprised"
},
{
"n": 72,
"h": "624f3e65",
"en_raw": "Sango"
},
{
"n": 73,
"h": "dd9631ab",
"en_raw": "Let's tell Mr. Kanbara!"
}
]
}