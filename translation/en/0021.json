},
{
"n": 151,
"h": "b6a552d7",
"en_raw": "there was something like that"
},
{
"n": 152,
"h": "e3501ef9",
"en_raw": "...A world I don't understand"
},
{
"n": 153,
"h": "dc3f94e0",
"en_raw": "Tch, oh well"
},
{
"n": 154,
"h": "fa541053",
"en_raw": "Tsk, oh well"
},
{
"n": 155,
"h": "14f5784c",
