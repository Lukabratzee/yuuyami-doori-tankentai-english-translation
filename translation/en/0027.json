"lines": [
{
"n": 0,
"h": "37710dcb",
"en_raw": "A grudge-filled"
},
{
"n": 1,
"h": "2de02b53",
"en_raw": "moldy corpse"
},
{
"n": 2,
"h": "7e4acee8",
"en_raw": "in the fridge of Room 204?"
},
{
"n": 3,
"h": "68312d20",
"en_raw": "Yeah, two idiot gangs"
},
{
"n": 4,
"h": "e03686bc",
"en_raw": "getting excited about"
},
{
"n": 5,
"h": "b9481ab4",
"en_raw": "the same corpse story"
},
{
"n": 6,
"h": "b94c9345",
"en_raw": "Nao, how do you see this fact?"
},
{
"n": 7,
"h": "87a1dec0",
"en_raw": "How do I see it,"
},
{
"n": 8,
"h": "526893ac",
"en_raw": "what do you mean?"
},
{
"n": 9,
"h": "7cd68e7b",
"en_raw": "I mean"
},
{
"n": 10,
"h": "1f7fe528",
"en_raw": "objectively speaking"
},
{
"n": 11,
"h": "7181c24e",
"en_raw": "is there any"
},
{
"n": 12,
"h": "a5b6ed28",
"en_raw": "credibility to it?"
},
{
"n": 13,
"h": "1088b213",
"en_raw": "If it's what Yuasa says"
},
{
"n": 14,
"h": "1f140ccb",
"en_raw": "I think you shouldn't believe it"
},
{
"n": 15,
"h": "6801e74d",
"en_raw": "I think the Toilet Gang is"
},
{
"n": 16,
"h": "b469dafd",
"en_raw": "endlessly the color of lies too"
},
{
"n": 17,
"h": "8e8d932d",
"en_raw": "Then that settles it"
},
{
"n": 18,
"h": "b91553a0",
"en_raw": "But somehow"
},
{
"n": 19,
"h": "858a0b8b",
"en_raw": "it makes my heart stir"
},
{
"n": 20,
"h": "835f81dd",
"en_raw": "This is just my hunch"
},
{
"n": 21,
"h": "8596c9eb",
"en_raw": "So what are you trying to say?"
},
{
"n": 22,
"h": "642b550e",
"en_raw": "You know full well"
},
{
"n": 23,
"h": "71923775",
"en_raw": "Hey, Nao, let's go investigate"
},
{
"n": 24,
"h": "4df79371",
"en_raw": "We might become"
},
{
"n": 25,
"h": "38b83e10",
"en_raw": "the first to find the body"
},
{
"n": 26,
"h": "9b38a5e1",
"en_raw": "Room 204 of the shabby apartment"
},
{
"n": 27,
"h": "b7f1d2be",
"en_raw": "on the apartment street near school, right?"
},
{
"n": 28,
"h": "c1b4325f",
"en_raw": "But how are we"
},
{
"n": 29,
"h": "cc005d5c",
"en_raw": "going to sneak in from there?"
},
{
"n": 30,
"h": "97df53c9",
"en_raw": "For now, the details"
},
{
"n": 31,
"h": "5682a546",
"en_raw": "once we get to the crime scene"
},
{
"n": 32,
"h": "5f8cbfda",
"en_raw": "A mysterious groaning voice..."
},
{
"n": 33,
"h": "232dcc79",
"en_raw": "The rumor is gradually"
},
{
"n": 34,
"h": "3350dcc6",
"en_raw": "taking on a strange reality"
},
{
"n": 35,
"h": "91562e7a",
"en_raw": "Let's stop"
},
{
"n": 36,
"h": "f1ac4b06",
"en_raw": "There might really be"
},
{
"n": 37,
"h": "f02147f1",
"en_raw": "something there"
},
{
"n": 38,
"h": "326c324c",
"en_raw": "There might really be"
},
{
"n": 39,
"h": "c0be0836",
"en_raw": "something there, so"
},
{
"n": 40,
"h": "37067e8f",
"en_raw": "what good is stopping?"
},
{
"n": 41,
"h": "73e364e3",
"en_raw": "Anyway, I don't want to"
},
{
"n": 42,
"h": "ef15c7db",
"en_raw": "Kurumi wants to see"
},
{
"n": 43,
"h": "e069701a",
"en_raw": "a moldy corpse"
},
{
"n": 44,
"h": "06cd09d5",
"en_raw": "Hey, Shiina"
},
{
"n": 45,
"h": "7ebd7852",
"en_raw": "How do we sneak in?"
},
{
"n": 46,
"h": "46af7aed",
"en_raw": "That vocational school student type's"
},
{
"n": 47,
"h": "45b673f5",
"en_raw": "guard is tight"
},
{
"n": 48,
"h": "9cd20975",
"en_raw": "...Kurumi doesn't know"
},
{
"n": 49,
"h": "264eefa2",
"en_raw": "Oh, right"
},
{
"n": 50,
"h": "ddb2c6f4",
"en_raw": "I've got a good idea!"
},
{
"n": 51,
"h": "1dcb1f00",
"en_raw": "My older brother"
},
{
"n": 52,
"h": "c5e51d9f",
"en_raw": "that's it"
},
{
"n": 53,
"h": "fe1c7a39",
"en_raw": "Sango's brother"
},
{
"n": 54,
"h": "4f1cc0b5",
"en_raw": "goes to a university in Kyushu"
},
{
"n": 55,
"h": "d5cdb825",
"en_raw": "right?"
},
{
"n": 56,
"h": "8e3ac07c",
"en_raw": "Isn't it big brother Mitsugu?"
},
{
"n": 57,
"h": "d846d44b",
"en_raw": "You're so dull"
},
{
"n": 58,
"h": "7cd68e7b",
"en_raw": "I mean"
},
{
"n": 59,
"h": "17ea7370",
"en_raw": "The weirdo living in Room 204"
},
{
"n": 60,
"h": "23ea3297",
"en_raw": "is my brother"
},
{
"n": 61,
"h": "07ba7d63",
"en_raw": "...if we say that"
},
{
"n": 62,
"h": "6d27be58",
"en_raw": "they'll surely let us check"
},
{
"n": 63,
"h": "f1946731",
"en_raw": "...You're going to trick them?"
},
{
"n": 64,
"h": "ab7110e1",
"en_raw": "Don't put it that way"
},
{
"n": 65,
"h": "6dd3552a",
"en_raw": "This is necessary"
},
{
"n": 66,
"h": "1eb5fff3",
"en_raw": "for the investigation"
},
{
"n": 67,
"h": "625633a5",
"en_raw": "Anyway"
},
{
"n": 68,
"h": "6eabfac8",
"en_raw": "First, persuading that"
},
{
"n": 69,
"h": "40d5c6bf",
"en_raw": "vocational school student type"
},
{
"n": 70,
"h": "998aa4fb",
"en_raw": "Saying I'm his"
},
{
"n": 71,
"h": "e1a189b7",
"en_raw": "little sister should work, I think"
},
{
"n": 72,
"h": "e4d3100b",
"en_raw": "Hey, Sango"
},
{
"n": 73,
"h": "91562e7a",
"en_raw": "Let's stop"
},
{
"n": 74,
"h": "8348ab16",
"en_raw": "There wasn't even"
},
{
"n": 75,
"h": "31f57ec4",
"en_raw": "a fridge, was there?"
},
{
"n": 76,
"h": "4b9c797c",
"en_raw": "It's a hoax anyway..."
},
{
"n": 77,
"h": "feb85c33",
"en_raw": "What are you saying"
},
{
"n": 78,
"h": "13910a8a",
"en_raw": "The investigation starts here"
},
{
"n": 79,
"h": "451a4107",
"en_raw": "Did you see?"
},
{
"n": 80,
"h": "c70887e9",
"en_raw": "That door wrapped in wire"
},
{
"n": 81,
"h": "5362e3b6",
"en_raw": "There's no trace of a fridge"
},
{
"n": 82,
"h": "6c24f0f5",
"en_raw": "being carried out of that room"
},
{
"n": 83,
"h": "a37eb358",
"en_raw": "Carrying it out the balcony"
},
{
"n": 84,
"h": "a8cd4f22",
"en_raw": "without the neighbors knowing"
},
{
"n": 85,
"h": "6cbd076a",
"en_raw": "is practically impossible..."
},
{
"n": 86,
"h": "26fcbb6d",
"en_raw": "which means"
},
{
"n": 87,
"h": "682e122a",
"en_raw": "it must still be hidden"
},
{
"n": 88,
"h": "f6c13994",
"en_raw": "somewhere in that room"
},
{
"n": 89,
"h": "e3539a56",
"en_raw": "for sure"
},
{
"n": 90,
"h": "5f164031",
"en_raw": "You see, Sango-chan..."
},
{
"n": 91,
"h": "c75c9703",
"en_raw": "What, Shiina"
},
{
"n": 92,
"h": "bbc626e8",
"en_raw": "with that serious face"
},
{
"n": 93,
"h": "482ffa0d",
"en_raw": "Kurumi figured it out"
},
{
"n": 94,
"h": "9363be1e",
"en_raw": "Figured out..."
},
{
"n": 95,
"h": "62e77ce1",
"en_raw": "what?"
},
{
"n": 96,
"h": "317d8774",
"en_raw": "That room is suspicious"
},
{
"n": 97,
"h": "665d9485",
"en_raw": "the moldy room"
},
{
"n": 98,
"h": "eb87f4de",
"en_raw": "The moldy room..."
},
{
"n": 99,
"h": "601344e4",
"en_raw": "You mean the unit bath?"
},
{
"n": 100,
"h": "505b4cfc",
"en_raw": "Hmm..."
},
{
"n": 101,
"h": "b3ca839c",
"en_raw": "We'll probably need"
},
{
"n": 102,
"h": "7cbb3468",
"en_raw": "to go to the scene again"
},
{
"n": 103,
"h": "f45a3d52",
"en_raw": "after all"
},
{
"n": 104,
"h": "c8dade00",
"en_raw": "Let's ask that guy"
},
{
"n": 105,
"h": "b1f08f30",
"en_raw": "to let us in once more"
},
{
"n": 106,
"h": "c1afbaa0",
"en_raw": "Probably"
},
{
"n": 107,
"h": "2c955436",
"en_raw": "if we ask that guy"
},
{
"n": 108,
"h": "45357ee5",
"en_raw": "he'll let us in again,"
},
{
"n": 109,
"h": "25e48f81",
"en_raw": "won't he..."
},
{
"n": 110,
"h": "2a5b607c",
"en_raw": "Shiina"
},
{
"n": 111,
"h": "b4aa7640",
"en_raw": "How did you know"
},
{
"n": 112,
"h": "03d127ae",
"en_raw": "someone was in a place like that?"
},
{
"n": 113,
"h": "7086caed",
"en_raw": "You see, it smelled funny"
},
{
"n": 114,
"h": "d7d7a35a",
"en_raw": "from up there"
},
{
"n": 115,
"h": "505b4cfc",
"en_raw": "Hmm..."
},
{
"n": 116,
"h": "8163175b",
"en_raw": "But is that person okay living"
},
{
"n": 117,
"h": "8420bd8b",
"en_raw": "in a place like that..."
},
{
"n": 118,
"h": "c1f86ae9",
"en_raw": "He won't really"
},
{
"n": 119,
"h": "670344e8",
"en_raw": "die, will he?"
},
{
"n": 120,
"h": "3873dc41",
"en_raw": "'Genius who met a mysterious death,' my foot"
},
{
"n": 121,
"h": "85baa7c5",
"en_raw": "'Message from Tsukuyomi,' my foot"
},
{
"n": 122,
"h": "491c9939",
"en_raw": "'Moldy fridge,' my foot"
},
{
"n": 123,
"h": "b2342658",
"en_raw": "Snobbish human trash"
},
{
"n": 124,
"h": "6688bad6",
"en_raw": "has nothing to do but die!"
},
{
"n": 125,
"h": "c477171c",
"en_raw": "Seriously, the death penalty"
},
{
"n": 126,
"h": "6c121b3a",
"en_raw": "Death death death death death!"
},
{
"n": 127,
"h": "924cc999",
"en_raw": "Ugh, why is Japanese law"
},
{
"n": 128,
"h": "7d9ad9f5",
"en_raw": "so lenient?"
},
{
"n": 129,
"h": "e8ea9906",
"en_raw": "But then everyone around Sango"
},
{
"n": 130,
"h": "9761241b",
"en_raw": "would die"
},
{
"n": 131,
"h": "43ca5584",
"en_raw": "I'll break your bones"
},
{
"n": 132,
"h": "a7f62143",
"en_raw": "Solved the rumor of the Corpse!"
},
{
"n": 133,
"h": "25b56a83",
"en_raw": "Come to think of it, that guy"
},
{
"n": 134,
"h": "08a05b65",
"en_raw": "I wonder how he's doing"
},
{
"n": 135,
"h": "8407a402",
"en_raw": "He might as well"
},
{
"n": 136,
"h": "3ad05f01",
"en_raw": "just die like that"
},
{
"n": 137,
"h": "73c89ed1",
"en_raw": "Honestly, nothing's more of a pain"
},
{
"n": 138,
"h": "601aaf78",
"en_raw": "than a self-proclaimed genius!"
},
{
"n": 139,
"h": "14f5784c",
"en_raw": "Enough, drop it"
},
{
"n": 140,
"h": "da16b673",
"en_raw": "Let's talk about something else already!"
}
]
}