"lines": [
{
"n": 0,
"h": "333a73f0",
"en_raw": "It's all sparkly"
},
{
"n": 1,
"h": "dc6dc077",
"en_raw": "cute-looking stuff..."
},
{
"n": 2,
"h": "031e4884",
"en_raw": "Where is it cursed"
},
{
"n": 3,
"h": "6d6d91f1",
"en_raw": "These are ordinary goods"
},
{
"n": 4,
"h": "8f24bcbe",
"en_raw": "Ah, this pocket watch"
},
{
"n": 5,
"h": "44ec7128",
"en_raw": "might be nice..."
},
{
"n": 6,
"h": "d6d868bb",
"en_raw": "Welcome"
},
{
"n": 7,
"h": "0e87675e",
"en_raw": "Excuse me"
},
{
"n": 8,
"h": "99136481",
"en_raw": "Um, are you a part-timer?"
},
{
"n": 9,
"h": "b5751346",
"en_raw": "I'm the owner here"
},
{
"n": 10,
"h": "c903a2a5",
"en_raw": "Looking for something?"
},
{
"n": 11,
"h": "a0818e45",
"en_raw": "Don't you have"
},
{
"n": 12,
"h": "69dd95e5",
"en_raw": "part-timers or anything?"
},
{
"n": 13,
"h": "032107d9",
"en_raw": "I have a girl who helps"
},
{
"n": 14,
"h": "db99c61e",
"en_raw": "but she hasn't come today..."
},
{
"n": 15,
"h": "1a008fd6",
"en_raw": "Do you know why?"
},
{
"n": 16,
"h": "5fbcf61a",
"en_raw": "A mysterious illness or something?"
},
{
"n": 17,
"h": "cdea1b8e",
"en_raw": "Not at all..."
},
{
"n": 18,
"h": "108b8adb",
"en_raw": "Just an ordinary girl's reason"
},
{
"n": 19,
"h": "b55a5626",
"en_raw": "...So what do you want?"
},
{
"n": 20,
"h": "62217376",
"en_raw": "Well, um, that"
},
{
"n": 21,
"h": "47a3f30e",
"en_raw": "...Aren't you customers?"
},
{
"n": 22,
"h": "36ad8c6f",
"en_raw": "The goods you sell"
},
{
"n": 23,
"h": "00d342b6",
"en_raw": "are super ordinary, right?"
},
{
"n": 24,
"h": "355b4fcd",
"en_raw": "That's not true"
},
{
"n": 25,
"h": "34bd46a6",
"en_raw": "Since my college days"
},
{
"n": 26,
"h": "912c1987",
"en_raw": "I traveled around Europe"
},
{
"n": 27,
"h": "92f0ddde",
"en_raw": "and collected bit by bit"
},
{
"n": 28,
"h": "36007ee3",
"en_raw": "all top-quality items"
},
{
"n": 29,
"h": "53c6709e",
"en_raw": "Really?"
},
{
"n": 30,
"h": "609cc021",
"en_raw": "So, who are you two?"
},
{
"n": 31,
"h": "52f8ca90",
"en_raw": "Customers?"
},
{
"n": 32,
"h": "c34becd6",
"en_raw": "Um, we're not involved"
},
{
"n": 33,
"h": "87d4b856",
"en_raw": "What, Nao..."
},
{
"n": 34,
"h": "9ea8715c",
"en_raw": "Then I'll ask straight out"
},
{
"n": 35,
"h": "32ebc1f7",
"en_raw": "Running this shop"
},
{
"n": 36,
"h": "e5c3991d",
"en_raw": "do strange things happen?"
},
{
"n": 37,
"h": "b0f619ac",
"en_raw": "...What?"
},
{
"n": 38,
"h": "d2469c18",
"en_raw": "I heard it, you see"
},
{
"n": 39,
"h": "1ff0343f",
"en_raw": "that this shop is somehow"
},
{
"n": 40,
"h": "ebb9ead0",
"en_raw": "cursed or something"
},
{
"n": 41,
"h": "34cf0292",
"en_raw": "........"
},
{
"n": 42,
"h": "c61f2344",
"en_raw": "Do you maybe have an idea?"
},
{
"n": 43,
"h": "6ca634c3",
"en_raw": "...That's"
},
{
"n": 44,
"h": "f7b80a87",
"en_raw": "a baseless rumor"
},
{
"n": 45,
"h": "7c938359",
"en_raw": "Don't say strange things"
},
{
"n": 46,
"h": "c2d059d0",
"en_raw": "What are you two"
},
{
"n": 47,
"h": "b329fb64",
"en_raw": "We're NNR, sorry for the intrusion"
},
{
"n": 48,
"h": "66484f15",
"en_raw": "Sorry for the intrusion~"
},
{
"n": 49,
"h": "da639fa8",
"en_raw": "What is with them!"
},
{
"n": 50,
"h": "3764dd8c",
"en_raw": "......"
},
{
"n": 51,
"h": "80a299b9",
"en_raw": "Sorry, but please leave"
},
{
"n": 52,
"h": "03942332",
"en_raw": "Sorry"
},
{
"n": 53,
"h": "bd8d4f3f",
"en_raw": "If you have no business"
},
{
"n": 54,
"h": "f0ee85e5",
"en_raw": "come again another time"
},
{
"n": 55,
"h": "f67d18e3",
"en_raw": "...What is it this time?"
},
{
"n": 56,
"h": "68c50a08",
"en_raw": "I heard from the old bookshop guy"
},
{
"n": 57,
"h": "a0598cc8",
"en_raw": "next door"
},
{
"n": 58,
"h": "46adc9ff",
"en_raw": "Um, frankly speaking"
},
{
"n": 59,
"h": "98e17817",
"en_raw": "this place seems bad"
},
{
"n": 60,
"h": "58416b89",
"en_raw": "So what on earth are you talking about"
},
{
"n": 61,
"h": "765921ed",
"en_raw": "...If you don't stop"
},
{
"n": 62,
"h": "2be5fd60",
"en_raw": "I'll call the police"
},
{
"n": 63,
"h": "030f57b4",
"en_raw": "Um, this place has had over ten"
},
{
"n": 64,
"h": "da1fc31c",
"en_raw": "different shops, they say..."
},
{
"n": 65,
"h": "aea73899",
"en_raw": "I know that story"
},
{
"n": 66,
"h": "377ab83e",
"en_raw": "But that doesn't mean it's"
},
{
"n": 67,
"h": "37587d89",
"en_raw": "the curse"
},
{
"n": 68,
"h": "00883a54",
"en_raw": "Oh... you knew?"
},
{
"n": 69,
"h": "3764dd8c",
"en_raw": "......"
},
{
"n": 70,
"h": "668b4a87",
"en_raw": "Then the story"
},
{
"n": 71,
"h": "b914a5d5",
"en_raw": "would just end"
},
{
"n": 72,
"h": "a42c6765",
"en_raw": "Boring"
},
{
"n": 73,
"h": "bae8cbb9",
"en_raw": "Hey..."
},
{
"n": 74,
"h": "79d42c06",
"en_raw": "Wait a second"
},
{
"n": 75,
"h": "ac28ef73",
"en_raw": "Um... may I?"
},
{
"n": 76,
"h": "58a8058d",
"en_raw": "There's something I'd like to ask"
},
{
"n": 77,
"h": "e62ebe2d",
"en_raw": "What is it?"
},
{
"n": 78,
"h": "5560c8aa",
"en_raw": "to prove that the rumor"
},
{
"n": 79,
"h": "31d38574",
"en_raw": "is a baseless"
},
{
"n": 80,
"h": "3bc0f5ba",
"en_raw": "lie"
},
{
"n": 81,
"h": "283879c2",
"en_raw": "as thanks and proof"
},
{
"n": 82,
"h": "e2e61435",
"en_raw": "However"
},
{
"n": 83,
"h": "f7cc3dcf",
"en_raw": "I'll give you any one"
},
{
"n": 84,
"h": "25c47a9b",
"en_raw": "item on this shelf"
},
{
"n": 85,
"h": "c48a0a7b",
"en_raw": "Wait a second"
},
{
"n": 86,
"h": "d668bdba",
"en_raw": "Please"
},
{
"n": 87,
"h": "c1358e17",
"en_raw": "Eh, I can get one?"
},
{
"n": 88,
"h": "ecdbb828",
"en_raw": "Lucky! / That's a bit...  This investigation agency"
},
{
"n": 89,
"h": "81a31379",
"en_raw": "isn't allowed"
},
{
"n": 90,
"h": "3ba07fbe",
"en_raw": "to twist the truth"
},
{
"n": 91,
"h": "91160cc4",
"en_raw": "I'm not doing"
},
{
"n": 92,
"h": "e088e330",
"en_raw": "anything shady"
},
{
"n": 93,
"h": "d5b84238",
"en_raw": "...Please"
},
{
"n": 94,
"h": "ecd883a8",
"en_raw": "...Please!"
},
{
"n": 95,
"h": "8f8d9586",
"en_raw": "Hmm..."
},
{
"n": 96,
"h": "0e241a5d",
"en_raw": "Oh well / That's a bit...  So, like I keep"
},
{
"n": 97,
"h": "4d9610e8",
"en_raw": "saying..."
},
{
"n": 98,
"h": "d244c4ad",
"en_raw": "Of course, leave"
},
{
"n": 99,
"h": "6c16f748",
"en_raw": "that to NNR"
},
{
"n": 100,
"h": "2a1b479f",
"en_raw": "Which one should I pick..."
},
{
"n": 101,
"h": "8fed045c",
"en_raw": "This, this pocket watch"
},
{
"n": 102,
"h": "41ca56e5",
"en_raw": "May I ask?"
},
{
"n": 103,
"h": "93def061",
"en_raw": "This one?"
},
{
"n": 104,
"h": "0dd40e9e",
"en_raw": "Take good care of it"
},
{
"n": 105,
"h": "91821444",
"en_raw": "And about that story, please"
},
{
"n": 106,
"h": "b4080a6d",
"en_raw": "I'll come again after getting New Year's money"
},
{
"n": 107,
"h": "8a3d366d",
"en_raw": "Tch, I'm the only one"
},
{
"n": 108,
"h": "ca7c309c",
"en_raw": "This is where it gets interesting"
}
]
