"lines": [
{
"n": 0,
"h": "fe79a95d",
"en_raw": "Hey hey, Nishi, why"
},
{
"n": 1,
"h": "9bb33f58",
"en_raw": "won't you join?"
},
{
"n": 2,
"h": "0b0a0080",
"en_raw": "No, I'm just"
},
{
"n": 3,
"h": "612746ed",
"en_raw": "not into sports"
},
{
"n": 4,
"h": "4a445071",
"en_raw": "Huh, why, why?"
},
{
"n": 5,
"h": "5aa31463",
"en_raw": "The other day you helped out"
},
{
"n": 6,
"h": "c9edd33e",
"en_raw": "and scored the comeback goal"
},
{
"n": 7,
"h": "a6c14676",
"en_raw": "That was a fluke"
},
{
"n": 8,
"h": "bd13be4e",
"en_raw": "What a waste"
},
{
"n": 9,
"h": "06ecf5bf",
"en_raw": "You're as good as a regular"
},
{
"n": 10,
"h": "60964a0a",
"en_raw": "and the uniform"
},
{
"n": 11,
"h": "e6e3fa69",
"en_raw": "looked great on you"
},
{
"n": 12,
"h": "b1221512",
"en_raw": "Like moths swarming a streetlight"
},
{
"n": 13,
"h": "1f955d9f",
"en_raw": "girls crowd around"
},
{
"n": 14,
"h": "77e1b58d",
"en_raw": "Hey, Hirauchi"
},
{
"n": 15,
"h": "e7b2568a",
"en_raw": "Looking for someone?"
},
{
"n": 16,
"h": "a1245b49",
"en_raw": "Want me to go get them?"
},
{
"n": 17,
"h": "3764dd8c",
"en_raw": "......"
},
{
"n": 18,
"h": "73e579a5",
"en_raw": "(Why am I so nervous?)"
},
{
"n": 19,
"h": "dbc8e623",
"en_raw": "Oh, maybe you're here for me?"
},
{
"n": 20,
"h": "2e617656",
"en_raw": "No, it's not like that"
},
{
"n": 21,
"h": "79da9cb2",
"en_raw": "Nishi, you shouldn't talk"
},
{
"n": 22,
"h": "07ce16e7",
"en_raw": "with that person much"
},
{
"n": 23,
"h": "f6fed306",
"en_raw": "She's really weird..."
},
{
"n": 24,
"h": "cd2309c2",
"en_raw": "(He's kind of hard to talk to"
},
{
"n": 25,
"h": "ef1f0c7b",
"en_raw": "...somehow, though)"
},
{
"n": 26,
"h": "fe2f83d6",
"en_raw": "...just kidding"
},
{
"n": 27,
"h": "ff576c6b",
"en_raw": "Maybe I'm a bit self-conscious"
},
{
"n": 28,
"h": "95bc52c9",
"en_raw": "...Sorry for the trouble"
}
]
}