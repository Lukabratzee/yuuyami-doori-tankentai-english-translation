},
{
"n": 78,
"h": "dd71bdb7",
"en_raw": "Um... don't do anything crazy"
},
{
"n": 79,
"h": "93a25867",
"en_raw": "Don't worry"
},
{
"n": 80,
"h": "37ce8923",
"en_raw": "It's my doing"
},
{
"n": 81,
"h": "35607cad",
"en_raw": "...Sorry"
},
{
"n": 82,
"h": "dde52c72",
"en_raw": "It wasn't something to"
},
{
"n": 83,
"h": "7de8b3fb",
"en_raw": "invite you to"
},
{
"n": 84,
"h": "754c336d",
"en_raw": "Maybe I'll invite Yuasa..."
},
{
"n": 85,
"h": "62a9dff8",
"en_raw": "Um... I..."
},
{
"n": 86,
"h": "07bf5c82",
"en_raw": "I have to..."
}
]
