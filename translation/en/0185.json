"lines": [
{
"n": 0,
"h": "4de89116",
"en_raw": "...The whole underpass"
},
{
"n": 1,
"h": "96c6f1f4",
"en_raw": "smells of soy sauce"
},
{
"n": 2,
"h": "18cefa89",
"en_raw": "She eats some weird mushy thing"
},
{
"n": 3,
"h": "7117779d",
"en_raw": "with soy sauce on it"
},
{
"n": 4,
"h": "c7cdaa5c",
"en_raw": "You shouldn't have, but"
},
{
"n": 5,
"h": "a732b282",
"en_raw": "Ritchan talked to her"
},
{
"n": 6,
"h": "ffad765c",
"en_raw": "What does it taste like?"
},
{
"n": 7,
"h": "17056458",
"en_raw": "And then Nishi"
},
{
"n": 8,
"h": "59acc3a3",
"en_raw": "what do you think"
},
{
"n": 9,
"h": "da707552",
"en_raw": "that old woman answered?"
},
{
"n": 10,
"h": "a1783c3a",
"en_raw": "Well..."
},
{
"n": 11,
"h": "70e897d4",
"en_raw": "Human flesh... she said"
},
{
"n": 12,
"h": "ed505cf7",
"en_raw": "And then she opened her bright red mouth"
},
{
"n": 13,
"h": "78b579aa",
"en_raw": "and laughed with her toothless mouth"
},
{
"n": 14,
"h": "027dceaf",
"en_raw": "That's scary..."
},
{
"n": 15,
"h": "3764dd8c",
"en_raw": "......"
},
{
"n": 16,
"h": "80c8f13b",
"en_raw": "It's Nishi"
},
{
"n": 17,
"h": "fe652f19",
"en_raw": "But he's kind of"
},
{
"n": 18,
"h": "d0b373ff",
"en_raw": "hard to talk to..."
},
{
"n": 19,
"h": "6cb4eb3b",
"en_raw": "Hey, Murase"
},
{
"n": 20,
"h": "c06b094c",
"en_raw": "...Oh, sorry"
},
{
"n": 21,
"h": "9c01226b",
"en_raw": "Did I interrupt?"
},
{
"n": 22,
"h": "37ad1cc3",
"en_raw": "Nishi... um"
},
{
"n": 23,
"h": "d0b373ff",
"en_raw": "hard to talk to..."
},
{
"n": 24,
"h": "00329586",
"en_raw": "Murase, you're worried after all?"
},
{
"n": 25,
"h": "e2b24d73",
"en_raw": "Tell him the details"
},
{
"n": 26,
"h": "b3966eac",
"en_raw": "Nishi... um..."
},
{
"n": 27,
"h": "e6e78f6b",
"en_raw": "By the way, Murase"
},
{
"n": 28,
"h": "c88fc082",
"en_raw": "Do you know Soy Sauce Granny?"
},
{
"n": 29,
"h": "f935d022",
"en_raw": "Soy Sauce... Granny...?"
},
{
"n": 30,
"h": "3edd0bf1",
"en_raw": "Yes, a strange"
},
{
"n": 31,
"h": "a0128008",
"en_raw": "old woman"
},
{
"n": 32,
"h": "05ba01f5",
"en_raw": "who recently settled under"
},
{
"n": 33,
"h": "279281a3",
"en_raw": "that underpass"
},
{
"n": 34,
"h": "5f3a0cc9",
"en_raw": "She smells of soy sauce"
},
{
"n": 35,
"h": "c3a02758",
"en_raw": "and is always eating something"
},
{
"n": 36,
"h": "d208dfbf",
"en_raw": "When asked what it tastes like"
},
{
"n": 37,
"h": "85b2aef3",
"en_raw": "...it's human flesh, she said"
},
{
"n": 38,
"h": "37d44632",
"en_raw": "That's my way home"
},
{
"n": 39,
"h": "8b286572",
"en_raw": "If Nishi would come along"
},
{
"n": 40,
"h": "1609632e",
"en_raw": "walked home with me"
},
{
"n": 41,
"h": "2a25d914",
"en_raw": "Hmm, even if you say that"
},
{
"n": 42,
"h": "0e88e73e",
"en_raw": "...Couldn't you just take"
},
{
"n": 43,
"h": "cf0b057b",
"en_raw": "the underpass on the other side?"
},
{
"n": 44,
"h": "699d5d51",
"en_raw": "Oh, that's good"
},
{
"n": 45,
"h": "f50a18d8",
"en_raw": "Do that"
},
{
"n": 46,
"h": "3cc2390c",
"en_raw": "What's that, how mean!"
},
{
"n": 47,
"h": "7271f487",
"en_raw": "Well, ...it's a great idea"
},
{
"n": 48,
"h": "70071f8d",
"en_raw": "...True, but"
},
{
"n": 49,
"h": "39cbd2a5",
"en_raw": "Nishi's cold today~"
},
{
"n": 50,
"h": "db50d72a",
"en_raw": "Human flesh... Soy Sauce Granny..."
},
{
"n": 51,
"h": "39e44a31",
"en_raw": "What do you think, Murase?"
},
{
"n": 52,
"h": "9c4aeb0c",
"en_raw": "The girls left"
},
{
"n": 53,
"h": "4bcd1715",
"en_raw": "...Is that okay?"
},
{
"n": 54,
"h": "ebd1c977",
"en_raw": "Why would something like that"
},
{
"n": 55,
"h": "1dcf79af",
"en_raw": "show up in our town of all places?"
},
{
"n": 56,
"h": "ccbe3d70",
"en_raw": "I don't know"
},
{
"n": 57,
"h": "3c386195",
"en_raw": "That underpass is within"
},
{
"n": 58,
"h": "633e89e7",
"en_raw": "the school district too"
},
{
"n": 59,
"h": "89284c7c",
"en_raw": "Frankly..."
},
{
"n": 60,
"h": "8df6b3ad",
"en_raw": "...it's infuriating"
},
{
"n": 61,
"h": "5f0af67e",
"en_raw": "...Infuriating?"
},
{
"n": 62,
"h": "9495c03a",
"en_raw": "Yeah, it makes my blood boil"
},
{
"n": 63,
"h": "59955698",
"en_raw": "Murase, it's human flesh, you know?"
},
{
"n": 64,
"h": "b633fed7",
"en_raw": "Not funny at all"
},
{
"n": 65,
"h": "f497a1c3",
"en_raw": "I don't think it's something"
},
{
"n": 66,
"h": "88eae59f",
"en_raw": "to get seriously angry about..."
},
{
"n": 67,
"h": "6f9aebdc",
"en_raw": "I'm not serious"
},
{
"n": 68,
"h": "7beb455f",
"en_raw": "I'll just drive her out"
},
{
"n": 69,
"h": "98ee9a0b",
"en_raw": "if she really is a weird old woman"
},
{
"n": 70,
"h": "695532ec",
"en_raw": "like the girls said"
},
{
"n": 71,
"h": "2f1dda11",
"en_raw": "Obtained the rumor of the Soy Sauce Granny"
},
{
"n": 72,
"h": "83a54534",
"en_raw": "You won't hit her, right?"
},
{
"n": 73,
"h": "a3721fcd",
"en_raw": "...No way"
},
{
"n": 74,
"h": "8a6232fd",
"en_raw": "I'll just give her a light scare"
},
{
"n": 75,
"h": "b48623f8",
"en_raw": "If you're worried, come along, Murase"
},
{
"n": 76,
"h": "e67fdce8",
"en_raw": "Sorry, I..."
},
{
"n": 77,
"h": "4bb76cd0",
